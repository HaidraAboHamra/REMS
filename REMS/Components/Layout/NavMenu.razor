        }

        .nav-icon-box {
            width: 40px;
            height: 40px;
            flex-basis: 40px;
        }

        .nav-title {
            font-size: .90rem;
        }

        .nav-subtitle {
            font-size: .62rem;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
        }
    }
    /* =========================================================
       EMOJI LOGO SYSTEM
       ========================================================= */

    .nav-emoji-box {
        position: relative;
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 2px;
        margin-right: 12px;
        border-radius: 14px;
        font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
        font-size: 1.45rem;
        line-height: 1;
        background: linear-gradient( 145deg, rgba(49, 46, 129, 0.28), rgba(15, 23, 42, 0.68) );
        border: 1px solid rgba(129, 140, 248, 0.16);
        box-shadow: 0 7px 20px rgba(0, 0, 0, 0.20), inset 0 1px 0 rgba(255,255,255,0.04);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease, background .3s ease;
    }


        /* glow خلف الـ Emoji */

