    .logout-btn {
        position: relative;
        overflow: hidden;
        width: 100%;
        min-height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid rgba(129,140,248,.22);
        border-radius: 14px;
        color: white;
        background: linear-gradient( 120deg, #111827 0%, #312e81 45%, #4338ca 100% );
        box-shadow: 0 12px 30px rgba(49,46,129,.34), 0 0 0 1px rgba(255,255,255,.04) inset;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .92rem;
        font-weight: 700;
        transition: .25s ease;
    }


        .logout-btn:hover {
            transform: translateY(-3px);
            filter: brightness(1.08);
            box-shadow: 0 18px 38px rgba(49,46,129,.46), 0 0 30px rgba(99,102,241,.18);
        }


    .logout-icon-box {
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 9px;
        color: #c7d2fe;
        background: rgba(255,255,255,.08);
    }


    .logout-text {
        position: relative;
        z-index: 2;
    }


    .logout-shine {
        position: absolute;
        top: -30%;
        left: -70%;
        width: 45%;
        height: 160%;
        transform: rotate(18deg);
        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.20), transparent );
        animation: logoutShine 5s ease-in-out infinite;
    }


    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes navbarSweep {

        0%, 30% {
            transform: translateX(-100%);
            opacity: 0;
        }

        45% {
            opacity: 1;
        }

        65%, 100% {
            transform: translateX(100%);
            opacity: 0;
        }
    }


    @@keyframes brandPulse {

        0%, 100% {
            box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 30px rgba(99,102,241,.22) inset;
        }

        50% {
            box-shadow: 0 14px 38px rgba(79,70,229,.50), 0 0 40px rgba(129,140,248,.30) inset;
        }
    }


    @@keyframes activePulse {

        0%, 100% {
            opacity: .65;
        }

        50% {
            opacity: 1;
        }
    }


    @@keyframes navReveal {

        from {
            opacity: 0;
            transform: translateX(18px) translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateX(0) translateY(0);
        }
    }


    @@keyframes gridDrift {

        from {
            transform: translate3d(0,0,0);
        }

        to {
            transform: translate3d(42px,42px,0);
        }
    }


    @@keyframes sidebarOrb {

        0%, 100% {
            transform: translate3d(0,0,0) scale(1);
            opacity: .40;
        }

        50% {
            transform: translate3d(-30px,25px,0) scale(1.14);
            opacity: .75;
        }
    }


    @@keyframes logoutShine {

        0%, 20% {
            left: -70%;
            opacity: 0;
        }

        34% {
            opacity: 1;
        }

        52%, 100% {
            left: 135%;
            opacity: 0;
        }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 768px) {

        .custom-navbar {
            min-height: 64px;
        }

        .brand-logo-wrapper {
            width: 38px;
            height: 38px;
            border-radius: 11px;
        }

        .brand-logo {
