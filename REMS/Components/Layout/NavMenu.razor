<style>

    /* =========================================================
           DESIGN TOKENS
           ========================================================= */

    :root {
        --hex-black: #030305;
        --hex-black-2: #070811;
        --hex-black-3: #0b0c18;
        --hex-indigo: #312e81;
        --hex-indigo-2: #4338ca;
        --hex-blue: #1d4ed8;
        --hex-cyan: #38bdf8;
        --hex-purple: #6366f1;
        --hex-white: #f8fafc;
        --hex-muted: #a5b4fc;
        --hex-border: rgba(129,140,248,.20);
        --hex-glow: rgba(79,70,229,.42);
    }


    /* =========================================================
           NAVBAR
           ========================================================= */

    .custom-navbar {
        position: relative;
        min-height: 76px;
        overflow: hidden;
        background: radial-gradient( circle at 85% 0%, rgba(99,102,241,.28), transparent 28% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        border-bottom: 1px solid rgba(129,140,248,.16);
        box-shadow: 0 12px 40px rgba(0,0,0,.48), 0 0 45px rgba(67,56,202,.12);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        z-index: 20;
    }


        .custom-navbar::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient( 115deg, transparent 20%, rgba(255,255,255,.045) 50%, transparent 80% );
            animation: navbarSweep 8s ease-in-out infinite;
        }


    /* =========================================================
           BRAND
           ========================================================= */

    .premium-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        z-index: 2;
        text-decoration: none;
        color: white !important;
    }


    .brand-logo-wrapper {
        width: 46px;
        height: 46px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        border-radius: 14px;
        background: linear-gradient( 145deg, rgba(99,102,241,.92), rgba(30,64,175,.80) );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 30px rgba(99,102,241,.22) inset;
        animation: brandPulse 4s ease-in-out infinite;
    }


    .brand-logo {
        width: 34px;
        height: 34px;
        object-fit: contain;
        display: block;
        filter: drop-shadow( 0 0 10px rgba(255,255,255,.25) );
    }


    .brand-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1px;
    }


    .brand-name {
        font-family: "Unbounded", "Space Grotesk", sans-serif;
        font-size: 1.20rem;
        font-weight: 600;
        letter-spacing: .12em;
        line-height: 1;
    }


    .brand-company {
        font-family: "Space Grotesk", sans-serif;
        font-size: .56rem;
        font-weight: 600;
        letter-spacing: .30em;
        color: rgba(165,180,252,.62);
        text-transform: uppercase;
    }


    /* =========================================================
           SIDEBAR
           ========================================================= */

    .nav-scrollable {
        position: relative;
        overflow-x: hidden;
        background: radial-gradient( circle at 85% 5%, rgba(67,56,202,.22), transparent 28% ), radial-gradient( circle at 12% 90%, rgba(29,78,216,.14), transparent 26% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        border-right: 1px solid rgba(129,140,248,.14);
        box-shadow: inset -10px 0 40px rgba(0,0,0,.18), 8px 0 30px rgba(0,0,0,.15);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        isolation: isolate;
    }


        .nav-scrollable::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: -2;
            background: linear-gradient( rgba(255,255,255,.022) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.022) 1px, transparent 1px );
            background-size: 42px 42px;
            mask-image: linear-gradient( to bottom, black, transparent 94% );
            animation: gridDrift 22s linear infinite;
        }


        .nav-scrollable::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -120px;
            top: 28%;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(99,102,241,.17), transparent 68% );
            filter: blur(18px);
            pointer-events: none;
            animation: sidebarOrb 10s ease-in-out infinite;
        }


        .nav-scrollable nav {
            position: relative;
            z-index: 2;
            padding-top: 14px;
            padding-bottom: 100px;
        }


    /* =========================================================
           NAV ITEMS
           ========================================================= */

    .nav-item {
        margin-bottom: 7px;
        animation: navReveal .55s cubic-bezier(.2,.75,.2,1) both;
    }


    .premium-link {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 64px;
        padding: 8px 10px;
        border-radius: 16px;
        color: #cbd5e1 !important;
        background: rgba(9,10,18,.38);
        border: 1px solid transparent;
        text-decoration: none;
        transition: .28s ease;
    }


        .premium-link:hover {
            transform: translateX(-4px);
            color: #fff !important;
            background: linear-gradient( 135deg, rgba(30,41,59,.75), rgba(49,46,129,.25) );
            border-color: rgba(129,140,248,.22);
            box-shadow: 0 12px 30px rgba(0,0,0,.24), 0 0 25px rgba(67,56,202,.12);
        }


        .premium-link.active {
            color: #fff !important;
            background: linear-gradient( 135deg, rgba(49,46,129,.88), rgba(29,78,216,.38) );
            border-color: rgba(129,140,248,.28);
            box-shadow: 0 12px 34px rgba(0,0,0,.30), 0 0 32px rgba(67,56,202,.18), inset 0 1px 0 rgba(255,255,255,.06);
        }


            .premium-link.active::after {
                content: "";
                position: absolute;
                right: 0;
                top: 14%;
                width: 3px;
                height: 72%;
                border-radius: 50px;
                background: linear-gradient( 180deg, #818cf8, #4338ca, #38bdf8 );
                box-shadow: 0 0 12px rgba(99,102,241,.85), 0 0 26px rgba(56,189,248,.24);
                animation: activePulse 2.6s ease-in-out infinite;
            }


    /* =========================================================
           ICON LOGOS
           ========================================================= */

    .nav-icon-box {
        position: relative;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 2px;
        margin-right: 12px;
        border-radius: 13px;
        background: linear-gradient( 145deg, rgba(49,46,129,.22), rgba(15,23,42,.52) );
        border: 1px solid rgba(129,140,248,.14);
        box-shadow: 0 6px 18px rgba(0,0,0,.18), inset 0 1px rgba(255,255,255,.035);
        transition: .28s ease;
    }


        .nav-icon-box::before {
            content: "";
            position: absolute;
            inset: 3px;
            border-radius: 10px;
            border: 1px solid rgba(129,140,248,.07);
            pointer-events: none;
        }


        .nav-icon-box .bi {
            position: relative;
            z-index: 2;
            font-size: 1.10rem;
            color: inherit;
        }


    .premium-link:hover .nav-icon-box {
        transform: scale(1.08) translateY(-1px);
        border-color: rgba(129,140,248,.32);
        background: linear-gradient( 145deg, rgba(67,56,202,.40), rgba(30,41,59,.58) );
        box-shadow: 0 8px 24px rgba(0,0,0,.25), 0 0 18px rgba(99,102,241,.18);
    }


    .premium-link.active .nav-icon-box {
        color: #fff;
        background: linear-gradient( 145deg, rgba(99,102,241,.95), rgba(30,64,175,.76) );
        border-color: rgba(255,255,255,.17);
        box-shadow: 0 10px 28px rgba(79,70,229,.34), 0 0 25px rgba(99,102,241,.18) inset;
    }


    /* =========================================================
           ICON COLORS
           ========================================================= */

    .user-icon {
