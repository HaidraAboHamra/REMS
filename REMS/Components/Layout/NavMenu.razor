        color: rgba(165,180,252,.48);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .premium-link:hover .nav-title {
        color: #ffffff;
    }


    .premium-link:hover .nav-subtitle {
        color: rgba(199,210,254,.72);
    }


    .premium-link.active .nav-title {
        color: #ffffff;
    }


    .premium-link.active .nav-subtitle {
        color: rgba(199,210,254,.80);
    }


    /* =========================================================
           ARROW
           ========================================================= */

    .nav-arrow {
        color: rgba(129,140,248,.28);
