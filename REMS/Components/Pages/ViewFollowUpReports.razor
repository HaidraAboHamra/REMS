@page "/followupreport"
@using REMS.Enititys
@using REMS.Services
@using MudBlazor
@using REMS.Interfaces
@inject NavigationManager NavigationManager
@inject IFollowUpReportService _service
@inject ExcelService _excel
@inject Test _repo
@attribute [Authorize(Roles = "Manager,Admin,Admin1,FUser")]
@inject ISnackbar Snackbar

@using Blazorise
@using System.Text.Json
@using System.IO

<PageTitle>التقارير والمتابعة</PageTitle>

<div class="reports-page">

    <!-- Ambient Background -->
    <div class="reports-orb orb-one"></div>
    <div class="reports-orb orb-two"></div>
    <div class="reports-orb orb-three"></div>

    <div class="reports-grid"></div>

    <div class="reports-scan"></div>


    <!-- Watermark -->
    <img src="logo1.png"
         alt="HEMS"
         class="watermark" />


    <main class="reports-content">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <section class="reports-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-left">

                <div class="header-icon">
                    📊
                </div>

                <div>

                    <span class="header-kicker">
                        HEX STUDIO • HEMS
                    </span>

                    <h1>
                        التقارير والمتابعة
                    </h1>

                    <p>
                        إدارة تقارير المهام ومتابعة الإنجاز والأداء
                    </p>

                </div>

            </div>

            <div class="header-badge">
                <span class="badge-dot"></span>
                LIVE
            </div>

        </section>


        <!-- =====================================================
             REPORTS CONTENT
             ===================================================== -->

        <section class="reports-card">

            <div class="card-top-line"></div>


            @if (Reports is null)
            {
                <!-- =========================
                     LOADING
                     ========================= -->
                <div class="loading-state">

                    <div class="loader-ring">
                        <div class="loader-core"></div>
                    </div>

                    <div class="loading-text">
                        جاري تحميل التقارير...
                    </div>

                    <div class="loading-subtext">
                        HEMS REPORT ENGINE
                    </div>

                </div>
            }
            else if (Reports.Count == 0)
            {
                <!-- =========================
                     EMPTY
                     ========================= -->
                <div class="empty-state">

                    <div class="empty-icon">
                        📭
                    </div>

                    <h2>
                        لا يوجد تقارير لليوم
                    </h2>

                    <p>
                        لم يتم العثور على تقارير مسجلة لهذا التاريخ.
                    </p>

                </div>
            }
            else
            {

                <!-- =========================
                     TABLE
                     ========================= -->

                <div class="table-wrapper">

                    <table class="reports-table" dir="rtl">

                        <thead>

                            <tr>

                                <th>
                                    <span>المهمة</span>
                                </th>

                                <th>
                                    <span>النوع</span>
                                </th>

                                <th>
                                    <span>العميل / المشروع</span>
                                </th>

                                <th>
                                    <span>الموظف</span>
                                </th>

                                <th>
                                    <span>الأولوية</span>
                                </th>

                                <th>
                                    <span>التقدم</span>
                                </th>

                                <th>
                                    <span>المنجز</span>
                                </th>

                                <th>
                                    <span>المتبقي</span>
                                </th>

                                <th>
                                    <span>الحالة</span>
                                </th>

                                <th>
                                    <span>التسليم</span>
                                </th>

                                <th>
                                    <span>إجراء</span>
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Reports)
                            {
                                var itemStatus = GetDisplayStatus(item);
                                <tr class="report-row">

                                    <!-- المهمة -->
                                    <td>

                                        <div class="task-cell">

                                            <div class="task-icon">
                                                📝
                                            </div>

                                            <div class="task-content">

                                                <strong>
                                                    @item.Content
                                                </strong>

                                                <span>
                                                    @item.TaskDetails
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- النوع -->
                                    <td>

                                        <span class="table-pill type-pill">
                                            @item.TaskType
                                        </span>

                                    </td>


                                    <!-- العميل -->
                                    <td>

                                        <div class="project-cell">
                                            <span class="project-dot"></span>
                                            @item.ClientOrProject
                                        </div>

                                    </td>


                                    <!-- الموظف -->
                                    <td>

                                        <div class="employee-cell">

                                            <div class="employee-avatar">
                                                👤
                                            </div>

                                            <span>
                                                @item.AssignedEmployee
                                            </span>

                                        </div>

                                    </td>


                                    <!-- الأولوية -->
                                    <td>

                                        <span class="priority-pill">
                                            @item.Priority
                                        </span>

                                    </td>


                                    <!-- التقدم -->
                                    <td style="min-width:180px">

                                        <div class="progress-wrapper">

                                            <div class="progress-meta">

                                                <span>
                                                    التقدم
                                                </span>

                                                <strong>
                                                    @item.ProgressPercentage%
                                                </strong>

                                            </div>

                                            <div class="premium-progress">

                                                <div class="premium-progress-bar"
                                                     style="width:@($"{item.ProgressPercentage}%")">

                                                    <span class="progress-glow"></span>

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- المنجز -->
                                    <td>

                                        <div class="counter-box completed">

                                            <strong>
                                                @item.CompletedItems
                                            </strong>

                                            <span>
                                                / @item.TotalItems
                                            </span>

                                        </div>

                                    </td>


                                    <!-- المتبقي -->
                                    <td>

                                        <div class="counter-box remaining">

                                            <strong>
                                                @item.RemainingItems
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- الحالة -->
                                    <td>

                                        @if (itemStatus == "مكتملة")
                                        {
                                            <span class="status-pill status-completed">
                                                <span class="status-dot"></span>
                                                مكتملة
                                            </span>
                                        }
                                        else if (itemStatus == "قيد التنفيذ")
                                        {
                                            <span class="status-pill status-progress">
                                                <span class="status-dot"></span>
                                                قيد التنفيذ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill @(itemStatus == "متأخرة" ? "status-overdue" : "status-pending")">
                                                <span class="status-dot"></span>
                                                @itemStatus
                                            </span>
                                        }

                                    </td>


                                    <!-- التسليم -->
                                    <td>

                                        <div class="date-cell">

                                            <span class="date-icon">
                                                📅
                                            </span>

                                            @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")

                                        </div>

                                    </td>


                                    <!-- إجراء -->
                                    <td>

                                        <button class="edit-btn"
                                                @onclick="@(() => EditReport(item.Id))">

                                            <span>
                                                ✏️
                                            </span>

                                            تحديث

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }


            <!-- =====================================================
                 ACTION AREA
                 ===================================================== -->

            <div class="report-actions">

                <div class="actions-title">

                    <span class="actions-icon">
                        ⚡
                    </span>

                    <div>

                        <strong>
                            أدوات التقارير
                        </strong>

                        <span>
                            توليد وإرسال التقارير
                        </span>

                    </div>

                </div>


                <div class="actions-grid">

                    <!-- Date -->
                    <div class="action-card">

                        <div class="action-card-icon">
                            📅
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">فترة التقرير</span>

                            <div class="date-range">
                                <MudDatePicker Label="من تاريخ" @bind-Date="FromDate" Class="premium-datepicker" />
                                <MudDatePicker Label="إلى تاريخ" @bind-Date="ToDate" Class="premium-datepicker" />
                            </div>

                        </div>

                    </div>


                    <!-- Generate -->
                    <div class="action-card">

                        <div class="action-card-icon">
                            📈
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">
                                توليد Excel حسب الفلتر
                            </span>

                            <select class="premium-email-input" @bind="SelectedStatus" aria-label="حالة المهمة">
                                <option value="الكل">كل الحالات</option>
                                <option value="معلقة">معلقة</option>
                                <option value="قيد التنفيذ">قيد التنفيذ</option>
                                <option value="متأخرة">متأخرة</option>
                                <option value="مكتملة">مكتملة</option>
                            </select>

                            <MudButton Variant="MudBlazor.Variant.Filled"
                                       Color="MudBlazor.Color.Primary"
                                       Class="premium-action-button"
                                       OnClick="GenerateReport"
                            >

                                <span>⚡</span>

                                توليد التقرير

                            </MudButton>

                            <button class="filter-button" @onclick="ApplyFilters">تطبيق الفلتر على الجدول</button>

                        </div>

                    </div>


                    <!-- Email -->
                    <div class="action-card email-card">

                        <div class="action-card-icon">
                            📧
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">
                                إرسال التقرير
                            </span>

                            <InputText @bind-Value="Email"
                                       Placeholder="أدخل البريد الإلكتروني"
                                       @oninput="CheckEmail"
                                       class="premium-email-input" />

                            <MudButton Variant="MudBlazor.Variant.Filled"
                                       Color="MudBlazor.Color.Secondary"
                                       Class="premium-action-button secondary-action"
                                       OnClick="@SendBaby"
                                       Disabled="@IsSendDisabled">

                                <span>🚀</span>

                                إرسال التقرير

                            </MudButton>

                        </div>

                    </div>

                </div>


                <!-- Download -->
                @if (!string.IsNullOrEmpty(reportUrl))
                {
                    <div class="download-panel">

                        <div class="download-icon">
                            📥
                        </div>

                        <div class="download-content">

                            <strong>
                                التقرير جاهز
                            </strong>

                            <span>
                                تم إنشاء تقرير Excel بنجاح ويمكنك تحميله الآن.
                            </span>

                        </div>

                        <a href="@reportUrl"
                           download
                           class="download-btn">

                            تحميل التقرير

                            <span>
                                ↓
                            </span>

                        </a>

                    </div>
                }

            </div>

        </section>

    </main>

</div>


@code {
    private DateTime? FromDate = DateTime.Today;
    private DateTime? ToDate = DateTime.Today;
    private string SelectedStatus = "الكل";
    public List<FollowUpReport>? Reports { get; set; }
    public bool isGeneratingExcel = false;
    private string reportUrl;
    private string Email;
    private bool IsSendDisabled = true;
    private IBrowserFile? file { get; set; }
    public FollowUpReport? followUpReport { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ApplyFilters();
    }

    private async Task GenerateReport()
    {
        if (!HasValidDateRange())
        {
            Snackbar.Add("تأكد أن تاريخ البداية يسبق تاريخ النهاية.", Severity.Warning);
            return;
        }

        isGeneratingExcel = true;
        try
        {
            var request = await _service.GetReports(CurrentFilter);
            Reports = request;
            reportUrl = await _excel.GenerateFollowUpReportExcelAsync(request, FromDate ?? DateTime.Today);
            Snackbar.Add($"تم إنشاء تقرير Excel يضم {request.Count} مهمة.", Severity.Success);
        }
        finally
        {
            isGeneratingExcel = false;
        }
    }

    private async Task ApplyFilters()
    {
        if (!HasValidDateRange())
        {
            Snackbar.Add("تأكد أن تاريخ البداية يسبق تاريخ النهاية.", Severity.Warning);
            return;
        }

        Reports = await _service.GetReports(CurrentFilter);
    }

    async void HandleFileSelected(InputFileChangeEventArgs e)
    {
        file = e.File;
    }

    private async Task SendBaby()
    {
        try
        {
            if (!string.IsNullOrEmpty(Email))
            {
                await _repo.SendTryFollowUpReport(
                    Email,
                    FromDate ?? DateTime.Today
                );
            }

            Snackbar.Add(
                "👌تم ارسال التقرير",
                Severity.Success
            );
        }
        catch
        {
            Snackbar.Add(
                "👌لم يتم ارساله راجع القسم البرمجي",
                Severity.Error
            );

            Console.WriteLine(
                "يرجى إدخال البريد الإلكتروني بشكل صحيح."
            );
        }
    }

    private void CheckEmail(ChangeEventArgs e)
    {
        Email =
            e.Value?.ToString();

        IsSendDisabled =
            string.IsNullOrEmpty(Email);
    }

    private void EditReport(int reportId)
    {
        NavigationManager.NavigateTo(
            $"/followup-report/{reportId}"
        );
    }


    class ReportField
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }


    bool IsImageFile(string? pathOrName)
    {
        if (string.IsNullOrEmpty(pathOrName))
            return false;

        var ext =
            Path.GetExtension(pathOrName)
                .ToLowerInvariant();

        var images = new[]
        {
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".bmp",
            ".svg",
            ".webp"
        };

        return images.Contains(ext);
    }
    private ReportFilter CurrentFilter => new()
    {
        FromDate = FromDate,
        ToDate = ToDate,
        Status = SelectedStatus
    };

    private bool HasValidDateRange() =>
        !FromDate.HasValue || !ToDate.HasValue || FromDate.Value.Date <= ToDate.Value.Date;

    private static string GetDisplayStatus(FollowUpReport report) =>
        !report.IsDone && report.DueDate?.Date < DateTime.Today ? "متأخرة" :
        report.IsDone ? "مكتملة" :
        report.IsDoneOrNot == "قيد التنفيذ" ? "قيد التنفيذ" : "معلقة";

    string DisplayPath(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        if (
            value.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase
            )
            ||
            value.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase
            )
        )
            return value;

        var normalized =
            value.Replace("\\", "/");

        if (!normalized.StartsWith("/"))
            normalized = "/" + normalized;

        return normalized;
    }
}



