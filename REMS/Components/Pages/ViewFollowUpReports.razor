@page "/followupreport"
@using REMS.Enititys
@using REMS.Services
@using MudBlazor
@using REMS.Interfaces
@inject NavigationManager NavigationManager
@inject IFollowUpReportService _service
@inject ExcelService _excel
@inject Test _repo
@attribute [Authorize(Roles = "Manager,Admin,FUser")]
@inject ISnackbar Snackbar

@using Blazorise
@using System.Text.Json
@using System.IO

<PageTitle>التقارير والمتابعة</PageTitle>

<div class="reports-page">

    <!-- Ambient Background -->
    <div class="reports-orb orb-one"></div>
    <div class="reports-orb orb-two"></div>
    <div class="reports-orb orb-three"></div>

    <div class="reports-grid"></div>

    <div class="reports-scan"></div>


    <!-- Watermark -->
    <img src="logo1.png"
         alt="HEMS"
         class="watermark" />


    <main class="reports-content">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <section class="reports-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-left">

                <div class="header-icon">
                    📊
                </div>

                <div>

                    <span class="header-kicker">
                        HEX STUDIO • HEMS
                    </span>

                    <h1>
                        التقارير والمتابعة
                    </h1>

                    <p>
                        إدارة تقارير المهام ومتابعة الإنجاز والأداء
                    </p>

                </div>

            </div>

            <div class="header-badge">
                <span class="badge-dot"></span>
                LIVE
            </div>

        </section>


        <!-- =====================================================
             REPORTS CONTENT
             ===================================================== -->

        <section class="reports-card">

            <div class="card-top-line"></div>


            @if (Reports is null)
            {
                <!-- =========================
                     LOADING
                     ========================= -->
                <div class="loading-state">

                    <div class="loader-ring">
                        <div class="loader-core"></div>
                    </div>

                    <div class="loading-text">
                        جاري تحميل التقارير...
                    </div>

                    <div class="loading-subtext">
                        HEMS REPORT ENGINE
                    </div>

                </div>
            }
            else if (Reports.Count == 0)
            {
                <!-- =========================
                     EMPTY
                     ========================= -->
                <div class="empty-state">

                    <div class="empty-icon">
                        📭
                    </div>

                    <h2>
                        لا يوجد تقارير لليوم
                    </h2>

                    <p>
                        لم يتم العثور على تقارير مسجلة لهذا التاريخ.
                    </p>

                </div>
            }
            else
            {

                <!-- =========================
                     TABLE
                     ========================= -->

                <div class="table-wrapper">

                    <table class="reports-table" dir="rtl">

                        <thead>

                            <tr>

                                <th>
                                    <span>المهمة</span>
                                </th>

                                <th>
                                    <span>النوع</span>
                                </th>

                                <th>
                                    <span>العميل / المشروع</span>
                                </th>

                                <th>
                                    <span>الموظف</span>
                                </th>

                                <th>
                                    <span>الأولوية</span>
                                </th>

                                <th>
                                    <span>التقدم</span>
                                </th>

                                <th>
                                    <span>المنجز</span>
                                </th>

                                <th>
                                    <span>المتبقي</span>
                                </th>

                                <th>
                                    <span>الحالة</span>
                                </th>

                                <th>
                                    <span>التسليم</span>
                                </th>

                                <th>
                                    <span>إجراء</span>
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Reports)
                            {
                                <tr class="report-row">

                                    <!-- المهمة -->
                                    <td>

                                        <div class="task-cell">

                                            <div class="task-icon">
                                                📝
                                            </div>

                                            <div class="task-content">

                                                <strong>
                                                    @item.Content
                                                </strong>

                                                <span>
                                                    @item.TaskDetails
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- النوع -->
                                    <td>

                                        <span class="table-pill type-pill">
                                            @item.TaskType
                                        </span>

                                    </td>


                                    <!-- العميل -->
                                    <td>

                                        <div class="project-cell">
                                            <span class="project-dot"></span>
                                            @item.ClientOrProject
                                        </div>

                                    </td>


                                    <!-- الموظف -->
                                    <td>

                                        <div class="employee-cell">

                                            <div class="employee-avatar">
                                                👤
                                            </div>

                                            <span>
                                                @item.AssignedEmployee
                                            </span>

                                        </div>

                                    </td>


                                    <!-- الأولوية -->
                                    <td>

                                        <span class="priority-pill">
                                            @item.Priority
                                        </span>

                                    </td>


                                    <!-- التقدم -->
                                    <td style="min-width:180px">

                                        <div class="progress-wrapper">

                                            <div class="progress-meta">

                                                <span>
                                                    التقدم
                                                </span>

                                                <strong>
                                                    @item.ProgressPercentage%
                                                </strong>

                                            </div>

                                            <div class="premium-progress">

                                                <div class="premium-progress-bar"
                                                     style="width:@($"{item.ProgressPercentage}%")">

                                                    <span class="progress-glow"></span>

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- المنجز -->
                                    <td>

                                        <div class="counter-box completed">

                                            <strong>
                                                @item.CompletedItems
                                            </strong>

                                            <span>
                                                / @item.TotalItems
                                            </span>

                                        </div>

                                    </td>


                                    <!-- المتبقي -->
                                    <td>

                                        <div class="counter-box remaining">

                                            <strong>
                                                @item.RemainingItems
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- الحالة -->
                                    <td>

                                        @if (item.IsDoneOrNot == "مكتملة")
                                        {
                                            <span class="status-pill status-completed">
                                                <span class="status-dot"></span>
                                                مكتملة
                                            </span>
                                        }
                                        else if (item.IsDoneOrNot == "قيد التنفيذ")
                                        {
                                            <span class="status-pill status-progress">
                                                <span class="status-dot"></span>
                                                قيد التنفيذ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-pending">
                                                <span class="status-dot"></span>
                                                لم تبدأ
                                            </span>
                                        }

                                    </td>


                                    <!-- التسليم -->
                                    <td>

                                        <div class="date-cell">

                                            <span class="date-icon">
                                                📅
                                            </span>

                                            @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")

                                        </div>

                                    </td>


                                    <!-- إجراء -->
                                    <td>

                                        <button class="edit-btn"
                                                @onclick="@(() => EditReport(item.Id))">

                                            <span>
                                                ✏️
                                            </span>

                                            تحديث

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }


            <!-- =====================================================
                 ACTION AREA
                 ===================================================== -->

            <div class="report-actions">

                <div class="actions-title">

                    <span class="actions-icon">
                        ⚡
                    </span>

                    <div>

                        <strong>
                            أدوات التقارير
                        </strong>

                        <span>
                            توليد وإرسال التقارير
                        </span>

                    </div>

                </div>


                <div class="actions-grid">

                    <!-- Date -->
                    <div class="action-card">

                        <div class="action-card-icon">
                            📅
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">
                                تاريخ التقرير
                            </span>

                            <MudDatePicker Label="اختر تاريخ التقرير"
                                           @bind-Date="reportDate"
                                           Class="premium-datepicker"
                                           @OnClick="MakeItTrue" />

                        </div>

                    </div>


                    <!-- Generate -->
                    <div class="action-card">

                        <div class="action-card-icon">
                            📈
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">
                                إنشاء التقرير
                            </span>

                            <MudButton Variant="MudBlazor.Variant.Filled"
                                       Color="MudBlazor.Color.Primary"
                                       Class="premium-action-button"
                                       OnClick="GenerateReport"
                            >

                                <span>⚡</span>

                                توليد التقرير

                            </MudButton>

                        </div>

                    </div>


                    <!-- Email -->
                    <div class="action-card email-card">

                        <div class="action-card-icon">
                            📧
                        </div>

                        <div class="action-card-content">

                            <span class="action-label">
                                إرسال التقرير
                            </span>

                            <InputText @bind-Value="Email"
                                       Placeholder="أدخل البريد الإلكتروني"
                                       @oninput="CheckEmail"
                                       class="premium-email-input" />

                            <MudButton Variant="MudBlazor.Variant.Filled"
                                       Color="MudBlazor.Color.Secondary"
                                       Class="premium-action-button secondary-action"
                                       OnClick="@SendBaby"
                                       Disabled="@IsSendDisabled">

                                <span>🚀</span>

                                إرسال التقرير

                            </MudButton>

                        </div>

                    </div>

                </div>


                <!-- Download -->
                @if (!string.IsNullOrEmpty(reportUrl))
                {
                    <div class="download-panel">

                        <div class="download-icon">
                            📥
                        </div>

                        <div class="download-content">

                            <strong>
                                التقرير جاهز
                            </strong>

                            <span>
                                تم إنشاء تقرير Excel بنجاح ويمكنك تحميله الآن.
                            </span>

                        </div>

                        <a href="@reportUrl"
                           download
                           class="download-btn">

                            تحميل التقرير

                            <span>
                                ↓
                            </span>

                        </a>

                    </div>
                }

            </div>

        </section>

    </main>

</div>


@code {
    public DateTime? reportDate;
    public List<FollowUpReport>? Reports { get; set; }
    public bool isGeneratingExcel = false;
    private string reportUrl;
    private bool ChooseDate = true;
    private string Email;
    private bool IsSendDisabled = true;
    private IBrowserFile? file { get; set; }
    public FollowUpReport? followUpReport { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await _service.GetReportsByDate(DateTime.Now.Date);

        if (result != null)
            Reports = result;
    }

    private async Task GenerateReport()
    {
        if (reportDate == null)
        {
            Snackbar.Add("اختر تاريخ");
            return;

        }
        isGeneratingExcel = true;

        var request =
            await _service.GetReportsByDate(reportDate.Value);

        reportUrl =
            await _excel.GenerateFollowUpReportExcelAsync(
                request,
                reportDate.Value
            );

        isGeneratingExcel = false;

        await ViewReport();
    }

    private async Task ViewReport()
    {
        var result =
            await _service.GetReportsByDate(reportDate.Value);

        if (result != null)
            Reports = result;
    }

    async void HandleFileSelected(InputFileChangeEventArgs e)
    {
        file = e.File;
    }

    private async Task SendBaby()
    {
        try
        {
            if (!string.IsNullOrEmpty(Email))
            {
                await _repo.SendTryFollowUpReport(
                    Email,
                    reportDate.Value
                );
            }

            Snackbar.Add(
                "👌تم ارسال التقرير",
                Severity.Success
            );
        }
        catch
        {
            Snackbar.Add(
                "👌لم يتم ارساله راجع القسم البرمجي",
                Severity.Error
            );

            Console.WriteLine(
                "يرجى إدخال البريد الإلكتروني بشكل صحيح."
            );
        }
    }

    private void CheckEmail(ChangeEventArgs e)
    {
        Email =
            e.Value?.ToString();

        IsSendDisabled =
            string.IsNullOrEmpty(Email);
    }

    private void EditReport(int reportId)
    {
        NavigationManager.NavigateTo(
            $"/followup-report/{reportId}"
        );
    }


    class ReportField
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }


    bool IsImageFile(string? pathOrName)
    {
        if (string.IsNullOrEmpty(pathOrName))
            return false;

        var ext =
            Path.GetExtension(pathOrName)
                .ToLowerInvariant();

        var images = new[]
        {
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".bmp",
            ".svg",
            ".webp"
        };

        return images.Contains(ext);
    }
    public void MakeItTrue()
    {
        ChooseDate = false;
    }

    string DisplayPath(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        if (
            value.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase
            )
            ||
            value.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase
            )
        )
            return value;

        var normalized =
            value.Replace("\\", "/");

        if (!normalized.StartsWith("/"))
            normalized = "/" + normalized;

        return normalized;
    }
}


<style>

    /* =========================================================
               HEMS REPORTS PAGE
               ========================================================= */

    .reports-page {
        position: relative;
        min-height: 100vh;
        padding: clamp(14px, 2.5vw, 30px);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient( circle at 82% 8%, rgba(67,56,202,.23), transparent 26% ), radial-gradient( circle at 15% 90%, rgba(29,78,216,.16), transparent 25% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        color: #f8fafc;
    }


    /* =========================================================
               GRID
               ========================================================= */

    .reports-grid {
        position: absolute;
        inset: 0;
        z-index: -3;
        pointer-events: none;
        background: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
        background-size: 42px 42px;
        mask-image: linear-gradient( to bottom, black, transparent 92% );
        animation: gridMove 22s linear infinite;
    }


    .reports-page::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background: radial-gradient( circle at center, transparent 0%, rgba(2,2,8,.18) 48%, rgba(2,2,8,.60) 100% );
    }


    /* =========================================================
               AMBIENT
               ========================================================= */

    .reports-orb {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        filter: blur(8px);
        mix-blend-mode: screen;
        z-index: -1;
    }


    .orb-one {
        width: 340px;
        height: 340px;
        top: -120px;
        right: -80px;
        background: radial-gradient( circle, rgba(99,102,241,.35), transparent 68% );
        animation: orbOne 11s ease-in-out infinite;
    }


    .orb-two {
        width: 400px;
        height: 400px;
        bottom: -150px;
        left: -140px;
        background: radial-gradient( circle, rgba(37,99,235,.23), transparent 68% );
        animation: orbTwo 14s ease-in-out infinite;
    }


    .orb-three {
        width: 220px;
        height: 220px;
        top: 44%;
        left: 48%;
        background: radial-gradient( circle, rgba(129,140,248,.12), transparent 66% );
        animation: orbThree 6s ease-in-out infinite;
    }


    .reports-scan {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        z-index: -1;
        transform: skewX(-22deg);
        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.055), transparent );
        animation: scan 8s ease-in-out infinite;
    }


    /* =========================================================
               CONTENT
               ========================================================= */

    .reports-content {
        position: relative;
        width: min( 1500px, 100% );
        margin: 0 auto;
        z-index: 2;
    }


    /* =========================================================
               WATERMARK
               ========================================================= */

    .watermark {
        width: min(420px,40vw);
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        opacity: .025;
        z-index: -1;
        pointer-events: none;
        filter: grayscale(1) brightness(2);
        animation: watermarkPulse 7s ease-in-out infinite;
    }


    /* =========================================================
               HEADER
               ========================================================= */

    .reports-header {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        min-height: 150px;
        padding: 30px clamp(20px,4vw,42px);
        margin-bottom: 20px;
        border: 1px solid rgba(129,140,248,.20);
        border-radius: 26px;
        background: radial-gradient( circle at 85% 10%, rgba(129,140,248,.28), transparent 28% ), linear-gradient( 135deg, #020204 0%, #0a0a14 48%, #171449 100% );
        box-shadow: 0 24px 70px rgba(0,0,0,.48), 0 0 0 1px rgba(255,255,255,.025) inset, 0 0 50px rgba(67,56,202,.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        animation: cardReveal .75s cubic-bezier(.2,.75,.2,1) both;
    }


    .header-left {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 17px;
    }


    .header-icon {
        width: 62px;
        height: 62px;
        flex: 0 0 62px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        font-size: 1.65rem;
        background: linear-gradient( 145deg, rgba(99,102,241,.95), rgba(30,64,175,.76) );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 28px rgba(99,102,241,.22) inset;
        animation: iconPulse 3.5s ease-in-out infinite;
    }


    .header-kicker {
        display: block;
        margin-bottom: 5px;
        color: #a5b4fc;
        font-family: "Space Grotesk", sans-serif;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .23em;
        text-transform: uppercase;
    }


    .reports-header h1 {
        margin: 0;
        font-family: "Unbounded", "Space Grotesk", sans-serif;
        font-size: clamp( 1.3rem, 2.4vw, 2rem );
        font-weight: 500;
        line-height: 1.3;
    }


    .reports-header p {
        margin: 6px 0 0;
        color: rgba(226,232,240,.68);
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .85rem;
    }


    .header-badge {
        position: relative;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        color: #c7d2fe;
        font-family: "JetBrains Mono", monospace;
        font-size: .68rem;
        border: 1px solid rgba(129,140,248,.20);
        background: rgba(49,46,129,.18);
        box-shadow: 0 0 20px rgba(99,102,241,.08);
        letter-spacing: .08em;
    }


    .badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 10px rgba(56,189,248,.80);
        animation: livePulse 1.8s ease-in-out infinite;
    }


    /* =========================================================
               REPORT CARD
               ========================================================= */

    .reports-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(129,140,248,.18);
        border-radius: 24px;
        background: rgba(8,9,18,.84);
        box-shadow: 0 24px 70px rgba(0,0,0,.46), 0 0 0 1px rgba(255,255,255,.02) inset;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        animation: cardReveal .8s .10s cubic-bezier(.2,.75,.2,1) both;
    }


    .card-top-line {
        position: absolute;
        top: 0;
        left: 4%;
        width: 92%;
        height: 1px;
        background: linear-gradient( 90deg, transparent, rgba(129,140,248,.48), rgba(56,189,248,.40), transparent );
        box-shadow: 0 0 15px rgba(99,102,241,.20);
    }


    /* =========================================================
               TABLE
               ========================================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        padding: 18px;
        scrollbar-width: thin;
    }


        .table-wrapper::-webkit-scrollbar {
            height: 8px;
        }


        .table-wrapper::-webkit-scrollbar-track {
            background: rgba(255,255,255,.03);
        }


        .table-wrapper::-webkit-scrollbar-thumb {
            border-radius: 999px;
            background: linear-gradient( 90deg, #312e81, #4338ca, #1d4ed8 );
        }


    .reports-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: separate;
        border-spacing: 0 7px;
        color: #e5e7eb;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
    }


        .reports-table thead th {
            position: relative;
            padding: 14px 13px;
            color: #a5b4fc;
            font-size: .72rem;
            font-weight: 800;
            white-space: nowrap;
            text-align: right;
            border-bottom: 1px solid rgba(129,140,248,.10);
        }


            .reports-table thead th::after {
                content: "";
                position: absolute;
                bottom: -1px;
                right: 13px;
                width: 24px;
                height: 2px;
                border-radius: 999px;
                background: linear-gradient( 90deg, #6366f1, transparent );
            }


    .report-row td {
        padding: 14px 13px;
        background: rgba(15,17,29,.72);
        border-top: 1px solid rgba(129,140,248,.07);
        border-bottom: 1px solid rgba(129,140,248,.07);
        transition: .25s ease;
        vertical-align: middle;
    }


        .report-row td:first-child {
            border-right: 1px solid rgba(129,140,248,.07);
            border-radius: 0 13px 13px 0;
        }


        .report-row td:last-child {
            border-left: 1px solid rgba(129,140,248,.07);
            border-radius: 13px 0 0 13px;
        }


    .report-row:hover td {
        background: linear-gradient( 135deg, rgba(30,41,59,.82), rgba(49,46,129,.20) );
        border-color: rgba(129,140,248,.14);
        box-shadow: 0 8px 24px rgba(0,0,0,.15);
    }


    /* =========================================================
               TASK CELL
               ========================================================= */

    .task-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 220px;
    }


    .task-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(129,140,248,.13);
        font-size: .95rem;
    }


    .task-content strong {
        display: block;
        color: #f8fafc;
        font-size: .83rem;
