@page "/AddFollowUpReport"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using REMS.Data
@using REMS.Interfaces
@using REMS.Enititys

@inject IReportService ReportService
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment env
@inject UserService UserRepo
@inject AppDbContext Db

@attribute [Authorize(Roles = "Manager,Admin,FUser")]

<div class="page-wrapper" dir="rtl">

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>

    <div class="card form-card">

        <div class="card-header">
            <div class="header-glow"></div>
            <div class="header-content">
                <div class="header-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <span class="header-kicker">TASK MANAGEMENT</span>
                    <h3>إضافة مهمة جديدة</h3>
                    <p>أنشئ المهمة وحدد تفاصيلها ومسؤوليتها بسهولة</p>
                </div>
            </div>
            <div class="header-scan"></div>
        </div>

        <div class="card-body">
            <div class="body-grid-glow"></div>

            <EditForm Model="vm"
                      OnValidSubmit="HandleValidSubmit">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="row g-3">

                    <!-- ================================================= -->
                    <!-- اسم المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            اسم المهمة
                            <span class="required">*</span>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.Content"
                                   placeholder="مثال: تصميم حملة إعلانية" />

                        <ValidationMessage For="@(() => vm.Content)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تفاصيل المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            تفاصيل المهمة
                            <span class="required">*</span>
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.TaskDetails"
                                       placeholder="اكتب تفاصيل المهمة..." />

                        <ValidationMessage For="@(() => vm.TaskDetails)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- نوع المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            نوع المهمة
                        </label>

                        <select class="form-select"
                                @bind="vm.TaskType">

                            <option value="">
                                -- اختر النوع --
                            </option>

                            <option value="تسويق">
                                تسويق
                            </option>

                            <option value="برمجة">
                                برمجة
                            </option>

                            <option value="تصميم">
                                تصميم
                            </option>

                            <option value="إدارة">
                                إدارة
                            </option>

                            <option value="أخرى">
                                أخرى
                            </option>

                        </select>

                    </div>

                    <!-- ================================================= -->
                    <!-- العميل / المشروع -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            العميل / المشروع
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.ClientOrProject"
                                   placeholder="اسم العميل أو المشروع" />

                    </div>

                    <!-- ================================================= -->
                    <!-- الموظف المسؤول -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الموظف المسؤول
                            <span class="required">*</span>
                        </label>

                        @if (User.IsFollowUpAdmin)
                        {
                            <select class="form-select"
                                    @bind="SelectedEmployeeId">

                                <option value="">
                                    -- اختر موظف قسم المتابعة --
                                </option>

                                @foreach (var employee in FollowUpEmployees)
                                {
                                    <option value="@employee.Id">
                                        @employee.FullName
                                    </option>
                                }

                            </select>
                        }
                        else
                        {
                            <div class="form-control readonly-field">

                                <i class="fas fa-user me-2"></i>

                                @if (!string.IsNullOrWhiteSpace(
                                    User.FullName))
                                {
                                    @User.FullName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        جارٍ تحميل بيانات الموظف...
                                    </span>
                                }

                            </div>
                        }

                    </div>

                    <!-- ================================================= -->
                    <!-- الأولوية -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الأولوية
                        </label>

                        <select class="form-select"
                                @bind="vm.Priority">

                            <option value="منخفضة">
                                منخفضة
                            </option>

                            <option value="متوسطة">
                                متوسطة
                            </option>

                            <option value="عالية">
                                عالية
                            </option>

                            <option value="عاجلة">
                                عاجلة
                            </option>

                        </select>

                    </div>

                    <!-- ================================================= -->
                    <!-- عدد البنود -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            عدد الأمور المتعلقة بالمهمة
                            <span class="required">*</span>
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.TotalItems" />

                        <ValidationMessage For="@(() => vm.TotalItems)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- المدة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            المدة المتوقعة (يوم)
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.ExpectedDurationDays" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تاريخ البدء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ البدء
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.StartDate" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تاريخ التسليم -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ التسليم المتوقع
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.DueDate" />

                    </div>

                    <!-- ================================================= -->
                    <!-- المنجز عند الإنشاء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            ما تم إنجازه عند الإنشاء
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.CompletedItems" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تفاصيل المنجز -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ما تم إنجازه
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.CompletedDetails"
                                       placeholder="اكتب فقط الأمور التي تم إنجازها..." />

                    </div>

                    <!-- ================================================= -->
                    <!-- رفع ملف -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ملف المهمة
                            <span class="text-muted">
                                (اختياري)
                            </span>
                        </label>

                        <div class="file-upload-box">

                            <InputFile OnChange="OnFileSelected" />

                            @if (!string.IsNullOrWhiteSpace(FileName))
                            {
                                <div class="file-info mt-2">

                                    <i class="fas fa-file me-2"></i>

                                    @FileName

                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(FileError))
                            {
                                <div class="text-danger small mt-2">

                                    @FileError

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <!-- ===================================================== -->
                <!-- زر الإنشاء -->
                <!-- ===================================================== -->

                <div class="mt-4 text-center">

                    <button type="submit"
                            class="btn submit-btn"
                            disabled="@IsSaving">

                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>
                                جارٍ إنشاء المهمة...
                            </span>
                        }
                        else
                        {
                            <i class="fas fa-plus me-2"></i>

                            <span>
                                إنشاء المهمة
                            </span>
                        }

                    </button>

                </div>

            </EditForm>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">

                    <i class="fas fa-check-circle me-2"></i>

                    @successMessage

                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">

                    <i class="fas fa-exclamation-circle me-2"></i>

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>

<style>
    :root {
        --ui-black: #05050a;
        --ui-black-2: #090a12;
        --ui-indigo: #312e81;
        --ui-indigo-2: #4338ca;
        --ui-blue: #1d4ed8;
        --ui-cyan: #38bdf8;
        --ui-white: #f8fafc;
        --ui-muted: #a5b4fc;
        --ui-border: rgba(129, 140, 248, 0.22);
        --ui-glow: rgba(79, 70, 229, 0.45);
    }

    .page-wrapper {
        position: relative;
        min-height: 100%;
        padding: clamp(14px, 2.5vw, 32px);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient(circle at 82% 8%, rgba(67, 56, 202, 0.23), transparent 26%), radial-gradient(circle at 15% 90%, rgba(29, 78, 216, 0.16), transparent 25%), linear-gradient(135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100%);
    }

        .page-wrapper::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, black, transparent 92%);
            animation: gridDrift 22s linear infinite;
        }

        .page-wrapper::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: radial-gradient(circle at center, transparent 0%, rgba(2, 2, 8, 0.20) 48%, rgba(2, 2, 8, 0.55) 100%);
        }

    .ambient {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        filter: blur(8px);
        opacity: 0.62;
        z-index: -1;
        mix-blend-mode: screen;
    }

    .ambient-one {
        width: 260px;
        height: 260px;
        top: 6%;
        right: -90px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.42), transparent 68%);
        animation: floatOne 10s ease-in-out infinite;
    }

    .ambient-two {
        width: 320px;
        height: 320px;
        bottom: -120px;
        left: -110px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.28), transparent 68%);
        animation: floatTwo 13s ease-in-out infinite;
    }

    .ambient-three {
        width: 180px;
        height: 180px;
        top: 46%;
        left: 48%;
        background: radial-gradient(circle, rgba(129, 140, 248, 0.13), transparent 66%);
        animation: pulseOrb 5s ease-in-out infinite;
    }

    .form-card {
        position: relative;
        max-width: 1250px;
        margin: 0 auto;
        border: 1px solid rgba(129, 140, 248, 0.20);
        border-radius: 28px;
        overflow: hidden;
        background: rgba(8, 9, 18, 0.82);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255,255,255,0.025) inset, 0 0 55px rgba(67, 56, 202, 0.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        animation: cardReveal 0.75s cubic-bezier(.2,.75,.2,1) both;
    }

        .form-card::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            border-radius: inherit;
            background: linear-gradient(120deg, rgba(255,255,255,0.05), transparent 30%, transparent 70%, rgba(99,102,241,0.10));
        }

    .card-header {
        position: relative;
        overflow: hidden;
        padding: 28px clamp(20px, 4vw, 42px);
        color: var(--ui-white);
        background: radial-gradient(circle at 85% 10%, rgba(129, 140, 248, 0.28), transparent 28%), linear-gradient(135deg, #020204 0%, #0a0a14 48%, #171449 100%);
        border-bottom: 1px solid rgba(129, 140, 248, 0.16);
    }

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        color: #fff;
        font-size: 22px;
        background: linear-gradient(145deg, rgba(99,102,241,0.95), rgba(30,64,175,0.75));
        border: 1px solid rgba(255,255,255,0.16);
        box-shadow: 0 10px 30px rgba(79,70,229,0.34), 0 0 28px rgba(99,102,241,0.22) inset;
        animation: iconPulse 3.5s ease-in-out infinite;
    }

    .header-kicker {
        display: block;
        margin-bottom: 4px;
        color: #a5b4fc;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .card-header h3 {
        margin: 0;
        font-size: clamp(1.35rem, 2.2vw, 1.9rem);
        line-height: 1.2;
        font-weight: 900;
        letter-spacing: -0.02em;
    }

    .card-header p {
        margin: 5px 0 0;
        color: rgba(226,232,240,0.72);
        font-size: 0.9rem;
    }

    .header-glow {
        position: absolute;
        top: -120px;
        right: 12%;
        width: 340px;
        height: 220px;
        background: radial-gradient(circle, rgba(99,102,241,0.30), transparent 65%);
        filter: blur(10px);
        animation: headerGlow 6s ease-in-out infinite;
    }

    .header-scan {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        transform: skewX(-22deg);
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.09), transparent);
        animation: scan 6.5s ease-in-out infinite;
    }

    .card-body {
        position: relative;
        padding: clamp(20px, 3vw, 36px);
        color: #e5e7eb;
        background: radial-gradient(circle at 12% 20%, rgba(67,56,202,0.10), transparent 28%), linear-gradient(180deg, rgba(9,10,18,0.98), rgba(7,8,15,0.96));
    }

    .body-grid-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at 50% -20%, rgba(99,102,241,0.12), transparent 45%);
    }

    .card-body > form,
    .card-body > .alert,
    .card-body > div:not(.body-grid-glow) {
        position: relative;
        z-index: 2;
    }

    .card-body .row > [class*="col-"] {
        animation: fieldReveal 0.58s cubic-bezier(.2,.7,.2,1) both;
    }

        .card-body .row > [class*="col-"]:nth-child(1) {
            animation-delay: 0.04s;
        }

        .card-body .row > [class*="col-"]:nth-child(2) {
            animation-delay: 0.08s;
        }

        .card-body .row > [class*="col-"]:nth-child(3) {
            animation-delay: 0.12s;
        }

        .card-body .row > [class*="col-"]:nth-child(4) {
            animation-delay: 0.16s;
        }

        .card-body .row > [class*="col-"]:nth-child(5) {
            animation-delay: 0.20s;
        }

        .card-body .row > [class*="col-"]:nth-child(6) {
            animation-delay: 0.24s;
        }

        .card-body .row > [class*="col-"]:nth-child(7) {
            animation-delay: 0.28s;
        }

        .card-body .row > [class*="col-"]:nth-child(8) {
            animation-delay: 0.32s;
        }

        .card-body .row > [class*="col-"]:nth-child(9) {
            animation-delay: 0.36s;
        }

        .card-body .row > [class*="col-"]:nth-child(10) {
            animation-delay: 0.40s;
        }

        .card-body .row > [class*="col-"]:nth-child(11) {
            animation-delay: 0.44s;
        }

    .form-label {
        position: relative;
        display: block;
        margin-bottom: 8px;
        color: #e2e8f0;
        font-size: 0.90rem;
        font-weight: 700;
    }

        .form-label::after {
            content: "";
            display: block;
            width: 24px;
            height: 2px;
            margin-top: 5px;
            border-radius: 999px;
            background: linear-gradient(90deg, #6366f1, transparent);
            opacity: 0.9;
        }

    .required {
        color: #f472b6;
        margin-right: 4px;
        text-shadow: 0 0 8px rgba(244,114,182,0.45);
    }

    .form-control,
    .form-select {
        min-height: 46px;
        color: #f8fafc !important;
        background-color: rgba(15, 17, 29, 0.90) !important;
        border: 1px solid rgba(129, 140, 248, 0.20) !important;
        border-radius: 14px !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.18) inset, 0 4px 18px rgba(0,0,0,0.12);
        transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease, background-color .25s ease;
    }

        .form-control::placeholder {
            color: rgba(148, 163, 184, 0.48) !important;
        }

        .form-select option {
            color: #0f172a;
            background: #f8fafc;
        }

        .form-control:hover,
        .form-select:hover {
            border-color: rgba(129, 140, 248, 0.40) !important;
            transform: translateY(-1px);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(99,102,241,0.95) !important;
            background-color: rgba(17, 19, 34, 0.98) !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.13), 0 0 30px rgba(79,70,229,0.12), 0 8px 24px rgba(0,0,0,0.20) !important;
            transform: translateY(-2px);
            outline: none;
        }

    .readonly-field {
        min-height: 46px;
        display: flex;
        align-items: center;
        color: #e0e7ff !important;
        background: linear-gradient(135deg, rgba(30,41,59,0.90), rgba(49,46,129,0.24)) !important;
        border: 1px solid rgba(129,140,248,0.26) !important;
        border-radius: 14px !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.14);
    }

        .readonly-field i {
            color: #818cf8;
        }

    .text-muted {
        color: rgba(203,213,225,0.52) !important;
    }

    .validation-message,
    .text-danger {
        color: #fca5a5 !important;
        font-size: 0.82rem;
        margin-top: 6px;
    }

    .validation-errors {
        margin: 0 0 18px;
        padding: 14px 16px;
        border: 1px solid rgba(248,113,113,0.25);
        border-radius: 14px;
        background: rgba(127,29,29,0.16);
        color: #fecaca;
        box-shadow: 0 10px 30px rgba(0,0,0,0.12);
    }

    .file-upload-box {
        position: relative;
        overflow: hidden;
        padding: 18px;
        border: 1px dashed rgba(129,140,248,0.40);
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(30,41,59,0.42), rgba(49,46,129,0.14)), rgba(9,10,18,0.72);
        box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
    }

        .file-upload-box::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(110deg, transparent 30%, rgba(129,140,248,0.06), transparent 70%);
            transform: translateX(-100%);
            animation: uploadShimmer 5s ease-in-out infinite;
        }

        .file-upload-box:hover {
            border-color: rgba(129,140,248,0.75);
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(0,0,0,0.20), 0 0 30px rgba(67,56,202,0.10);
        }

        .file-upload-box input[type="file"] {
            position: relative;
            z-index: 2;
            width: 100%;
            color: #cbd5e1;
        }

            .file-upload-box input[type="file"]::file-selector-button {
                margin-left: 10px;
                padding: 9px 14px;
                border: 1px solid rgba(129,140,248,0.30);
                border-radius: 10px;
                color: #eef2ff;
                background: linear-gradient(135deg, #111827, #312e81);
                cursor: pointer;
                transition: .25s ease;
            }

                .file-upload-box input[type="file"]::file-selector-button:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 0 18px rgba(99,102,241,0.22);
                }

    .file-info {
        position: relative;
        z-index: 2;
        color: #c7d2fe;
        background: rgba(49,46,129,0.18);
        border: 1px solid rgba(129,140,248,0.18);
        border-radius: 12px;
        padding: 9px 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .file-info i {
            color: #818cf8;
        }

    .submit-btn {
        position: relative;
        overflow: hidden;
        min-width: 210px;
        padding: 13px 30px;
        border: 1px solid rgba(165,180,252,0.24);
        border-radius: 15px;
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.01em;
        background: linear-gradient(120deg, #111827 0%, #312e81 45%, #4338ca 100%);
        box-shadow: 0 12px 30px rgba(49,46,129,0.34), 0 0 0 1px rgba(255,255,255,0.04) inset;
        transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }

        .submit-btn::before {
            content: "";
            position: absolute;
            top: -30%;
            left: -60%;
            width: 48%;
            height: 160%;
            transform: rotate(18deg);
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.26), transparent);
            animation: buttonShine 4.5s ease-in-out infinite;
        }

        .submit-btn:hover {
            color: #fff;
            transform: translateY(-3px) scale(1.01);
            filter: brightness(1.08);
