@page "/AddFollowUpReport"

@using System.ComponentModel.DataAnnotations
@using REMS.Interfaces
@using REMS.Enititys
@using Microsoft.AspNetCore.Components.Forms

@inject IFollowUpReportService ReportService
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment env
@inject UserService UserRepo

@attribute [Authorize(Roles = "Manager,Admin,FUser")]

<div class="page-wrapper" dir="rtl">

    <div class="card form-card">

        <div class="card-header">

            <h3>
                <i class="fas fa-tasks"></i>
                إضافة مهمة جديدة
            </h3>

        </div>


        <div class="card-body">

            <EditForm Model="vm"
                      OnValidSubmit="HandleValidSubmit">

                <DataAnnotationsValidator />

                <ValidationSummary />


                <div class="row g-3">


                    <!-- ================================================= -->
                    <!-- اسم المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            اسم المهمة
                            <span class="required">*</span>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.Content"
                                   placeholder="مثال: تصميم حملة إعلانية" />

                        <ValidationMessage For="@(() => vm.Content)" />

                    </div>


                    <!-- ================================================= -->
                    <!-- تفاصيل المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            تفاصيل المهمة
                            <span class="required">*</span>
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.TaskDetails"
                                       placeholder="اكتب تفاصيل المهمة..." />

                        <ValidationMessage For="@(() => vm.TaskDetails)" />

                    </div>


                    <!-- ================================================= -->
                    <!-- نوع المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            نوع المهمة
                        </label>

                        <select class="form-select"
                                @bind="vm.TaskType">

                            <option value="">
                                -- اختر النوع --
                            </option>

                            <option value="تسويق">
                                تسويق
                            </option>

                            <option value="برمجة">
                                برمجة
                            </option>

                            <option value="تصميم">
                                تصميم
                            </option>

                            <option value="إدارة">
                                إدارة
                            </option>

                            <option value="أخرى">
                                أخرى
                            </option>

                        </select>

                    </div>


                    <!-- ================================================= -->
                    <!-- العميل / المشروع -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            العميل / المشروع
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.ClientOrProject"
                                   placeholder="اسم العميل أو المشروع" />

                    </div>


                    <!-- ================================================= -->
                    <!-- الموظف المسؤول -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الموظف المسؤول
                        </label>

                        <div class="form-control readonly-field">

                            @if (User != null &&
                                 !string.IsNullOrWhiteSpace(User.FullName))
                            {
                                <i class="fas fa-user me-2"></i>

                                @User.FullName
                            }
                            else
                            {
                                <span class="text-muted">
                                    جارٍ تحميل بيانات الموظف...
                                </span>
                            }

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- الأولوية -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الأولوية
                        </label>

                        <select class="form-select"
                                @bind="vm.Priority">

                            <option value="منخفضة">
                                منخفضة
                            </option>

                            <option value="متوسطة">
                                متوسطة
                            </option>

                            <option value="عالية">
                                عالية
                            </option>

                            <option value="عاجلة">
                                عاجلة
                            </option>

                        </select>

                    </div>


                    <!-- ================================================= -->
                    <!-- عدد البنود -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            عدد الأمور المتعلقة بالمهمة
                            <span class="required">*</span>
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.TotalItems" />

                        <ValidationMessage For="@(() => vm.TotalItems)" />

                    </div>


                    <!-- ================================================= -->
                    <!-- المدة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            المدة المتوقعة (يوم)
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.ExpectedDurationDays" />

                    </div>


                    <!-- ================================================= -->
                    <!-- تاريخ البدء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ البدء
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.StartDate" />

                    </div>


                    <!-- ================================================= -->
                    <!-- تاريخ التسليم -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ التسليم المتوقع
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.DueDate" />

                    </div>


                    <!-- ================================================= -->
                    <!-- المنجز عند الإنشاء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            ما تم إنجازه عند الإنشاء
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.CompletedItems" />

                    </div>


                    <!-- ================================================= -->
                    <!-- تفاصيل المنجز -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ما تم إنجازه
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.CompletedDetails"
                                       placeholder="اكتب فقط الأمور التي تم إنجازها..." />

                    </div>


                    <!-- ================================================= -->
                    <!-- رفع ملف -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ملف المهمة
                            <span class="text-muted">
                                (اختياري)
                            </span>
                        </label>

                        <div class="file-upload-box">

                            <InputFile OnChange="OnFileSelected" />

                            @if (!string.IsNullOrWhiteSpace(FileName))
                            {
                                <div class="file-info mt-2">

                                    <i class="fas fa-file me-2"></i>

                                    @FileName

                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(FileError))
                            {
                                <div class="text-danger small mt-2">

                                    @FileError

                                </div>
                            }

                        </div>

                    </div>


                </div>


                <!-- ===================================================== -->
                <!-- زر الإنشاء -->
                <!-- ===================================================== -->

                <div class="mt-4 text-center">

                    <button type="submit"
                            class="btn submit-btn"
                            disabled="@IsSaving">

                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>
                                جارٍ إنشاء المهمة...
                            </span>
                        }
                        else
                        {
                            <i class="fas fa-plus me-2"></i>

                            <span>
                                إنشاء المهمة
                            </span>
                        }

                    </button>

                </div>


            </EditForm>


            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">

                    <i class="fas fa-check-circle me-2"></i>

                    @successMessage

                </div>
            }


            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">

                    <i class="fas fa-exclamation-circle me-2"></i>

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>


<style>

    .page-wrapper {
        padding: 20px;
    }


    .form-card {
        border-radius: 12px;
        overflow: hidden;
        border: none;
        box-shadow: 0 8px 24px rgba(255,140,0,0.12);
    }


    .card-header {
        background: linear-gradient(135deg, #ff8a00, #ff5e00);
        color: white;
        padding: 18px 24px;
    }


        .card-header h3 {
            margin: 0;
            font-weight: 700;
        }


    .card-body {
        background: linear-gradient(180deg, #fff, #fffaf2);
        padding: 24px;
    }


    .form-label {
        font-weight: 600;
        color: #333;
        display: block;
        margin-bottom: 6px;
    }


    .required {
        color: #d9534f;
        margin-right: 4px;
    }


    .form-control,
    .form-select {
        border-radius: 6px;
    }


        .form-control:focus,
        .form-select:focus {
            border-color: #ff8a00;
            box-shadow: 0 0 0 0.2rem rgba(255,138,0,0.15);
        }


    .readonly-field {
        background: #f7f2ee;
        border: 1px solid #f0d9c2;
        color: #8a4b00;
        min-height: 38px;
        display: flex;
        align-items: center;
    }


    .submit-btn {
        background: linear-gradient(90deg,#ff8a00,#ff5e00);
        color: white;
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 700;
        min-width: 180px;
    }


        .submit-btn:hover {
            opacity: 0.95;
            color: white;
        }


        .submit-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }


    .file-upload-box {
        border: 1px dashed #ffb366;
        background: #fffaf6;
        border-radius: 8px;
        padding: 15px;
    }


    .file-info {
        color: #8a4b00;
        background: #fff1df;
        border-radius: 6px;
        padding: 8px 12px;
        display: inline-block;
    }


    .text-danger {
        color: #d9534f;
    }


    .alert {
        border-radius: 8px;
    }

</style>


@code {

    // =========================================================
    // ViewModel
    // =========================================================

    private FollowUpReportVm vm = new();


    private string? successMessage;

    private string? errorMessage;


    // =========================================================
    // المستخدم الحالي
    // =========================================================

    private User User { get; set; } = new();


    // =========================================================
    // الملف
    // =========================================================

    private IBrowserFile? SelectedFile;

    private string? FileName;

    private string? FileError;


    // =========================================================
    // حالة الحفظ
    // =========================================================

    private bool IsSaving = false;


    // =========================================================
    // تحميل المستخدم الحالي
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor.HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(
                        c => c.Type == "Id")
                    ?.Value;


            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(idClaim, out var uid))
            {
                var result =
                    await UserRepo.GetById(uid);


                if (result.IsSuccess)
                {
                    User = result.Value;
                }
            }
        }
        catch
        {
            errorMessage =
                "تعذر تحميل بيانات المستخدم الحالي.";
        }


        vm.StartDate = DateTime.Today;
    }


    // =========================================================
    // اختيار الملف
    // =========================================================

    private void OnFileSelected(
        InputFileChangeEventArgs e)
    {
        FileError = null;

        var file = e.File;

        if (file == null)
        {
            SelectedFile = null;
            FileName = null;
            return;
        }


        // الحد الأقصى 100 MB
        const long maxSize = 104_857_600;


        if (file.Size > maxSize)
        {
            SelectedFile = null;
            FileName = null;

            FileError =
                "حجم الملف كبير جداً. الحد الأقصى هو 100 MB.";

            return;
        }


        SelectedFile = file;

        FileName = file.Name;
    }


    // =========================================================
    // حفظ الملف
    // =========================================================

    private async Task<string?> SaveBrowserFileAsync(
        IBrowserFile file)
    {
        try
        {
            var webRoot =
                env.WebRootPath ??
                Path.Combine(
                    Directory.GetCurrentDirectory(),
                    "wwwroot");


            var uploadsFolder =
                Path.Combine(
                    webRoot,
                    "Files");


            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(
                    uploadsFolder);
            }


            var extension =
                Path.GetExtension(file.Name);


            var safeName =
                $"{DateTime.Now:yyyy-MM-dd_HH-mm-ss}_{Guid.NewGuid()}{extension}";


            var physicalPath =
                Path.Combine(
                    uploadsFolder,
                    safeName);


            await using var input =
                file.OpenReadStream(
                    maxAllowedSize: 104_857_600);


            await using var output =
                new FileStream(
                    physicalPath,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    81920,
                    useAsync: true);


            await input.CopyToAsync(output);


            return $"/Files/{safeName}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"File save error: {ex}");

            return null;
        }
    }


    // =========================================================
    // إنشاء المهمة
    // =========================================================

    private async Task HandleValidSubmit()
    {
        errorMessage = null;

        successMessage = null;


        // -----------------------------------------------------
        // التحقق من البنود
        // -----------------------------------------------------

        if (vm.TotalItems <= 0)
        {
            errorMessage =
                "يجب إدخال عدد البنود.";

            return;
        }


        if (vm.CompletedItems < 0 ||
            vm.CompletedItems > vm.TotalItems)
        {
            errorMessage =
                "عدد المنجز يجب أن يكون بين 0 والعدد الكلي.";

            return;
        }


        // -----------------------------------------------------
        // التأكد من وجود الموظف
        // -----------------------------------------------------

        if (User == null ||
            string.IsNullOrWhiteSpace(User.FullName))
        {
            errorMessage =
                "تعذر تحديد الموظف الحالي.";

            return;
        }


        IsSaving = true;


        try
        {
            // -------------------------------------------------
            // حالة المهمة
            // -------------------------------------------------

            bool done =
                vm.CompletedItems ==
                vm.TotalItems;


            string status =
                done
                    ? "مكتملة"
                    : vm.CompletedItems > 0
                        ? "قيد التنفيذ"
                        : "لم تبدأ";


            // -------------------------------------------------
            // حفظ الملف إن وجد
            // -------------------------------------------------

            string? filePath = null;


            if (SelectedFile != null)
            {
                filePath =
                    await SaveBrowserFileAsync(
                        SelectedFile);


                if (string.IsNullOrEmpty(filePath))
                {
                    errorMessage =
                        "حدث خطأ أثناء حفظ الملف.";

                    return;
                }
            }


            // -------------------------------------------------
            // إنشاء التقرير
            // -------------------------------------------------

            var report =
                new FollowUpReport
                {
                    Content =
                        vm.Content,

                    TaskDetails =
                        vm.TaskDetails,

                    TaskType =
                        vm.TaskType,

                    ClientOrProject =
                        vm.ClientOrProject,

                    // =========================================
                    // الموظف يؤخذ تلقائياً من المستخدم الحالي
                    // =========================================

                    AssignedEmployee =
                        User.FullName,

                    FullName =
                        User.FullName,

                    Priority =
                        vm.Priority,

                    TotalItems =
                        vm.TotalItems,

                    CompletedItems =
                        vm.CompletedItems,

                    CompletedDetails =
                        vm.CompletedDetails,

                    ExpectedDurationDays =
                        vm.ExpectedDurationDays,

                    StartDate =
                        vm.StartDate,

                    DueDate =
                        vm.DueDate,

                    IsDone =
                        done,

                    IsDoneOrNot =
                        status,

                    DateTime =
                        DateTime.Now,

                    LastUpdatedDate =
                        DateTime.Now,

                    LastUpdatedBy =
                        User.FullName
                };


            // -------------------------------------------------
            // ربط الملف بالتقرير
            // -------------------------------------------------

            if (!string.IsNullOrEmpty(filePath))
            {
                report.Path =
                    filePath;

                report.ContractFilePath =
                    filePath;

                report.ContractFileName =
                    FileName;
            }


            // -------------------------------------------------
            // الحفظ في قاعدة البيانات
            // -------------------------------------------------

            await ReportService.AddReport(report);


            successMessage =
                "تم إنشاء المهمة بنجاح.";


            // -------------------------------------------------
            // إعادة ضبط النموذج
            // -------------------------------------------------

            vm =
                new FollowUpReportVm
                {
                    StartDate =
                        DateTime.Today
                };


            SelectedFile = null;

            FileName = null;

            FileError = null;
        }
        catch (Exception ex)
        {
            errorMessage =
                "حدث خطأ أثناء إنشاء المهمة.";


            Console.Error.WriteLine(
                $"Add FollowUp Report Error: {ex}");
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =========================================================
    // ViewModel
    // =========================================================

    private class FollowUpReportVm
    {
        [Required(
            ErrorMessage = "اسم المهمة مطلوب")]
        public string Content { get; set; }
            = string.Empty;


        [Required(
            ErrorMessage = "تفاصيل المهمة مطلوبة")]
        public string TaskDetails { get; set; }
            = string.Empty;


        public string TaskType { get; set; }
            = "تسويق";


        public string ClientOrProject { get; set; }
            = string.Empty;


        public string Priority { get; set; }
            = "متوسطة";


        [Range(
            1,
            int.MaxValue,
            ErrorMessage = "يجب أن يكون العدد أكبر من صفر")]
        public int TotalItems { get; set; }


        [Range(
            0,
            int.MaxValue,
            ErrorMessage = "أدخل رقماً صحيحاً")]
        public int CompletedItems { get; set; }


        public string CompletedDetails { get; set; }
            = string.Empty;


        public decimal? ExpectedDurationDays { get; set; }


        public DateTime? StartDate { get; set; }


        public DateTime? DueDate { get; set; }
    }

}