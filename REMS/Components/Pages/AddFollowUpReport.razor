@page "/AddFollowUpReport"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using REMS.Data
@using REMS.Interfaces
@using REMS.Enititys

@inject IReportService ReportService
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment env
@inject UserService UserRepo
@inject AppDbContext Db

@attribute [Authorize(Roles = "Manager,Admin,Admin1,FUser")]

<div class="page-wrapper" dir="rtl">

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>

    <div class="card form-card">

        <div class="card-header">
            <div class="header-glow"></div>
            <div class="header-content">
                <div class="header-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <span class="header-kicker">TASK MANAGEMENT</span>
                    <h3>إضافة مهمة جديدة</h3>
                    <p>أنشئ المهمة وحدد تفاصيلها ومسؤوليتها بسهولة</p>
                </div>
            </div>
            <div class="header-scan"></div>
        </div>

        <div class="card-body">
            <div class="body-grid-glow"></div>

            <EditForm Model="vm"
                      OnValidSubmit="HandleValidSubmit">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="row g-3">

                    <!-- ================================================= -->
                    <!-- اسم المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            اسم المهمة
                            <span class="required">*</span>
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.Content"
                                   placeholder="مثال: تصميم حملة إعلانية" />

                        <ValidationMessage For="@(() => vm.Content)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تفاصيل المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            تفاصيل المهمة
                            <span class="required">*</span>
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.TaskDetails"
                                       placeholder="اكتب تفاصيل المهمة..." />

                        <ValidationMessage For="@(() => vm.TaskDetails)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- نوع المهمة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            نوع المهمة
                        </label>

                        <select class="form-select"
                                @bind="vm.TaskType">

                            <option value="">
                                -- اختر النوع --
                            </option>

                            <option value="تسويق">
                                تسويق
                            </option>

                            <option value="برمجة">
                                برمجة
                            </option>

                            <option value="تصميم">
                                تصميم
                            </option>

                            <option value="إدارة">
                                إدارة
                            </option>

                            <option value="أخرى">
                                أخرى
                            </option>

                        </select>

                    </div>

                    <!-- ================================================= -->
                    <!-- العميل / المشروع -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            العميل / المشروع
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="vm.ClientOrProject"
                                   placeholder="اسم العميل أو المشروع" />

                    </div>

                    <!-- ================================================= -->
                    <!-- الموظف المسؤول -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الموظف المسؤول
                            <span class="required">*</span>
                        </label>

                        @if (User.IsFollowUpAdmin)
                        {
                            <select class="form-select"
                                    @bind="SelectedEmployeeId">

                                <option value="">
                                    -- اختر موظف قسم المتابعة --
                                </option>

                                @foreach (var employee in FollowUpEmployees)
                                {
                                    <option value="@employee.Id">
                                        @employee.FullName
                                    </option>
                                }

                            </select>
                        }
                        else
                        {
                            <div class="form-control readonly-field">

                                <i class="fas fa-user me-2"></i>

                                @if (!string.IsNullOrWhiteSpace(
                                    User.FullName))
                                {
                                    @User.FullName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        جارٍ تحميل بيانات الموظف...
                                    </span>
                                }

                            </div>
                        }

                    </div>

                    <!-- ================================================= -->
                    <!-- الأولوية -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            الأولوية
                        </label>

                        <select class="form-select"
                                @bind="vm.Priority">

                            <option value="منخفضة">
                                منخفضة
                            </option>

                            <option value="متوسطة">
                                متوسطة
                            </option>

                            <option value="عالية">
                                عالية
                            </option>

                            <option value="عاجلة">
                                عاجلة
                            </option>

                        </select>

                    </div>

                    <!-- ================================================= -->
                    <!-- عدد البنود -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            عدد الأمور المتعلقة بالمهمة
                            <span class="required">*</span>
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.TotalItems" />

                        <ValidationMessage For="@(() => vm.TotalItems)" />

                    </div>

                    <!-- ================================================= -->
                    <!-- المدة -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-4">

                        <label class="form-label">
                            المدة المتوقعة (يوم)
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.ExpectedDurationDays"
                                     @bind-Value:after="CalculateDueDate" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تاريخ البدء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ البدء
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.StartDate"
                                   @bind-Value:after="CalculateDueDate" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تاريخ التسليم -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            تاريخ التسليم المتوقع
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="vm.DueDate" />

                    </div>

                    <!-- ================================================= -->
                    <!-- المنجز عند الإنشاء -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label class="form-label">
                            ما تم إنجازه عند الإنشاء
                        </label>

                        <InputNumber class="form-control"
                                     @bind-Value="vm.CompletedItems" />

                    </div>

                    <!-- ================================================= -->
                    <!-- تفاصيل المنجز -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ما تم إنجازه
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="vm.CompletedDetails"
                                       placeholder="اكتب فقط الأمور التي تم إنجازها..." />

                    </div>

                    <!-- ================================================= -->
                    <!-- رفع ملف -->
                    <!-- ================================================= -->

                    <div class="col-12">

                        <label class="form-label">
                            ملف المهمة
                            <span class="text-muted">
                                (اختياري)
                            </span>
                        </label>

                        <div class="file-upload-box">

                            <InputFile OnChange="OnFileSelected" />

                            @if (!string.IsNullOrWhiteSpace(FileName))
                            {
                                <div class="file-info mt-2">

                                    <i class="fas fa-file me-2"></i>

                                    @FileName

                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(FileError))
                            {
                                <div class="text-danger small mt-2">

                                    @FileError

                                </div>
                            }

                        </div>

                    </div>

                </div>

                <!-- ===================================================== -->
                <!-- زر الإنشاء -->
                <!-- ===================================================== -->

                <div class="mt-4 text-center">

                    <button type="submit"
                            class="btn submit-btn"
                            disabled="@IsSaving">

                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>
                                جارٍ إنشاء المهمة...
                            </span>
                        }
                        else
                        {
                            <i class="fas fa-plus me-2"></i>

                            <span>
                                إنشاء المهمة
                            </span>
                        }

                    </button>

                </div>

            </EditForm>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success mt-3">

                    <i class="fas fa-check-circle me-2"></i>

                    @successMessage

                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">

                    <i class="fas fa-exclamation-circle me-2"></i>

                    @errorMessage

                </div>
            }

        </div>

    </div>

</div>



@code {

    // =========================================================
    // ViewModel
    // =========================================================

    private FollowUpReportVm vm = new();

    private string? successMessage;

    private string? errorMessage;

    // =========================================================
    // المستخدم الحالي
    // =========================================================

    private User User { get; set; } = new();

    // =========================================================
    // موظفو قسم المتابعة
    // =========================================================

    private List<User> FollowUpEmployees { get; set; } = new();

    private int? SelectedEmployeeId;

    // =========================================================
    // الملف
    // =========================================================

    private IBrowserFile? SelectedFile;

    private string? FileName;

    private string? FileError;

    // =========================================================
    // حالة الحفظ
    // =========================================================

    private bool IsSaving = false;

    // =========================================================
    // تحميل البيانات
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor.HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(
                        c => c.Type == "Id")
                    ?.Value;

            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(
                    idClaim,
                    out var uid))
            {
                var result =
                    await UserRepo.GetById(uid);

                if (result.IsSuccess)
                {
                    User =
                        result.Value;
                }
            }

            vm.StartDate =
                DateTime.Today;

            // =====================================================
            // إذا كان مدير قسم المتابعة
            // تحميل موظفي القسم
            // =====================================================

            if (User.IsFollowUpAdmin)
            {
                FollowUpEmployees =
                    await Db
                        .Set<User>()
                        .AsNoTracking()
                        .Where(x =>
                            x.IsFUser)
                        .OrderBy(x =>
                            x.FullName)
                        .ToListAsync();

                // في حال كان المدير نفسه FUser
                // يمكن استبعاده من القائمة إذا أردت
                FollowUpEmployees =
                    FollowUpEmployees
                        .Where(x =>
                            x.Id != User.Id)
                        .ToList();
            }
        }
        catch
        {
            errorMessage =
                "تعذر تحميل بيانات المستخدم الحالي.";
        }
    }

    // =========================================================
    // اختيار الملف
    // =========================================================

    private void OnFileSelected(
        InputFileChangeEventArgs e)
    {
        FileError = null;

        var file =
            e.File;

        if (file == null)
        {
            SelectedFile = null;
            FileName = null;
            return;
        }

        const long maxSize =
            104_857_600;

        if (file.Size > maxSize)
        {
            SelectedFile = null;
            FileName = null;

            FileError =
                "حجم الملف كبير جداً. الحد الأقصى هو 100 MB.";

            return;
        }

        SelectedFile =
            file;

        FileName =
            file.Name;
    }

    private void CalculateDueDate()
    {
        if (vm.StartDate.HasValue && vm.ExpectedDurationDays is > 0)
            vm.DueDate = vm.StartDate.Value.AddDays(Math.Ceiling((double)vm.ExpectedDurationDays.Value) - 1);
    }

    // =========================================================
    // حفظ الملف
    // =========================================================

    private async Task<string?> SaveBrowserFileAsync(
        IBrowserFile file)
    {
        try
        {
            var webRoot =
                env.WebRootPath ??
                Path.Combine(
                    Directory.GetCurrentDirectory(),
                    "wwwroot");

            var uploadsFolder =
                Path.Combine(
                    webRoot,
                    "Files");

            if (!Directory.Exists(
                uploadsFolder))
            {
                Directory.CreateDirectory(
                    uploadsFolder);
            }

            var extension =
                Path.GetExtension(
                    file.Name);

            var safeName =
                $"{DateTime.Now:yyyy-MM-dd_HH-mm-ss}_{Guid.NewGuid()}{extension}";

            var physicalPath =
                Path.Combine(
                    uploadsFolder,
                    safeName);

            await using var input =
                file.OpenReadStream(
                    maxAllowedSize:
                        104_857_600);

            await using var output =
                new FileStream(
                    physicalPath,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    81920,
                    useAsync: true);

            await input.CopyToAsync(
                output);

            return
                $"/Files/{safeName}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"File save error: {ex}");

            return null;
        }
    }

    // =========================================================
    // إنشاء المهمة
    // =========================================================

    private async Task HandleValidSubmit()
    {
        errorMessage = null;

        successMessage = null;

        // =====================================================
        // التحقق من البنود
        // =====================================================

        if (vm.TotalItems <= 0)
        {
            errorMessage =
                "يجب إدخال عدد البنود.";

            return;
        }

        if (vm.CompletedItems < 0 ||
            vm.CompletedItems > vm.TotalItems)
        {
            errorMessage =
                "عدد المنجز يجب أن يكون بين 0 والعدد الكلي.";

            return;
        }

        if (vm.StartDate.HasValue && vm.DueDate.HasValue && vm.DueDate.Value.Date < vm.StartDate.Value.Date)
        {
            errorMessage = "تاريخ التسليم يجب أن يكون في تاريخ البدء أو بعده.";
            return;
        }

        // =====================================================
        // التحقق من المستخدم الحالي
        // =====================================================

        if (User == null ||
            string.IsNullOrWhiteSpace(
                User.FullName))
        {
            errorMessage =
                "تعذر تحديد المستخدم الحالي.";

            return;
        }

        // =====================================================
        // الموظف المسؤول
        // =====================================================

        User? assignedEmployee = null;

        if (User.IsFollowUpAdmin)
        {
            // المدير يجب أن يختار موظفاً
            if (!SelectedEmployeeId.HasValue)
            {
                errorMessage =
                    "يرجى اختيار الموظف المسؤول عن المهمة.";

                return;
            }

            assignedEmployee =
                await Db
                    .Set<User>()
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            SelectedEmployeeId.Value &&
                            x.IsFUser);

            if (assignedEmployee == null)
            {
                errorMessage =
                    "الموظف المحدد غير موجود أو ليس من قسم المتابعة.";

                return;
            }
        }
        else
        {
            // الموظف العادي تسند المهمة لنفسه
            assignedEmployee =
                User;
        }

        IsSaving = true;

        try
        {
            // =================================================
            // حالة المهمة
            // =================================================

            bool done =
                vm.CompletedItems >=
                vm.TotalItems;

            string status =
                done
                    ? "مكتملة"
                    : vm.CompletedItems > 0
                        ? "قيد التنفيذ"
                        : "لم تبدأ";

            // =================================================
            // حفظ الملف
            // =================================================

            string? filePath = null;

            if (SelectedFile != null)
            {
                filePath =
                    await SaveBrowserFileAsync(
                        SelectedFile);

                if (string.IsNullOrEmpty(
                        filePath))
                {
                    errorMessage =
                        "حدث خطأ أثناء حفظ الملف.";

                    return;
                }
            }

            // =================================================
            // إنشاء المهمة
            // =================================================

            var report = new FollowUpReport
            {
                // =========================================
                // بيانات المهمة
                // =========================================
                Content = vm.Content,
                TaskDetails = vm.TaskDetails,
                TaskType = vm.TaskType,
                ClientOrProject = vm.ClientOrProject,
                Priority = vm.Priority,

                // =========================================
                // المنشئ
                // الشخص الذي قام بإنشاء المهمة
                // =========================================
                FullName = User.FullName,

                // =========================================
                // الموظف المسؤول عن تنفيذ المهمة
                // =========================================
                AssignedEmployeeId = assignedEmployee.Id,
                AssignedEmployee = assignedEmployee.FullName,

                // =========================================
                // البنود والتقدم
                // =========================================
                TotalItems = vm.TotalItems,
                CompletedItems = vm.CompletedItems,
                CompletedDetails = vm.CompletedDetails,

                ExpectedDurationDays = vm.ExpectedDurationDays,

                StartDate = vm.StartDate,
                DueDate = vm.DueDate,

                // =========================================
                // الحالة
                // =========================================
                IsDone = done,
                IsDoneOrNot = status,

                // =========================================
                // معلومات الإنشاء والتحديث
                // =========================================
                DateTime = DateTime.Now,
                LastUpdatedDate = DateTime.Now,

                // مهم:
                // آخر شخص قام بالتحديث عند الإنشاء
                LastUpdatedBy = User.FullName
            };

            // =================================================
            // ربط الملف
            // =================================================

            if (!string.IsNullOrEmpty(
                    filePath))
            {
                report.Path =
                    filePath;

                report.ContractFilePath =
                    filePath;

                report.ContractFileName =
                    FileName;
            }

            // =================================================
            // الحفظ
            // =================================================

            await ReportService.AddFollowUpReport(
                report);

            // =================================================
            // إرسال البريد
            // =================================================

            await ReportService.SendTaskAssignmentEmail(
                report);

            successMessage =
                $"تم إنشاء المهمة وإسنادها إلى {assignedEmployee.FullName} وإرسال تفاصيلها بالبريد بنجاح.";

            // =================================================
            // Reset
            // =================================================

            vm =
                new FollowUpReportVm
                {
                    StartDate =
                        DateTime.Today
                };

            SelectedFile = null;

            FileName = null;

            FileError = null;

            if (User.IsFollowUpAdmin)
            {
                SelectedEmployeeId =
                    null;
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                "حدث خطأ أثناء إنشاء المهمة وإرسال البريد.";

            Console.Error.WriteLine(
                $"Add FollowUp Report Error: {ex}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    // =========================================================
    // ViewModel
    // =========================================================

    private class FollowUpReportVm
    {
        [Required(
            ErrorMessage =
                "اسم المهمة مطلوب")]
        public string Content { get; set; }
            = string.Empty;

        [Required(
            ErrorMessage =
                "تفاصيل المهمة مطلوبة")]
        public string TaskDetails { get; set; }
            = string.Empty;

        public string TaskType { get; set; }
            = "تسويق";

        public string ClientOrProject { get; set; }
            = string.Empty;

        public string Priority { get; set; }
            = "متوسطة";

        [Range(
            1,
            int.MaxValue,
            ErrorMessage =
                "يجب أن يكون العدد أكبر من صفر")]
        public int TotalItems { get; set; }

        [Range(
            0,
            int.MaxValue,
            ErrorMessage =
                "أدخل رقماً صحيحاً")]
        public int CompletedItems { get; set; }

        public string CompletedDetails { get; set; }
            = string.Empty;

        public decimal? ExpectedDurationDays { get; set; }

        public DateTime? StartDate { get; set; }

        public DateTime? DueDate { get; set; }
    }
}
