@code {

    // =========================================================
    // ViewModel
    // =========================================================

    private FollowUpReportVm vm = new();

    private string? successMessage;

    private string? errorMessage;

    // =========================================================
    // المستخدم الحالي
    // =========================================================

    private User User { get; set; } = new();

    // =========================================================
    // موظفو قسم المتابعة
    // =========================================================

    private List<User> FollowUpEmployees { get; set; } = new();

    private int? SelectedEmployeeId;

    // =========================================================
    // الملف
    // =========================================================

    private IBrowserFile? SelectedFile;

    private string? FileName;

    private string? FileError;

    // =========================================================
    // حالة الحفظ
    // =========================================================

    private bool IsSaving = false;

    // =========================================================
    // تحميل البيانات
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor.HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(
                        c => c.Type == "Id")
                    ?.Value;

            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(
                    idClaim,
                    out var uid))
            {
                var result =
                    await UserRepo.GetById(uid);

                if (result.IsSuccess)
                {
                    User =
                        result.Value;
                }
            }

            vm.StartDate =
                DateTime.Today;

            // =====================================================
            // إذا كان مدير قسم المتابعة
            // تحميل موظفي القسم
            // =====================================================

            if (User.IsFollowUpAdmin)
            {
                FollowUpEmployees =
                    await Db
                        .Set<User>()
                        .AsNoTracking()
                        .Where(x =>
                            x.IsFUser)
                        .OrderBy(x =>
                            x.FullName)
                        .ToListAsync();

                // في حال كان المدير نفسه FUser
                // يمكن استبعاده من القائمة إذا أردت
                FollowUpEmployees =
                    FollowUpEmployees
                        .Where(x =>
                            x.Id != User.Id)
                        .ToList();
            }
        }
        catch
        {
            errorMessage =
                "تعذر تحميل بيانات المستخدم الحالي.";
        }
    }

    // =========================================================
    // اختيار الملف
    // =========================================================

    private void OnFileSelected(
        InputFileChangeEventArgs e)
    {
        FileError = null;

        var file =
            e.File;

        if (file == null)
        {
            SelectedFile = null;
            FileName = null;
            return;
        }

        const long maxSize =
            104_857_600;

        if (file.Size > maxSize)
        {
            SelectedFile = null;
            FileName = null;

            FileError =
                "حجم الملف كبير جداً. الحد الأقصى هو 100 MB.";

            return;
        }

        SelectedFile =
            file;

        FileName =
            file.Name;
    }

    // =========================================================
    // حفظ الملف
    // =========================================================

    private async Task<string?> SaveBrowserFileAsync(
        IBrowserFile file)
    {
        try
        {
            var webRoot =
                env.WebRootPath ??
                Path.Combine(
                    Directory.GetCurrentDirectory(),
                    "wwwroot");

            var uploadsFolder =
                Path.Combine(
                    webRoot,
                    "Files");

            if (!Directory.Exists(
                uploadsFolder))
            {
                Directory.CreateDirectory(
                    uploadsFolder);
            }

            var extension =
                Path.GetExtension(
                    file.Name);

            var safeName =
                $"{DateTime.Now:yyyy-MM-dd_HH-mm-ss}_{Guid.NewGuid()}{extension}";

            var physicalPath =
                Path.Combine(
                    uploadsFolder,
                    safeName);

            await using var input =
                file.OpenReadStream(
                    maxAllowedSize:
                        104_857_600);

            await using var output =
                new FileStream(
                    physicalPath,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    81920,
                    useAsync: true);

            await input.CopyToAsync(
                output);

            return
                $"/Files/{safeName}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"File save error: {ex}");

            return null;
        }
    }

    // =========================================================
    // إنشاء المهمة
    // =========================================================

    private async Task HandleValidSubmit()
    {
        errorMessage = null;

        successMessage = null;

        // =====================================================
        // التحقق من البنود
        // =====================================================

        if (vm.TotalItems <= 0)
        {
            errorMessage =
                "يجب إدخال عدد البنود.";

            return;
        }

        if (vm.CompletedItems < 0 ||
            vm.CompletedItems > vm.TotalItems)
        {
            errorMessage =
                "عدد المنجز يجب أن يكون بين 0 والعدد الكلي.";

            return;
        }

        // =====================================================
        // التحقق من المستخدم الحالي
        // =====================================================

        if (User == null ||
            string.IsNullOrWhiteSpace(
                User.FullName))
        {
            errorMessage =
                "تعذر تحديد المستخدم الحالي.";

            return;
        }

        // =====================================================
        // الموظف المسؤول
        // =====================================================

        User? assignedEmployee = null;

        if (User.IsFollowUpAdmin)
        {
            // المدير يجب أن يختار موظفاً
            if (!SelectedEmployeeId.HasValue)
            {
                errorMessage =
                    "يرجى اختيار الموظف المسؤول عن المهمة.";

                return;
            }

            assignedEmployee =
                await Db
                    .Set<User>()
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        x =>
                            x.Id ==
                            SelectedEmployeeId.Value &&
                            x.IsFUser);

            if (assignedEmployee == null)
            {
                errorMessage =
                    "الموظف المحدد غير موجود أو ليس من قسم المتابعة.";

                return;
            }
        }
        else
        {
            // الموظف العادي تسند المهمة لنفسه
            assignedEmployee =
                User;
        }

        IsSaving = true;

        try
        {
            // =================================================
            // حالة المهمة
            // =================================================

            bool done =
                vm.CompletedItems >=
                vm.TotalItems;

            string status =
                done
                    ? "مكتملة"
                    : vm.CompletedItems > 0
                        ? "قيد التنفيذ"
                        : "لم تبدأ";

            // =================================================
            // حفظ الملف
            // =================================================

            string? filePath = null;

            if (SelectedFile != null)
            {
                filePath =
                    await SaveBrowserFileAsync(
                        SelectedFile);

                if (string.IsNullOrEmpty(
                        filePath))
                {
                    errorMessage =
                        "حدث خطأ أثناء حفظ الملف.";

                    return;
                }
            }

            // =================================================
            // إنشاء المهمة
            // =================================================

            var report = new FollowUpReport
            {
                // =========================================
                // بيانات المهمة
                // =========================================
                Content = vm.Content,
                TaskDetails = vm.TaskDetails,
                TaskType = vm.TaskType,
                ClientOrProject = vm.ClientOrProject,
                Priority = vm.Priority,

                // =========================================
                // المنشئ
                // الشخص الذي قام بإنشاء المهمة
                // =========================================
                FullName = User.FullName,

                // =========================================
                // الموظف المسؤول عن تنفيذ المهمة
                // =========================================
                AssignedEmployeeId = assignedEmployee.Id,
                AssignedEmployee = assignedEmployee.FullName,

                // =========================================
                // البنود والتقدم
                // =========================================
                TotalItems = vm.TotalItems,
                CompletedItems = vm.CompletedItems,
                CompletedDetails = vm.CompletedDetails,

                ExpectedDurationDays = vm.ExpectedDurationDays,

                StartDate = vm.StartDate,
                DueDate = vm.DueDate,

                // =========================================
                // الحالة
                // =========================================
                IsDone = done,
                IsDoneOrNot = status,

                // =========================================
                // معلومات الإنشاء والتحديث
                // =========================================
                DateTime = DateTime.Now,
                LastUpdatedDate = DateTime.Now,

                // مهم:
                // آخر شخص قام بالتحديث عند الإنشاء
                LastUpdatedBy = User.FullName
            };

            // =================================================
            // ربط الملف
            // =================================================

            if (!string.IsNullOrEmpty(
                    filePath))
            {
                report.Path =
                    filePath;

                report.ContractFilePath =
                    filePath;

                report.ContractFileName =
                    FileName;
            }

            // =================================================
            // الحفظ
            // =================================================

            await ReportService.AddFollowUpReport(
                report);

            // =================================================
            // إرسال البريد
            // =================================================

            await ReportService.SendTaskAssignmentEmail(
                report);

            successMessage =
                $"تم إنشاء المهمة وإسنادها إلى {assignedEmployee.FullName} وإرسال تفاصيلها بالبريد بنجاح.";

            // =================================================
            // Reset
            // =================================================

            vm =
                new FollowUpReportVm
                {
                    StartDate =
                        DateTime.Today
                };

            SelectedFile = null;

            FileName = null;

            FileError = null;

            if (User.IsFollowUpAdmin)
            {
                SelectedEmployeeId =
                    null;
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                "حدث خطأ أثناء إنشاء المهمة وإرسال البريد.";

            Console.Error.WriteLine(
                $"Add FollowUp Report Error: {ex}");
        }
        finally
        {
            IsSaving = false;
        }
    }

    // =========================================================
    // ViewModel
    // =========================================================

    private class FollowUpReportVm
    {
        [Required(
            ErrorMessage =
                "اسم المهمة مطلوب")]
        public string Content { get; set; }
            = string.Empty;

        [Required(
            ErrorMessage =
                "تفاصيل المهمة مطلوبة")]
        public string TaskDetails { get; set; }
            = string.Empty;

        public string TaskType { get; set; }
            = "تسويق";

        public string ClientOrProject { get; set; }
            = string.Empty;

        public string Priority { get; set; }
            = "متوسطة";

        [Range(
            1,
            int.MaxValue,
            ErrorMessage =
                "يجب أن يكون العدد أكبر من صفر")]
        public int TotalItems { get; set; }

        [Range(
            0,
            int.MaxValue,
            ErrorMessage =
                "أدخل رقماً صحيحاً")]
        public int CompletedItems { get; set; }

        public string CompletedDetails { get; set; }
            = string.Empty;

        public decimal? ExpectedDurationDays { get; set; }

        public DateTime? StartDate { get; set; }

        public DateTime? DueDate { get; set; }
    }
}