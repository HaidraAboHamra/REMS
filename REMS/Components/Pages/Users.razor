@page "/users-and-reports"

@using REMS.Enititys
@using System.Text.Json

@inject UserService UserRepo
@inject IFollowUpReportService _service
@inject ExcelService _excel
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<div class="employees-page" dir="rtl">

    <!-- Ambient -->
    <div class="employees-orb orb-one"></div>
    <div class="employees-orb orb-two"></div>
    <div class="employees-orb orb-three"></div>

    <div class="employees-grid"></div>
    <div class="employees-scan"></div>


    <main class="employees-content">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <section class="employees-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-left">

                <div class="header-icon">
                    👥
                </div>

                <div>

                    <span class="header-kicker">
                        HEX STUDIO • HEMS
                    </span>

                    <h1>
                        الموظفين والمهام
                    </h1>

                    <p>
                        إدارة الموظفين ومتابعة تقارير ومهام الفريق
                    </p>

                </div>

            </div>


            <div class="header-status">

                <span class="live-dot"></span>

                LIVE

            </div>

        </section>


        <!-- =====================================================
             MAIN GRID
             ===================================================== -->

        <div class="employees-layout">


            <!-- =================================================
                 USERS
                 ================================================= -->

            <aside class="users-column">

                <section class="users-card">

                    <div class="card-top-line"></div>


                    <!-- Header -->
                    <div class="users-card-header">

                        <div class="users-title-icon">
                            👤
                        </div>

                        <div>

                            <strong>
                                الموظفون
                            </strong>

                            <span>
                                اختر موظفًا لعرض تقاريره
                            </span>

                        </div>

                    </div>


                    <!-- Search -->
                    <div class="users-search">

                        <label>
                            البحث عن موظف
                        </label>

                        <div class="search-wrapper">

                            <span class="search-icon">
                                🔎
                            </span>

                            <input class="premium-input search-input"
                                   @bind="UserSearch"
                                   @bind:event="oninput"
                                   placeholder="اكتب اسم الموظف..." />

                        </div>

                    </div>


                    <div class="users-list-wrapper">

                        @if (!IsAdmin)
                        {
                            <div class="permission-alert">

                                <span class="permission-alert-icon">
                                    🔒
                                </span>

                                <div>

                                    <strong>
                                        وصول محدود
                                    </strong>

                                    <span>
                                        أنت مستخدم عادي، ترى فقط تقاريرك الخاصة.
                                    </span>

                                </div>

                            </div>
                        }
                        else if (Userss == null)
                        {
                            <div class="users-loading">

                                <div class="small-loader"></div>

                                <span>
                                    جارٍ التحميل...
                                </span>

                            </div>
                        }
                        else if (Userss.Count == 0)
                        {
                            <div class="empty-users">

                                <span>
                                    👤
                                </span>

                                <strong>
                                    لا يوجد موظفين
                                </strong>

                            </div>
                        }
                        else
                        {
                            <div class="users-list">

                                @foreach (var u in FilteredUsers)
                                {
                                    <button type="button"
                                            class="user-item @(SelectedUser?.Id == u.Id ? "selected" : "")"
                                            @onclick="@(() => SelectUser(u))">

                                        <div class="user-avatar">
                                            <span>👤</span>
                                        </div>

                                        <div class="user-info">

                                            <strong>
                                                @u.FullName
                                            </strong>

                                            <span>
                                                موظف
                                            </span>

                                        </div>

                                        <div class="user-count">

                                            <strong>
                                                @GetUserReportsCount(u)
                                            </strong>

                                            <span>
                                                تقرير
                                            </span>

                                        </div>

                                    </button>
                                }

                            </div>
                        }

                    </div>

                </section>

            </aside>


            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <section class="reports-column">


                <!-- =================================================
                     FILTERS
                     ================================================= -->

                <section class="filters-card">

                    <div class="card-top-line"></div>


                    <div class="filters-header">

                        <div class="filters-title">

                            <div class="filters-icon">
                                🎛️
                            </div>

                            <div>

                                <strong>
                                    مرشحات العرض
                                </strong>

                                <span>
                                    تحكم بالنتائج المعروضة
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="filters-grid">


                 


                        <!-- من -->
                        <div class="filter-field">

                            <label>
                                من تاريخ
                            </label>

                            <InputDate class="premium-input"
                                       @bind-Value="FromDate" />

                        </div>


                        <!-- إلى -->
                        <div class="filter-field">

                            <label>
                                إلى تاريخ
                            </label>

                            <InputDate class="premium-input"
                                       @bind-Value="ToDate" />

                        </div>


                        <!-- الحالة -->
                        <div class="filter-field">

                            <label>
                                الحالة
                            </label>

                            <select class="premium-select"
                                    @bind="SelectedStatus">

                                <option value="All">
                                    الكل
                                </option>

                                <option value="Done">
                                    المنتهية
                                </option>

                                <option value="NotDone">
                                    غير المنتهية
                                </option>

                            </select>

                        </div>


                        <!-- Apply -->
                        <div class="filter-action">

                            <button class="premium-primary-btn"
                                    @onclick="ApplyFilters">

                                <span>
                                    🔍
                                </span>

                                تطبيق

                            </button>

                        </div>


                        <!-- Reset -->
                        <div class="filter-action">

                            <button class="premium-secondary-btn"
                                    @onclick="ResetFilters">

                                <span>
                                    ↺
                                </span>

                                إعادة تعيين

                            </button>

                        </div>

                    </div>


                    <!-- =================================================
                         EXCEL
                         ================================================= -->
                    @if (IsAdmin)
                    {
                        <div class="excel-section">

                            <div class="excel-info">

                                <div class="excel-icon">
                                    📊
                                </div>

                                <div>

                                    <strong>
                                        تصدير التقارير
                                    </strong>

                                    <span>
                                        إنشاء ملف Excel للموظف المحدد
                                    </span>

                                </div>

                            </div>


                            <div class="excel-actions">

                                <button class="excel-btn"
                                        @onclick="ExportReportsToExcel"
                                        disabled="@(SelectedUser == null || isExporting)">

                                    @if (isExporting)
                                    {
                                        <span class="small-spinner"></span>

                                        <span>
                                            جار تحضير التقرير...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            📗
                                        </span>

                                        <span>
                                            تصدير Excel
                                        </span>
                                    }

                                </button>


                                @if (!string.IsNullOrEmpty(excelUrl))
                                {
                                    <a class="excel-download"
                                       href="@excelUrl"
                                       target="_blank">

                                        تحميل الملف
                                        ↓

                                    </a>
                                }


                                @if (!string.IsNullOrEmpty(exportMessage))
                                {
                                    <span class="export-message">
                                        @exportMessage
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </section>


                <!-- =================================================
                     REPORTS TABLE
                     ================================================= -->

                <section class="reports-card">

                    <div class="card-top-line"></div>


                    <div class="reports-header-row">

                        <div class="reports-title-block">

                            <div class="reports-title-icon">
                                📊
                            </div>

                            <div>

                                <strong>
                                    تقارير الموظف
                                </strong>

                                @if (SelectedUser != null)
                                {
                                    <span class="selected-user-name">
                                        @SelectedUser.FullName
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        لم يتم اختيار موظف
                                    </span>
                                }

                            </div>

                        </div>


                        @if (SelectedUser != null)
                        {
                            <div class="results-count">

                                <span>
                                    النتائج
                                </span>

                                <strong>
                                    @FilteredReports.Count()
                                </strong>

                            </div>
                        }

                    </div>


                    <div class="reports-body">

                        @if (SelectedUser == null)
                        {
                            <div class="empty-reports">

                                <div class="empty-reports-icon">
                                    👈
                                </div>

                                <strong>
                                    اختر موظفاً من القائمة
                                </strong>

                                <span>
                                    ستظهر تقاريره ومهامه هنا.
                                </span>

                            </div>
                        }
                        else if (IsLoadingReports)
                        {
                            <div class="reports-loading">

                                <div class="loader-ring">
                                    <div class="loader-core"></div>
                                </div>

                                <strong>
                                    جارٍ تحميل التقارير...
                                </strong>

                            </div>
                        }
                        else
                        {
                            <div class="table-wrapper">

                                <table class="reports-table">

                                    <thead>

                                        <tr>

                                            <th>المهمة</th>
                                            <th>النوع</th>
                                            <th>العميل / المشروع</th>
                                            <th>الموظف</th>
                                            <th>الأولوية</th>
                                            <th>التقدم</th>
                                            <th>المنجز</th>
                                            <th>المتبقي</th>
                                            <th>الحالة</th>
                                            <th>التسليم</th>
                                            <th>إجراء</th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var r in FilteredReports)
                                        {
                                            <tr class="report-row">

                                                <!-- المهمة -->
                                                <td>

                                                    <div class="task-cell">

                                                        <div class="task-icon">
                                                            📝
                                                        </div>

                                                        <div>

                                                            <strong>
                                                                @(r.Content ?? "-")
                                                            </strong>

                                                            @if (!string.IsNullOrWhiteSpace(r.TaskDetails))
                                                            {
                                                                <span>
                                                                    @r.TaskDetails
                                                                </span>
                                                            }

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- النوع -->
                                                <td>

                                                    <span class="type-pill">
                                                        @(r.TaskType ?? "-")
                                                    </span>

                                                </td>


                                                <!-- العميل -->
                                                <td>

                                                    <div class="project-cell">

                                                        <span class="project-dot"></span>

                                                        @(r.ClientOrProject ?? "-")

                                                    </div>

                                                </td>


                                                <!-- الموظف -->
                                                <td>

                                                    <div class="employee-cell">

                                                        <span class="employee-avatar">
                                                            👤
                                                        </span>

                                                        @(r.AssignedEmployee ?? r.FullName ?? "-")

                                                    </div>

                                                </td>


                                                <!-- الأولوية -->
                                                <td>

                                                    @if (r.Priority == "عالية")
                                                    {
                                                        <span class="priority-pill priority-high">
                                                            عالية
                                                        </span>
                                                    }
                                                    else if (r.Priority == "متوسطة")
                                                    {
                                                        <span class="priority-pill priority-medium">
                                                            متوسطة
                                                        </span>
                                                    }
                                                    else if (r.Priority == "منخفضة")
                                                    {
                                                        <span class="priority-pill priority-low">
                                                            منخفضة
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="type-pill">
                                                            @(r.Priority ?? "-")
                                                        </span>
                                                    }

                                                </td>


                                                <!-- التقدم -->
                                                <td style="min-width:180px">

                                                    <div class="progress-wrapper">

                                                        <div class="progress-meta">

                                                            <span>
                                                                التقدم
                                                            </span>

                                                            <strong>
                                                                @r.ProgressPercentage%
                                                            </strong>

                                                        </div>

                                                        <div class="premium-progress">

                                                            <div class="premium-progress-bar"
                                                                 style="width:@($"{r.ProgressPercentage}%")">

                                                                <span class="progress-shine"></span>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- المنجز -->
                                                <td>

                                                    <span class="counter completed">
                                                        @r.CompletedItems
                                                        /
                                                        @r.TotalItems
                                                    </span>

                                                </td>


                                                <!-- المتبقي -->
                                                <td>

                                                    <span class="counter remaining">
                                                        @r.RemainingItems
                                                    </span>

                                                </td>


                                                <!-- الحالة -->
                                                <td>

                                                    @if (r.IsDoneOrNot == "مكتملة")
                                                    {
                                                        <span class="status-pill status-completed">
                                                            <span class="status-dot"></span>
                                                            مكتملة
                                                        </span>
                                                    }
                                                    else if (r.IsDoneOrNot == "قيد التنفيذ")
                                                    {
                                                        <span class="status-pill status-progress">
                                                            <span class="status-dot"></span>
                                                            قيد التنفيذ
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-pill status-pending">
                                                            <span class="status-dot"></span>
                                                            لم تبدأ
                                                        </span>
                                                    }

                                                </td>


                                                <!-- التسليم -->
                                                <td>

                                                    <span class="date-cell">

                                                        📅

                                                        @(r.DueDate?.ToString("yyyy-MM-dd") ?? "-")

                                                    </span>

                                                </td>


                                                <!-- إجراء -->
                                                <td>

                                                    @if (CanEditReport(r))
                                                    {
                                                        <button class="edit-btn"
                                                                title="تحديث التقرير"
                                                                @onclick="@(() => EditReport(r.Id))">

                                                            ✏️
                                                            تحديث

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="not-allowed">
                                                            -
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                                @if (!FilteredReports.Any())
                                {
                                    <div class="no-results">

                                        <div>
                                            🔎
                                        </div>

                                        لا توجد نتائج مطابقة للمرشحات.

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </section>

            </section>

        </div>

    </main>

</div>


@code {

    // =============================================================
    // المستخدمون
    // =============================================================

    List<User> Userss = new();


    List<User> FilteredUsers =>
        string.IsNullOrWhiteSpace(UserSearch)
            ? Userss ?? new List<User>()
            : (Userss ?? new List<User>())
                .Where(u =>
                    (u.FullName ?? "")
                        .Contains(
                            UserSearch,
                            StringComparison.OrdinalIgnoreCase))
                .ToList();


    User SelectedUser;


    // =============================================================
    // التقارير
    // =============================================================

    List<FollowUpReport> AllReports = new();

    IEnumerable<FollowUpReport> FilteredReports =
        Enumerable.Empty<FollowUpReport>();


    // =============================================================
    // الفلاتر
    // =============================================================

    string UserSearch = string.Empty;

    string SelectedStoreType = string.Empty;

    DateTime? FromDate = null;

    DateTime? ToDate = null;

    string SelectedStatus = "All";

    List<string> StoreTypes = new();

    bool IsLoadingReports = false;


    // =============================================================
    // التصدير
    // =============================================================

    bool isExporting = false;

    string excelUrl = string.Empty;

    string exportMessage = string.Empty;


    // =============================================================
    // المستخدم الحالي
    // =============================================================

    private User User { get; set; } = new User();

    bool IsAdmin = false;

    string CurrentUserName = "user1";


    // =============================================================
    // تحميل الصفحة
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor
                    .HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(c => c.Type == "Id")
                    ?.Value;


            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(idClaim, out var uid))
            {
                var res =
                    await UserRepo.GetById(uid);


                if (res.IsSuccess)
                {
                    User = res.Value;

                    IsAdmin =
                        User.IsFollowUpAdmin;

                    CurrentUserName =
                        User.FullName;
                }
            }
        }
        catch
        {
        }


        await LoadUsersAsync();


        await LoadReportsForDate(
            DateTime.Now.Date);


        BuildStoreTypes();


        if (!IsAdmin)
        {
            Userss =
                Userss
                    .Where(u => u.Id == User.Id)
                    .ToList();


            SelectedUser = User;


            await RefreshFilteredReportsAsync();
        }
    }


    private async Task LoadUsersAsync()
    {
        try
        {
            var result =
                await UserRepo.GetAll();


            Userss =
                result.Value ??
                new List<User>();
        }
        catch
        {
            Userss = new();
        }
    }


    private async Task LoadReportsForDate(DateTime date)
    {
        try
        {
            var result =
                await _service.GetReportsByDate(date);

            if (IsAdmin)
            {
                AllReports =
                    result?.ToList()
                    ?? new List<FollowUpReport>();
            }
            else
            {
                AllReports =
                    result?
                        .Where(r =>
                            r.AssignedEmployeeId == User.Id)
                        .ToList()
                    ?? new List<FollowUpReport>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Load reports error: {ex}");

            AllReports =
                new List<FollowUpReport>();
        }
    }

    private async Task<List<FollowUpReport>>
        FetchReportsForDateRange(
            DateTime from,
            DateTime to)
    {
        var combined =
            new List<FollowUpReport>();


        for (
            var d = from.Date;
            d <= to.Date;
            d = d.AddDays(1))
        {
            var r =
                await _service.GetReportsByDate(d);


            if (r != null)
            {
                combined.AddRange(r);
            }
        }


        return combined;
    }


    private void BuildStoreTypes()
    {
        StoreTypes =
            AllReports
                .Where(r =>
                    !string.IsNullOrWhiteSpace(r.StoreType))
                .Select(r =>
                    r.StoreType!.Trim())
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();
    }


    private async Task SelectUser(User u)
    {
        SelectedUser = u;

        await RefreshFilteredReportsAsync();
    }


    private int GetUserReportsCount(User u)
    {
        return AllReports.Count(r =>
            r.AssignedEmployeeId == u.Id);
    }


    private async Task ApplyFilters()
    {
        try
        {
            IsLoadingReports = true;

            // ===========================================
            // في حال وجود فترة
            // ===========================================

            if (FromDate.HasValue &&
                ToDate.HasValue)
            {
                var reports =
                    await FetchReportsForDateRange(
                        FromDate.Value,
                        ToDate.Value);

                if (IsAdmin)
                {
                    AllReports =
                        reports;
                }
                else
                {
                    AllReports =
                        reports
                            .Where(r =>
                                r.AssignedEmployeeId == User.Id)
                            .ToList();
                }
            }
            else
            {
                // =======================================
                // اليوم الحالي
                // =======================================

                await LoadReportsForDate(
                    DateTime.Now.Date);
            }

            BuildStoreTypes();

            await RefreshFilteredReportsAsync();
        }
        finally
        {
            IsLoadingReports = false;
        }
    }


    private async Task RefreshFilteredReportsAsync()
    {
        if (SelectedUser == null)
        {
            FilteredReports =
                Enumerable.Empty<FollowUpReport>();

            return;
        }

        IsLoadingReports = true;

        try
        {
            IEnumerable<FollowUpReport> userReports =
                AllReports.Where(r =>
                    r.AssignedEmployeeId == SelectedUser.Id);


            // ===========================================
            // نوع المتجر
            // ===========================================

            if (!string.IsNullOrWhiteSpace(
                SelectedStoreType))
            {
                userReports =
                    userReports.Where(r =>
                        string.Equals(
                            r.StoreType?.Trim(),
                            SelectedStoreType.Trim(),
                            StringComparison.OrdinalIgnoreCase));
            }


            // ===========================================
            // الحالة
            // ===========================================

            if (SelectedStatus == "Done")
            {
                userReports =
                    userReports.Where(r =>
                        r.IsDone);
            }
            else if (SelectedStatus == "NotDone")
            {
                userReports =
                    userReports.Where(r =>
                        !r.IsDone);
            }


            FilteredReports =
                userReports
                    .OrderByDescending(
                        r => r.DateTime)
                    .ToList();
        }
        finally
        {
            IsLoadingReports = false;
        }
    }


    private void ResetFilters()
    {
        SelectedStoreType =
            string.Empty;

        FromDate = null;

        ToDate = null;

        SelectedStatus =
            "All";


        _ = RefreshFilteredReportsAsync();
    }


    private bool CanEditReport(FollowUpReport r)
    {
        return
            IsAdmin ||
            r.AssignedEmployeeId == User.Id;
    }


    private void EditReport(int reportId)
    {
        var report =
            AllReports.FirstOrDefault(
                r => r.Id == reportId);

        if (report == null)
            return;

        if (!CanEditReport(report))
            return;

        NavigationManager.NavigateTo(
            $"/followup-report/{reportId}");
    }


    private async Task ToggleDone(
        FollowUpReport report,
        object? value)
    {
        if (!CanEditReport(report))
        {
            return;
        }


        report.IsDone =
            Convert.ToBoolean(value);


        await _service.Update(report);
    }


    private async Task ExportReportsToExcel()
    {
        if (SelectedUser == null)
            return;

        var reports =
            FilteredReports.ToList();

        if (!reports.Any())
            return;

        isExporting = true;
        exportMessage = string.Empty;
        excelUrl = string.Empty;

        try
        {
            excelUrl =
                await _excel.GenerateFollowUpReportExcelAsync(
                    reports,
                    DateTime.Now);

            exportMessage =
                $"تم إنشاء ملف Excel للمستخدم {SelectedUser.FullName}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Excel export error: {ex}");

            exportMessage =
                "حدث خطأ أثناء إنشاء ملف Excel.";
        }
        finally
        {
            isExporting = false;
        }
    }


    string DisplayPath(string? v)
    {
        if (string.IsNullOrEmpty(v))
        {
            return string.Empty;
        }


        var n =
            v.Replace("\\", "/");


        return
            n.StartsWith("/")
                ? n
                : "/" + n;
    }

}


<style>

    /* =========================================================
           HEMS USERS & REPORTS
           ========================================================= */

    .employees-page {
        position: relative;
        min-height: 100vh;
        padding: clamp(14px,2.5vw,30px);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient( circle at 82% 8%, rgba(67,56,202,.23), transparent 26% ), radial-gradient( circle at 15% 90%, rgba(29,78,216,.16), transparent 25% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        color: #f8fafc;
    }


        .employees-page::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background: radial-gradient( circle at center, transparent 0%, rgba(2,2,8,.18) 48%, rgba(2,2,8,.60) 100% );
        }


    /* =========================================================
           GRID
           ========================================================= */

    .employees-grid {
        position: absolute;
        inset: 0;
        z-index: -3;
        pointer-events: none;
        background: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
        background-size: 42px 42px;
        mask-image: linear-gradient( to bottom, black, transparent 92% );
        animation: gridMove 22s linear infinite;
    }


    /* =========================================================
           AMBIENT
           ========================================================= */

    .employees-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(8px);
        mix-blend-mode: screen;
        pointer-events: none;
        z-index: -1;
    }


    .orb-one {
        width: 340px;
        height: 340px;
        top: -110px;
        right: -80px;
        background: radial-gradient( circle, rgba(99,102,241,.34), transparent 68% );
        animation: orbOne 11s ease-in-out infinite;
    }


    .orb-two {
        width: 410px;
        height: 410px;
        bottom: -160px;
        left: -140px;
        background: radial-gradient( circle, rgba(37,99,235,.23), transparent 68% );
        animation: orbTwo 14s ease-in-out infinite;
    }


    .orb-three {
        width: 220px;
        height: 220px;
        top: 44%;
        left: 48%;
        background: radial-gradient( circle, rgba(129,140,248,.12), transparent 66% );
        animation: orbThree 6s ease-in-out infinite;
    }


    .employees-scan {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        transform: skewX(-22deg);
        z-index: -1;
        pointer-events: none;
        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.055), transparent );
        animation: scan 8s ease-in-out infinite;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .employees-content {
        position: relative;
        width: min( 1550px, 100% );
        margin: 0 auto;
        z-index: 2;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .employees-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 145px;
        margin-bottom: 20px;
        padding: 28px clamp(20px,4vw,40px);
        border: 1px solid rgba(129,140,248,.20);
        border-radius: 26px;
        background: radial-gradient( circle at 85% 10%, rgba(129,140,248,.28), transparent 28% ), linear-gradient( 135deg, #020204 0%, #0a0a14 48%, #171449 100% );
        box-shadow: 0 24px 70px rgba(0,0,0,.48), 0 0 0 1px rgba(255,255,255,.025) inset, 0 0 50px rgba(67,56,202,.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        animation: cardReveal .75s cubic-bezier(.2,.75,.2,1) both;
    }


    .header-left {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 17px;
    }


    .header-icon {
        width: 62px;
        height: 62px;
        flex: 0 0 62px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(99,102,241,.95), rgba(30,64,175,.76) );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 28px rgba(99,102,241,.22) inset;
        font-size: 1.55rem;
        animation: iconPulse 3.5s ease-in-out infinite;
    }


    .header-kicker {
        display: block;
        margin-bottom: 5px;
        color: #a5b4fc;
        font-family: "Space Grotesk", sans-serif;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .23em;
        text-transform: uppercase;
    }


    .employees-header h1 {
        margin: 0;
        font-family: "Unbounded", "Space Grotesk", sans-serif;
        font-size: clamp( 1.3rem, 2.5vw, 2rem );
        font-weight: 500;
    }


    .employees-header p {
        margin: 6px 0 0;
        color: rgba(226,232,240,.68);
        font-size: .84rem;
    }


    .header-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        color: #c7d2fe;
        background: rgba(49,46,129,.18);
        border: 1px solid rgba(129,140,248,.20);
        font-family: "JetBrains Mono", monospace;
        font-size: .67rem;
        letter-spacing: .08em;
    }


    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 12px rgba(56,189,248,.85);
        animation: livePulse 1.8s ease-in-out infinite;
    }


    /* =========================================================
           LAYOUT
           ========================================================= */

    .employees-layout {
        display: grid;
        grid-template-columns: minmax(250px,330px) minmax(0,1fr);
        gap: 20px;
        align-items: start;
    }


    /* =========================================================
           CARDS
           ========================================================= */

    .users-card,
    .filters-card,
    .reports-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(129,140,248,.18);
        border-radius: 23px;
        background: rgba(8,9,18,.84);
        box-shadow: 0 24px 70px rgba(0,0,0,.42), 0 0 0 1px rgba(255,255,255,.02) inset;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }


    .users-card {
        animation: cardReveal .8s .08s cubic-bezier(.2,.75,.2,1) both;
    }


    .filters-card {
        margin-bottom: 20px;
        animation: cardReveal .8s .14s cubic-bezier(.2,.75,.2,1) both;
    }


    .reports-card {
        animation: cardReveal .8s .20s cubic-bezier(.2,.75,.2,1) both;
    }


    .card-top-line {
        position: absolute;
        top: 0;
        left: 4%;
        width: 92%;
        height: 1px;
        background: linear-gradient( 90deg, transparent, rgba(129,140,248,.48), rgba(56,189,248,.40), transparent );
    }


    /* =========================================================
           USERS
           ========================================================= */

    .users-card-header {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 21px;
        border-bottom: 1px solid rgba(129,140,248,.09);
    }


    .users-title-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(129,140,248,.13);
    }


    .users-card-header strong {
        display: block;
        font-size: .87rem;
        color: #f8fafc;
    }


    .users-card-header span {
        display: block;
        margin-top: 3px;
        color: rgba(165,180,252,.48);
        font-size: .63rem;
    }


    .users-search {
        padding: 18px 17px 10px;
    }


        .users-search label {
            display: block;
            margin-bottom: 7px;
            color: #cbd5e1;
            font-size: .70rem;
            font-weight: 800;
        }


    .search-wrapper {
        position: relative;
    }


    .search-icon {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        font-size: .85rem;
    }


    .search-input {
        padding-right: 38px !important;
    }


    .users-list-wrapper {
        max-height: 62vh;
        overflow: auto;
        padding: 6px 12px 15px;
        scrollbar-width: thin;
    }


        .users-list-wrapper::-webkit-scrollbar {
            width: 6px;
        }


        .users-list-wrapper::-webkit-scrollbar-thumb {
            background: linear-gradient( 180deg, #312e81, #4338ca );
            border-radius: 999px;
        }


    .users-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }


    .user-item {
        position: relative;
        overflow: hidden;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px;
        border: 1px solid rgba(129,140,248,.08);
        border-radius: 14px;
        color: #cbd5e1;
        background: rgba(15,17,29,.52);
        text-align: right;
        cursor: pointer;
        transition: .28s ease;
    }


        .user-item:hover {
            transform: translateX(-3px);
            border-color: rgba(129,140,248,.23);
            background: linear-gradient( 135deg, rgba(30,41,59,.70), rgba(49,46,129,.20) );
            box-shadow: 0 8px 22px rgba(0,0,0,.18);
        }


        .user-item.selected {
            border-color: rgba(129,140,248,.35);
            background: linear-gradient( 135deg, rgba(49,46,129,.62), rgba(29,78,216,.22) );
            box-shadow: 0 12px 28px rgba(49,46,129,.20), 0 0 26px rgba(99,102,241,.08);
        }


            .user-item.selected::after {
                content: "";
                position: absolute;
                right: 0;
                top: 12%;
                height: 76%;
                width: 3px;
                border-radius: 999px;
                background: linear-gradient( 180deg, #818cf8, #4338ca, #38bdf8 );
                box-shadow: 0 0 12px rgba(99,102,241,.70);
            }


    .user-avatar {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: linear-gradient( 145deg, rgba(99,102,241,.30), rgba(30,64,175,.18) );
        border: 1px solid rgba(129,140,248,.14);
    }


    .user-info {
        flex: 1;
        min-width: 0;
    }


        .user-info strong {
            display: block;
            color: #f8fafc;
            font-size: .76rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


        .user-info span {
            display: block;
            margin-top: 2px;
            color: rgba(165,180,252,.42);
            font-size: .60rem;
        }


    .user-count {
        min-width: 42px;
        text-align: center;
    }


        .user-count strong {
            display: block;
            color: #a5b4fc;
            font-family: "JetBrains Mono", monospace;
            font-size: .78rem;
        }


        .user-count span {
            display: block;
            color: rgba(165,180,252,.35);
            font-size: .52rem;
        }


    /* =========================================================
           ALERT / STATES
           ========================================================= */

    .permission-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 8px;
        padding: 13px;
        border: 1px solid rgba(250,204,21,.14);
        border-radius: 13px;
        background: rgba(146,64,14,.10);
    }


    .permission-alert-icon {
        font-size: 1rem;
    }


    .permission-alert strong {
        display: block;
        color: #fde68a;
        font-size: .70rem;
    }


    .permission-alert span:last-child {
        display: block;
        margin-top: 3px;
        color: rgba(253,230,138,.50);
        font-size: .58rem;
        line-height: 1.6;
    }


    .users-loading,
    .empty-users {
        min-height: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 9px;
        color: rgba(203,213,225,.45);
        font-size: .72rem;
    }


        .empty-users span {
            font-size: 1.6rem;
        }


    .small-loader {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid rgba(129,140,248,.10);
        border-top-color: #6366f1;
        animation: spin .8s linear infinite;
    }


    /* =========================================================
           FILTERS
           ========================================================= */

    .filters-header {
        padding: 21px;
        border-bottom: 1px solid rgba(129,140,248,.09);
    }


    .filters-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .filters-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(99,102,241,.11);
        border: 1px solid rgba(129,140,248,.13);
    }


    .filters-title strong {
        display: block;
        color: #f8fafc;
        font-size: .86rem;
    }


    .filters-title span {
        display: block;
        margin-top: 3px;
        color: rgba(165,180,252,.46);
        font-size: .62rem;
    }


    .filters-grid {
        display: grid;
        grid-template-columns: repeat( 6, minmax(0,1fr) );
        gap: 12px;
        padding: 20px;
    }


    .filter-field {
        min-width: 0;
    }


        .filter-field label {
            display: block;
            margin-bottom: 7px;
            color: #cbd5e1;
            font-size: .68rem;
            font-weight: 800;
        }


    .premium-input,
    .premium-select {
        width: 100%;
        min-height: 44px;
        padding: 8px 11px;
        color: #f8fafc;
        background: rgba(15,17,29,.90);
        border: 1px solid rgba(129,140,248,.18);
        border-radius: 12px;
        outline: none;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        transition: .25s ease;
    }


        .premium-input::placeholder {
            color: rgba(148,163,184,.42);
        }


        .premium-input:focus,
        .premium-select:focus {
            border-color: rgba(99,102,241,.85);
            box-shadow: 0 0 0 3px rgba(99,102,241,.11), 0 0 24px rgba(79,70,229,.10);
        }


        .premium-select option {
            color: #0f172a;
            background: #f8fafc;
        }


    .filter-action {
        display: flex;
        align-items: flex-end;
    }


    .premium-primary-btn,
    .premium-secondary-btn {
        width: 100%;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 12px;
        font-size: .70rem;
        font-weight: 800;
        cursor: pointer;
        transition: .25s ease;
    }


    .premium-primary-btn {
        color: white;
        border: 1px solid rgba(165,180,252,.20);
        background: linear-gradient( 120deg, #111827, #312e81, #4338ca );
        box-shadow: 0 9px 22px rgba(49,46,129,.26);
    }


        .premium-primary-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 14px 28px rgba(49,46,129,.36);
        }


    .premium-secondary-btn {
        color: #c7d2fe;
        border: 1px solid rgba(129,140,248,.18);
        background: rgba(30,41,59,.40);
    }


        .premium-secondary-btn:hover {
            color: white;
            transform: translateY(-2px);
            border-color: rgba(129,140,248,.30);
            background: rgba(49,46,129,.22);
        }


    /* =========================================================
           EXCEL
           ========================================================= */

    .excel-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 0 20px 20px;
        padding: 14px;
        border: 1px solid rgba(74,222,128,.12);
        border-radius: 15px;
        background: linear-gradient( 135deg, rgba(22,101,52,.10), rgba(49,46,129,.07) );
    }


    .excel-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .excel-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(74,222,128,.14);
    }


    .excel-info strong {
        display: block;
        color: #bbf7d0;
        font-size: .72rem;
    }


    .excel-info span {
        display: block;
        margin-top: 2px;
        color: rgba(187,247,208,.48);
        font-size: .58rem;
    }


    .excel-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }


    .excel-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 40px;
        padding: 8px 13px;
        border: 1px solid rgba(74,222,128,.18);
        border-radius: 10px;
        color: #dcfce7;
        background: rgba(22,101,52,.16);
        font-size: .65rem;
        font-weight: 800;
        cursor: pointer;
        transition: .25s ease;
    }


        .excel-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 22px rgba(34,197,94,.10);
        }


        .excel-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }


    .excel-download {
        color: #a5b4fc;
        text-decoration: none;
        font-size: .63rem;
        font-weight: 700;
    }


        .excel-download:hover {
            color: #c7d2fe;
        }


    .export-message {
        color: rgba(187,247,208,.50);
        font-size: .58rem;
    }


    .small-spinner {
        width: 13px;
        height: 13px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,.15);
        border-top-color: #86efac;
        animation: spin .7s linear infinite;
    }


    /* =========================================================
           REPORT HEADER
           ========================================================= */

    .reports-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 21px;
        border-bottom: 1px solid rgba(129,140,248,.09);
    }


    .reports-title-block {
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .reports-title-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(99,102,241,.11);
        border: 1px solid rgba(129,140,248,.13);
    }


    .reports-title-block strong {
        display: block;
        color: #f8fafc;
        font-size: .85rem;
    }


    .reports-title-block > div > span {
        display: block;
        margin-top: 3px;
        color: rgba(165,180,252,.45);
        font-size: .63rem;
    }


    .selected-user-name {
        color: #c7d2fe !important;
    }


    .results-count {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border: 1px solid rgba(129,140,248,.14);
        border-radius: 10px;
        background: rgba(49,46,129,.10);
        font-size: .60rem;
    }


        .results-count span {
            color: rgba(165,180,252,.45);
        }


        .results-count strong {
            color: #a5b4fc;
            font-family: "JetBrains Mono", monospace;
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .reports-body {
        padding: 12px;
    }


    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: thin;
    }


        .table-wrapper::-webkit-scrollbar {
            height: 8px;
        }


        .table-wrapper::-webkit-scrollbar-thumb {
            background: linear-gradient( 90deg, #312e81, #4338ca, #1d4ed8 );
            border-radius: 999px;
        }


    .reports-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: separate;
        border-spacing: 0 7px;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        color: #e5e7eb;
    }


        .reports-table thead th {
            padding: 13px 12px;
            color: #a5b4fc;
            font-size: .68rem;
            font-weight: 800;
            white-space: nowrap;
            text-align: right;
            border-bottom: 1px solid rgba(129,140,248,.08);
        }


    .report-row td {
        padding: 13px 12px;
        background: rgba(15,17,29,.72);
        border-top: 1px solid rgba(129,140,248,.06);
        border-bottom: 1px solid rgba(129,140,248,.06);
        vertical-align: middle;
        transition: .25s ease;
    }


        .report-row td:first-child {
            border-radius: 0 13px 13px 0;
        }


        .report-row td:last-child {
            border-radius: 13px 0 0 13px;
        }


    .report-row:hover td {
        background: linear-gradient( 135deg, rgba(30,41,59,.82), rgba(49,46,129,.20) );
        border-color: rgba(129,140,248,.12);
        box-shadow: 0 7px 22px rgba(0,0,0,.14);
    }


    /* =========================================================
           TABLE CELLS
           ========================================================= */

    .task-cell {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 220px;
    }


    .task-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: rgba(99,102,241,.10);
        border: 1px solid rgba(129,140,248,.12);
        font-size: .88rem;
    }


    .task-cell strong {
        display: block;
        color: #f8fafc;
        font-size: .75rem;
    }


    .task-cell span {
        display: block;
        max-width: 220px;
        margin-top: 3px;
        color: rgba(203,213,225,.44);
        font-size: .61rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    .type-pill,
    .priority-pill,
    .counter {
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .62rem;
        font-weight: 750;
        white-space: nowrap;
    }


    .type-pill {
        color: #c7d2fe;
        background: rgba(99,102,241,.10);
        border: 1px solid rgba(129,140,248,.12);
    }


    .project-cell {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        color: #cbd5e1;
        font-size: .68rem;
    }


    .project-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6366f1;
        box-shadow: 0 0 9px rgba(99,102,241,.65);
    }


    .employee-cell {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        font-size: .67rem;
    }


    .employee-avatar {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
