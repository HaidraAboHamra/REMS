@page "/users-and-reports"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager,Admin,Admin1")]
@using Microsoft.EntityFrameworkCore
@using REMS.Data

@using REMS.Enititys
@using System.Text.Json

@inject UserService UserRepo
@inject IFollowUpReportService _service
@inject ExcelService _excel
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject AppDbContext Db

<div class="employees-page" dir="rtl">

    <!-- Ambient -->
    <div class="employees-orb orb-one"></div>
    <div class="employees-orb orb-two"></div>
    <div class="employees-orb orb-three"></div>

    <div class="employees-grid"></div>
    <div class="employees-scan"></div>


    <main class="employees-content">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <section class="employees-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-left">

                <div class="header-icon">
                    👥
                </div>

                <div>

                    <span class="header-kicker">
                        HEX STUDIO • HEMS
                    </span>

                    <h1>
                        الموظفين والمهام
                    </h1>

                    <p>
                        إدارة الموظفين ومتابعة تقارير ومهام الفريق
                    </p>

                </div>

            </div>


            <div class="header-status">

                <span class="live-dot"></span>

                LIVE

            </div>

        </section>


        <!-- =====================================================
             MAIN GRID
             ===================================================== -->

        <div class="employees-layout">


            <!-- =================================================
                 USERS
                 ================================================= -->

            <aside class="users-column">

                <section class="users-card">

                    <div class="card-top-line"></div>


                    <!-- Header -->
                    <div class="users-card-header">

                        <div class="users-title-icon">
                            👤
                        </div>

                        <div>

                            <strong>
                                الموظفون
                            </strong>

                            <span>
                                اختر موظفًا لعرض تقاريره
                            </span>

                        </div>

                    </div>


                    <!-- Search -->
                    <div class="users-search">

                        <label>
                            البحث عن موظف
                        </label>

                        <div class="search-wrapper">

                            <span class="search-icon">
                                🔎
                            </span>

                            <input class="premium-input search-input"
                                   @bind="UserSearch"
                                   @bind:event="oninput"
                                   placeholder="اكتب اسم الموظف..." />

                        </div>

                    </div>


                    <div class="users-list-wrapper">

                        @if (!IsAdmin)
                        {
                            <div class="permission-alert">

                                <span class="permission-alert-icon">
                                    🔒
                                </span>

                                <div>

                                    <strong>
                                        وصول محدود
                                    </strong>

                                    <span>
                                        أنت مستخدم عادي، ترى فقط تقاريرك الخاصة.
                                    </span>

                                </div>

                            </div>
                        }
                        else if (Userss == null)
                        {
                            <div class="users-loading">

                                <div class="small-loader"></div>

                                <span>
                                    جارٍ التحميل...
                                </span>

                            </div>
                        }
                        else if (Userss.Count == 0)
                        {
                            <div class="empty-users">

                                <span>
                                    👤
                                </span>

                                <strong>
                                    لا يوجد موظفين
                                </strong>

                            </div>
                        }
                        else
                        {
                            <div class="users-list">

                                @foreach (var u in FilteredUsers)
                                {
                                    <button type="button"
                                            class="user-item @(SelectedUser?.Id == u.Id ? "selected" : "")"
                                            @onclick="@(() => SelectUser(u))">

                                        <div class="user-avatar">
                                            <span>👤</span>
                                        </div>

                                        <div class="user-info">

                                            <strong>
                                                @u.FullName
                                            </strong>

                                            <span>
                                                موظف
                                            </span>

                                        </div>

                                        <div class="user-count">

                                            <strong>
                                                @GetUserReportsCount(u)
                                            </strong>

                                            <span>
                                                تقرير
                                            </span>

                                        </div>

                                    </button>
                                }

                            </div>

                        }

                    </div>

                </section>

            </aside>


            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <section class="reports-column">


                <!-- =================================================
                     FILTERS
                     ================================================= -->

                <section class="filters-card">

                    <div class="card-top-line"></div>


                    <div class="filters-header">

                        <div class="filters-title">

                            <div class="filters-icon">
                                🎛️
                            </div>

                            <div>

                                <strong>
                                    مرشحات العرض
                                </strong>

                                <span>
                                    تحكم بالنتائج المعروضة
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="filters-grid">


                 


                        <!-- من -->
                        <div class="filter-field">

                            <label>
                                من تاريخ
                            </label>

                            <InputDate class="premium-input"
                                       @bind-Value="FromDate" />

                        </div>


                        <!-- إلى -->
                        <div class="filter-field">

                            <label>
                                إلى تاريخ
                            </label>

                            <InputDate class="premium-input"
                                       @bind-Value="ToDate" />

                        </div>


                        <!-- الحالة -->
                        <div class="filter-field">

                            <label>
                                الحالة
                            </label>

                            <select class="premium-select"
                                    @bind="SelectedStatus">

                                <option value="All">
                                    الكل
                                </option>

                                <option value="Done">
                                    المنتهية
                                </option>

                                <option value="NotDone">
                                    غير المنتهية
                                </option>

                            </select>

                        </div>


                        <!-- Apply -->
                        <div class="filter-action">

                            <button class="premium-primary-btn"
                                    @onclick="ApplyFilters">

                                <span>
                                    🔍
                                </span>

                                تطبيق

                            </button>

                        </div>


                        <!-- Reset -->
                        <div class="filter-action">

                            <button class="premium-secondary-btn"
                                    @onclick="ResetFilters">

                                <span>
                                    ↺
                                </span>

                                إعادة تعيين

                            </button>

                        </div>

                    </div>


                    <!-- =================================================
                         EXCEL
                         ================================================= -->
                    @if (IsAdmin)
                    {
                        <div class="excel-section">

                            <div class="excel-info">

                                <div class="excel-icon">
                                    📊
                                </div>

                                <div>

                                    <strong>
                                        تصدير التقارير
                                    </strong>

                                    <span>
                                        إنشاء ملف Excel للموظف المحدد
                                    </span>

                                </div>

                            </div>


                            <div class="excel-actions">

                                <button class="excel-btn"
                                        @onclick="ExportReportsToExcel"
                                        disabled="@(SelectedUser == null || isExporting)">

                                    @if (isExporting)
                                    {
                                        <span class="small-spinner"></span>

                                        <span>
                                            جار تحضير التقرير...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            📗
                                        </span>

                                        <span>
                                            تصدير Excel
                                        </span>
                                    }

                                </button>


                                @if (!string.IsNullOrEmpty(excelUrl))
                                {
                                    <a class="excel-download"
                                       href="@excelUrl"
                                       target="_blank">

                                        تحميل الملف
                                        ↓

                                    </a>
                                }


                                @if (!string.IsNullOrEmpty(exportMessage))
                                {
                                    <span class="export-message">
                                        @exportMessage
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </section>


                <!-- =================================================
                     REPORTS TABLE
                     ================================================= -->

                <section class="reports-card">

                    <div class="card-top-line"></div>


                    <div class="reports-header-row">

                        <div class="reports-title-block">

                            <div class="reports-title-icon">
                                📊
                            </div>

                            <div>

                                <strong>
                                    تقارير الموظف
                                </strong>

                                @if (SelectedUser != null)
                                {
                                    <span class="selected-user-name">
                                        @SelectedUser.FullName
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        لم يتم اختيار موظف
                                    </span>
                                }

                            </div>

                        </div>


                        @if (SelectedUser != null)
                        {
                            <div class="results-count">

                                <span>
                                    النتائج
                                </span>

                                <strong>
                                    @FilteredReports.Count()
                                </strong>

                            </div>

                            <div class="results-count deduction-count">
                                <span>إجمالي الخصم</span>
                                <strong>@SelectedUser.TotalDeductions.ToString("N2")</strong>
                            </div>
                        }

                    </div>


                    <div class="reports-body">

                        @if (SelectedUser != null && IsAdmin)
                        {
                            <section class="user-notes-panel">
                                <div class="notes-panel-heading">
                                    <strong>ملاحظات الموظف</strong>
                                    <span>ملاحظات داخلية تظهر للإدارة</span>
                                </div>

                                <div class="notes-panel-form">
                                    <InputTextArea class="premium-input"
                                                   rows="2"
                                                   @bind-Value="NewUserNote"
                                                   placeholder="أضف ملاحظة عن الموظف..." />
                                    <button type="button" class="action-button" @onclick="AddUserNote" disabled="@string.IsNullOrWhiteSpace(NewUserNote)">حفظ الملاحظة</button>
                                </div>

                                @foreach (var note in UserNotes)
                                {
                                    <div class="user-note-item">
                                        <span>@note.Content</span>
                                        <small>@note.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                                    </div>
                                }
                            </section>
                        }

                        @if (SelectedUser == null)
                        {
                            <div class="empty-reports">

                                <div class="empty-reports-icon">
                                    👈
                                </div>

                                <strong>
                                    اختر موظفاً من القائمة
                                </strong>

                                <span>
                                    ستظهر تقاريره ومهامه هنا.
                                </span>

                            </div>
                        }
                        else if (IsLoadingReports)
                        {
                            <div class="reports-loading">

                                <div class="loader-ring">
                                    <div class="loader-core"></div>
                                </div>

                                <strong>
                                    جارٍ تحميل التقارير...
                                </strong>

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="reports-table">

                                    <thead>

                                        <tr>

                                            <th>المهمة</th>
                                            <th>النوع</th>
                                            <th>العميل / المشروع</th>
                                            <th>الموظف</th>
                                            <th>الأولوية</th>
                                            <th>التقدم</th>
                                            <th>المنجز</th>
                                            <th>المتبقي</th>
                                            <th>الحالة</th>
                                            <th>التسليم</th>
                                            <th>إجراء</th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var r in FilteredReports)
                                        {
                                            <tr class="report-row">

                                                <!-- المهمة -->
                                                <td>

                                                    <div class="task-cell">

                                                        <div class="task-icon">
                                                            📝
                                                        </div>

                                                        <div>

                                                            <strong>
                                                                @(r.Content ?? "-")
                                                            </strong>

                                                            @if (!string.IsNullOrWhiteSpace(r.TaskDetails))
                                                            {
                                                                <span>
                                                                    @r.TaskDetails
                                                                </span>
                                                            }

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- النوع -->
                                                <td>

                                                    <span class="type-pill">
                                                        @(r.TaskType ?? "-")
                                                    </span>

                                                </td>


                                                <!-- العميل -->
                                                <td>

                                                    <div class="project-cell">

                                                        <span class="project-dot"></span>

                                                        @(r.ClientOrProject ?? "-")

                                                    </div>

                                                </td>


                                                <!-- الموظف -->
                                                <td>

                                                    <div class="employee-cell">

                                                        <span class="employee-avatar">
                                                            👤
                                                        </span>

                                                        @(r.AssignedEmployee ?? r.FullName ?? "-")

                                                    </div>

                                                </td>


                                                <!-- الأولوية -->
                                                <td>

                                                    @if (r.Priority == "عالية")
                                                    {
                                                        <span class="priority-pill priority-high">
                                                            عالية
                                                        </span>
                                                    }
                                                    else if (r.Priority == "متوسطة")
                                                    {
                                                        <span class="priority-pill priority-medium">
                                                            متوسطة
                                                        </span>
                                                    }
                                                    else if (r.Priority == "منخفضة")
                                                    {
                                                        <span class="priority-pill priority-low">
                                                            منخفضة
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="type-pill">
                                                            @(r.Priority ?? "-")
                                                        </span>
                                                    }

                                                </td>


                                                <!-- التقدم -->
                                                <td style="min-width:180px">

                                                    <div class="progress-wrapper">

                                                        <div class="progress-meta">

                                                            <span>
                                                                التقدم
                                                            </span>

                                                            <strong>
                                                                @r.ProgressPercentage%
                                                            </strong>

                                                        </div>

                                                        <div class="premium-progress">

                                                            <div class="premium-progress-bar"
                                                                 style="width:@($"{r.ProgressPercentage}%")">

                                                                <span class="progress-shine"></span>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- المنجز -->
                                                <td>

                                                    <span class="counter completed">
                                                        @r.CompletedItems
                                                        /
                                                        @r.TotalItems
                                                    </span>

                                                </td>


                                                <!-- المتبقي -->
                                                <td>

                                                    <span class="counter remaining">
                                                        @r.RemainingItems
                                                    </span>

                                                </td>


                                                <!-- الحالة -->
                                                <td>

                                                    @if (r.IsDoneOrNot == "مكتملة")
                                                    {
                                                        <span class="status-pill status-completed">
                                                            <span class="status-dot"></span>
                                                            مكتملة
                                                        </span>
                                                    }
                                                    else if (r.IsDoneOrNot == "قيد التنفيذ")
                                                    {
                                                        <span class="status-pill status-progress">
                                                            <span class="status-dot"></span>
                                                            قيد التنفيذ
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-pill status-pending">
                                                            <span class="status-dot"></span>
                                                            لم تبدأ
                                                        </span>
                                                    }

                                                </td>


                                                <!-- التسليم -->
                                                <td>

                                                    <span class="date-cell">

                                                        📅

                                                        @(r.DueDate?.ToString("yyyy-MM-dd") ?? "-")

                                                    </span>

                                                </td>


                                                <!-- إجراء -->
                                                <td>

                                                    @if (CanEditReport(r))
                                                    {
                                                        <button class="edit-btn"
                                                                title="تحديث التقرير"
                                                                @onclick="@(() => EditReport(r.Id))">

                                                            ✏️
                                                            تحديث

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="not-allowed">
                                                            -
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                                @if (!FilteredReports.Any())
                                {
                                    <div class="no-results">

                                        <div>
                                            🔎
                                        </div>

                                        لا توجد نتائج مطابقة للمرشحات.

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </section>

            </section>

        </div>

    </main>

</div>


@code {

    // =============================================================
    // المستخدمون
    // =============================================================

    List<User> Userss = new();


    List<User> FilteredUsers =>
        string.IsNullOrWhiteSpace(UserSearch)
            ? Userss ?? new List<User>()
            : (Userss ?? new List<User>())
                .Where(u =>
                    (u.FullName ?? "")
                        .Contains(
                            UserSearch,
                            StringComparison.OrdinalIgnoreCase))
                .ToList();


    User SelectedUser;


    // =============================================================
    // التقارير
    // =============================================================

    List<FollowUpReport> AllReports = new();

    IEnumerable<FollowUpReport> FilteredReports =
        Enumerable.Empty<FollowUpReport>();


    // =============================================================
    // الفلاتر
    // =============================================================

    string UserSearch = string.Empty;

    string SelectedStoreType = string.Empty;

    DateTime? FromDate = null;

    DateTime? ToDate = null;

    string SelectedStatus = "All";

    List<string> StoreTypes = new();

    bool IsLoadingReports = false;


    // =============================================================
    // التصدير
    // =============================================================

    bool isExporting = false;

    string excelUrl = string.Empty;

    string exportMessage = string.Empty;


    // =============================================================
    // المستخدم الحالي
    // =============================================================

    private User User { get; set; } = new User();
    private List<UserNote> UserNotes = new();
    private string NewUserNote = string.Empty;

    bool IsAdmin = false;

    string CurrentUserName = "user1";


    // =============================================================
    // تحميل الصفحة
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor
                    .HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(c => c.Type == "Id")
                    ?.Value;


            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(idClaim, out var uid))
            {
                var res =
                    await UserRepo.GetById(uid);


                if (res.IsSuccess)
                {
                    User = res.Value;

                    IsAdmin =
                        User.IsAdmin || User.IsFollowUpAdmin || User.IsItAdmin;

                    CurrentUserName =
                        User.FullName;
                }
            }
        }
        catch
        {
        }


        await LoadUsersAsync();


        await LoadReportsForDate(
            DateTime.Now.Date);


        BuildStoreTypes();


        if (!IsAdmin)
        {
            Userss =
                Userss
                    .Where(u => u.Id == User.Id)
                    .ToList();


            SelectedUser = User;


            await RefreshFilteredReportsAsync();
        }
    }


    private async Task LoadUsersAsync()
    {
        try
        {
            var result =
                await UserRepo.GetAll();


            Userss =
                result.Value ??
                new List<User>();
        }
        catch
        {
            Userss = new();
        }
    }


    private async Task LoadReportsForDate(DateTime date)
    {
        try
        {
            var result =
                await _service.GetReportsByDate(date);

            if (IsAdmin)
            {
                AllReports =
                    result?.ToList()
                    ?? new List<FollowUpReport>();
            }
            else
            {
                AllReports =
                    result?
                        .Where(r =>
                            r.AssignedEmployeeId == User.Id)
                        .ToList()
                    ?? new List<FollowUpReport>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Load reports error: {ex}");

            AllReports =
                new List<FollowUpReport>();
        }
    }

    private async Task<List<FollowUpReport>>
        FetchReportsForDateRange(
            DateTime from,
            DateTime to)
    {
        var combined =
            new List<FollowUpReport>();


        for (
            var d = from.Date;
            d <= to.Date;
            d = d.AddDays(1))
        {
            var r =
                await _service.GetReportsByDate(d);


            if (r != null)
            {
                combined.AddRange(r);
            }
        }


        return combined;
    }


    private void BuildStoreTypes()
    {
        StoreTypes =
            AllReports
                .Where(r =>
                    !string.IsNullOrWhiteSpace(r.StoreType))
                .Select(r =>
                    r.StoreType!.Trim())
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();
    }


    private async Task SelectUser(User u)
    {
        SelectedUser = u;
        NewUserNote = string.Empty;
        UserNotes = await Db.UserNotes
            .Where(x => x.UserId == u.Id)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        await RefreshFilteredReportsAsync();
    }

    private async Task AddUserNote()
    {
        if (SelectedUser is null || string.IsNullOrWhiteSpace(NewUserNote) || !IsAdmin)
            return;

        var note = new UserNote
        {
            UserId = SelectedUser.Id,
            Content = NewUserNote.Trim(),
            CreatedByUserId = User.Id
        };

        Db.UserNotes.Add(note);
        await Db.SaveChangesAsync();
        UserNotes.Insert(0, note);
        NewUserNote = string.Empty;
    }


    private int GetUserReportsCount(User u)
    {
        return AllReports.Count(r =>
            r.AssignedEmployeeId == u.Id);
    }


    private async Task ApplyFilters()
    {
        try
        {
            IsLoadingReports = true;

            // ===========================================
            // في حال وجود فترة
            // ===========================================

            if (FromDate.HasValue &&
                ToDate.HasValue)
            {
                var reports =
                    await FetchReportsForDateRange(
                        FromDate.Value,
                        ToDate.Value);

                if (IsAdmin)
                {
                    AllReports =
                        reports;
                }
                else
                {
                    AllReports =
                        reports
                            .Where(r =>
                                r.AssignedEmployeeId == User.Id)
                            .ToList();
                }
            }
            else
            {
                // =======================================
                // اليوم الحالي
                // =======================================

                await LoadReportsForDate(
                    DateTime.Now.Date);
            }

            BuildStoreTypes();

            await RefreshFilteredReportsAsync();
        }
        finally
        {
            IsLoadingReports = false;
        }
    }


    private async Task RefreshFilteredReportsAsync()
    {
        if (SelectedUser == null)
        {
            FilteredReports =
                Enumerable.Empty<FollowUpReport>();

            return;
        }

        IsLoadingReports = true;

        try
        {
            IEnumerable<FollowUpReport> userReports =
                AllReports.Where(r =>
                    r.AssignedEmployeeId == SelectedUser.Id);


            // ===========================================
            // نوع المتجر
            // ===========================================

            if (!string.IsNullOrWhiteSpace(
                SelectedStoreType))
            {
                userReports =
                    userReports.Where(r =>
                        string.Equals(
                            r.StoreType?.Trim(),
                            SelectedStoreType.Trim(),
                            StringComparison.OrdinalIgnoreCase));
            }


            // ===========================================
            // الحالة
            // ===========================================

            if (SelectedStatus == "Done")
            {
                userReports =
                    userReports.Where(r =>
                        r.IsDone);
            }
            else if (SelectedStatus == "NotDone")
            {
                userReports =
                    userReports.Where(r =>
                        !r.IsDone);
            }


            FilteredReports =
                userReports
                    .OrderByDescending(
                        r => r.DateTime)
                    .ToList();
        }
        finally
        {
            IsLoadingReports = false;
        }
    }


    private void ResetFilters()
    {
        SelectedStoreType =
            string.Empty;

        FromDate = null;

        ToDate = null;

        SelectedStatus =
            "All";


        _ = RefreshFilteredReportsAsync();
    }


    private bool CanEditReport(FollowUpReport r)
    {
        return
            IsAdmin ||
            r.AssignedEmployeeId == User.Id;
    }


    private void EditReport(int reportId)
    {
        var report =
            AllReports.FirstOrDefault(
                r => r.Id == reportId);

        if (report == null)
            return;

        if (!CanEditReport(report))
            return;

        NavigationManager.NavigateTo(
            $"/followup-report/{reportId}");
    }


    private async Task ToggleDone(
        FollowUpReport report,
        object? value)
    {
        if (!CanEditReport(report))
        {
            return;
        }


        report.IsDone =
            Convert.ToBoolean(value);


        await _service.Update(report);
    }


    private async Task ExportReportsToExcel()
    {
        if (SelectedUser == null)
            return;

        var reports =
            FilteredReports.ToList();

        if (!reports.Any())
            return;

        isExporting = true;
        exportMessage = string.Empty;
        excelUrl = string.Empty;

        try
        {
            excelUrl =
                await _excel.GenerateFollowUpReportExcelAsync(
                    reports,
                    DateTime.Now);

            exportMessage =
                $"تم إنشاء ملف Excel للمستخدم {SelectedUser.FullName}";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Excel export error: {ex}");

            exportMessage =
                "حدث خطأ أثناء إنشاء ملف Excel.";
        }
        finally
        {
            isExporting = false;
        }
    }


    string DisplayPath(string? v)
    {
        if (string.IsNullOrEmpty(v))
        {
            return string.Empty;
        }


        var n =
            v.Replace("\\", "/");


        return
            n.StartsWith("/")
                ? n
                : "/" + n;
    }

}


