@page "/users-and-reports"

@using REMS.Enititys
@using System.Text.Json

@inject UserService UserRepo
@inject IFollowUpReportService _service
@inject ExcelService _excel
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<h3 class="text-center mb-4 text-white bg-orange p-3 rounded">
    الموظفين والمهام
</h3>

<div class="row">

    <!-- ========================================================= -->
    <!-- قائمة المستخدمين -->
    <!-- ========================================================= -->

    <div class="col-12 col-md-4">

        <div class="card shadow p-3 mb-3 border-orange">

            <div class="mb-2">

                <label class="text-orange">
                    ابحث عن موظف
                </label>

                <input class="form-control border-orange"
                       @bind="UserSearch"
                       @bind:event="oninput"
                       placeholder="اكتب اسم الموظف..." />

            </div>


            <div style="max-height:60vh; overflow:auto;">

                @if (!IsAdmin)
                {
                    <div class="alert alert-warning text-center">

                        أنت مستخدم عادي، ترى فقط تقاريرك الخاصة.

                    </div>
                }
                else if (Userss == null)
                {
                    <div>
                        جارٍ التحميل...
                    </div>
                }
                else if (Userss.Count == 0)
                {
                    <div>
                        لا يوجد موظفين
                    </div>
                }
                else
                {
                    <ul class="list-group">

                        @foreach (var u in FilteredUsers)
                        {
                            <li class="list-group-item"
                                style="cursor:pointer;"
                                @onclick="@(() => SelectUser(u))">

                                <div class="d-flex justify-content-between align-items-center">

                                    <span>
                                        @u.FullName
                                    </span>

                                    <span class="badge bg-orange">
                                        @GetUserReportsCount(u)
                                    </span>

                                </div>

                            </li>
                        }

                    </ul>
                }

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- جدول التقارير والفلاتر -->
    <!-- ========================================================= -->

    <div class="col-12 col-md-8">

        <!-- ===================================================== -->
        <!-- الفلاتر -->
        <!-- ===================================================== -->

        <div class="card shadow p-3 mb-3 border-orange">

            <h5 class="text-orange">
                مرشحات العرض
            </h5>

            <div class="row g-2 align-items-end">

                <!-- نوع المتجر -->
                <div class="col-12 col-md-4">

                    <label>
                        نوع المتجر
                    </label>

                    <select class="form-select border-orange"
                            @bind="SelectedStoreType">

                        <option value="">
                            (الكل)
                        </option>

                        @foreach (var st in StoreTypes)
                        {
                            <option value="@st">
                                @st
                            </option>
                        }

                    </select>

                </div>


                <!-- من تاريخ -->
                <div class="col-6 col-md-4">

                    <label>
                        من تاريخ
                    </label>

                    <InputDate class="form-control border-orange"
                               @bind-Value="FromDate" />

                </div>


                <!-- إلى تاريخ -->
                <div class="col-6 col-md-4">

                    <label>
                        إلى تاريخ
                    </label>

                    <InputDate class="form-control border-orange"
                               @bind-Value="ToDate" />

                </div>


                <!-- الحالة -->
                <div class="col-6 col-md-4">

                    <label>
                        الحالة
                    </label>

                    <select class="form-select border-orange"
                            @bind="SelectedStatus">

                        <option value="All">
                            الكل
                        </option>

                        <option value="Done">
                            المنتهية
                        </option>

                        <option value="NotDone">
                            غير المنتهية
                        </option>

                    </select>

                </div>


                <!-- تطبيق -->
                <div class="col-6 col-md-4">

                    <button class="btn btn-orange w-100"
                            @onclick="ApplyFilters">

                        تطبيق

                    </button>

                </div>


                <!-- إعادة تعيين -->
                <div class="col-6 col-md-4">

                    <button class="btn btn-outline-orange w-100"
                            @onclick="ResetFilters">

                        إعادة تعيين

                    </button>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- تصدير Excel للمدير فقط -->
            <!-- ================================================= -->
            @if (IsAdmin)
            {
                <div class="mt-3">

                    <button class="btn btn-success"
                            @onclick="ExportReportsToExcel"
                            disabled="@(SelectedUser == null || isExporting)"
                            dir="rtl">

                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status">
                            </span>

                            <span>
                                جار تحضير التقرير...
                            </span>
                        }
                        else
                        {
                            <i class="fa fa-file-excel-o me-1"></i>

                            <span>
                                تصدير Excel
                            </span>
                        }

                    </button>


                    @if (!string.IsNullOrEmpty(excelUrl))
                    {
                        <a class="btn btn-link ms-3"
                           href="@excelUrl"
                           target="_blank">

                            تحميل الملف

                        </a>
                    }


                    @if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <span class="text-muted ms-3">
                            @exportMessage
                        </span>
                    }

                </div>
            }

        </div>


        <!-- ===================================================== -->
        <!-- جدول التقارير -->
        <!-- ===================================================== -->

        <div class="card shadow p-3 border-orange">

            <h5 class="text-orange">

                تقارير الموظف:

                @if (SelectedUser != null)
                {
                    <span class="badge bg-orange text-white">
                        @SelectedUser.FullName
                    </span>

                    <small class="text-muted ms-2">
                        عدد النتائج: @FilteredReports.Count()
                    </small>
                }
                else
                {
                    <span class="text-muted">
                        لم يتم اختيار موظف
                    </span>
                }

            </h5>


            @if (SelectedUser == null)
            {
                <div class="text-muted">
                    اختر موظفاً من اليسار لعرض تقاريره.
                </div>
            }
            else if (IsLoadingReports)
            {
                <div class="text-center p-4">

                    <div class="spinner-border text-orange"
                         role="status">
                    </div>

                    <div class="mt-2">
                        جارٍ تحميل التقارير...
                    </div>

                </div>
            }
            else
            {
                <div style="overflow-x:auto;">

                    <table class="table table-hover align-middle"
                           dir="rtl">

                        <thead>

                            <tr>

                                <th>المهمة</th>

                                <th>النوع</th>

                                <th>العميل / المشروع</th>

                                <th>الموظف</th>

                                <th>الأولوية</th>

                                <th>التقدم</th>

                                <th>المنجز</th>

                                <th>المتبقي</th>

                                <th>الحالة</th>

                                <th>التسليم</th>

                                <th>إجراء</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var r in FilteredReports)
                            {
                                <tr>

                                    <!-- المهمة -->
                                    <td>

                                        <strong>
                                            @(r.Content ?? "-")
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(r.TaskDetails))
                                        {
                                            <div class="small text-muted mt-1">
                                                @r.TaskDetails
                                            </div>
                                        }

                                    </td>


                                    <!-- النوع -->
                                    <td>
                                        @(r.TaskType ?? "-")
                                    </td>


                                    <!-- العميل / المشروع -->
                                    <td>
                                        @(r.ClientOrProject ?? "-")
                                    </td>


                                    <!-- الموظف -->
                                    <td>
                                        @(r.AssignedEmployee ?? r.FullName ?? "-")
                                    </td>


                                    <!-- الأولوية -->
                                    <td>

                                        @if (r.Priority == "عالية")
                                        {
                                            <span class="badge bg-danger">
                                                عالية
                                            </span>
                                        }
                                        else if (r.Priority == "متوسطة")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                متوسطة
                                            </span>
                                        }
                                        else if (r.Priority == "منخفضة")
                                        {
                                            <span class="badge bg-success">
                                                منخفضة
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @(r.Priority ?? "-")
                                            </span>
                                        }

                                    </td>


                                    <!-- التقدم -->
                                    <td style="min-width:160px">

                                        <div class="progress"
                                             style="height:22px;">

                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width:@($"{r.ProgressPercentage}%")">

                                                @r.ProgressPercentage%

                                            </div>

                                        </div>

                                    </td>


                                    <!-- المنجز -->
                                    <td>

                                        @r.CompletedItems
                                        /
                                        @r.TotalItems

                                    </td>


                                    <!-- المتبقي -->
                                    <td>
                                        @r.RemainingItems
                                    </td>


                                    <!-- الحالة -->
                                    <td>

                                        @if (r.IsDoneOrNot == "مكتملة")
                                        {
                                            <span class="badge bg-success">
                                                مكتملة
                                            </span>
                                        }
                                        else if (r.IsDoneOrNot == "قيد التنفيذ")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                قيد التنفيذ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                لم تبدأ
                                            </span>
                                        }

                                    </td>


                                    <!-- التسليم -->
                                    <td>

                                        @(r.DueDate?.ToString("yyyy-MM-dd") ?? "-")

                                    </td>


                                    <!-- إجراء -->
                                    <td>

                                        @if (CanEditReport(r))
                                        {
                                            <button class="btn btn-sm btn-primary"
                                                    title="تحديث التقرير"
                                                    @onclick="@(() => EditReport(r.Id))">

                                                تحديث

                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>


                    @if (!FilteredReports.Any())
                    {
                        <div class="text-muted text-center p-3">

                            لا توجد نتائج مطابقة للمرشحات.

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>


@code {

    // =============================================================
    // المستخدمون
    // =============================================================

    List<User> Userss = new();


    List<User> FilteredUsers =>
        string.IsNullOrWhiteSpace(UserSearch)
            ? Userss ?? new List<User>()
            : (Userss ?? new List<User>())
                .Where(u =>
                    (u.FullName ?? "")
                        .Contains(
                            UserSearch,
                            StringComparison.OrdinalIgnoreCase))
                .ToList();


    User SelectedUser;


    // =============================================================
    // التقارير
    // =============================================================

    List<FollowUpReport> AllReports = new();

    IEnumerable<FollowUpReport> FilteredReports =
        Enumerable.Empty<FollowUpReport>();


    // =============================================================
    // الفلاتر
    // =============================================================

    string UserSearch = string.Empty;

    string SelectedStoreType = string.Empty;

    DateTime? FromDate = null;

    DateTime? ToDate = null;

    string SelectedStatus = "All";

    List<string> StoreTypes = new();

    bool IsLoadingReports = false;


    // =============================================================
    // التصدير
    // =============================================================

    bool isExporting = false;

    string excelUrl = string.Empty;

    string exportMessage = string.Empty;


    // =============================================================
    // المستخدم الحالي
    // =============================================================

    private User User { get; set; } = new User();

    bool IsAdmin = false;

    string CurrentUserName = "user1";


    // =============================================================
    // تحميل الصفحة
    // =============================================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var idClaim =
                HttpContextAccessor
                    .HttpContext?
                    .User?
                    .Claims?
                    .FirstOrDefault(c => c.Type == "Id")
                    ?.Value;


            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(idClaim, out var uid))
            {
                var res =
                    await UserRepo.GetById(uid);


                if (res.IsSuccess)
                {
                    User = res.Value;

                    IsAdmin =
                        User.IsFollowUpAdmin;

                    CurrentUserName =
                        User.FullName;
                }
            }
        }
        catch
        {
        }


        await LoadUsersAsync();


        await LoadReportsForDate(
            DateTime.Now.Date);


        BuildStoreTypes();


        // =====================================================
        // إذا كان مستخدمًا عاديًا
        // =====================================================

        if (!IsAdmin)
        {
            Userss =
                Userss
                    .Where(u => u.Id == User.Id)
                    .ToList();


            SelectedUser = User;


            await RefreshFilteredReportsAsync();
        }
    }


    // =============================================================
    // تحميل المستخدمين
    // =============================================================

    private async Task LoadUsersAsync()
    {
        try
        {
            var result =
                await UserRepo.GetAll();


            Userss =
                result.Value ??
                new List<User>();
        }
        catch
        {
            Userss = new();
        }
    }


    // =============================================================
    // تحميل تقارير اليوم
    // =============================================================

    private async Task LoadReportsForDate(
        DateTime date)
    {
        try
        {
            var result =
                await _service.GetReportsByDate(date);


            if (IsAdmin)
            {
                AllReports =
                    result?.ToList()
                    ?? new();
            }
            else
            {
                AllReports =
                    result?
                        .Where(r =>
                            string.Equals(
                                r.FullName?.Trim(),
                                User.FullName?.Trim(),
                                StringComparison.OrdinalIgnoreCase))
                        .ToList()
                    ?? new();
            }
        }
        catch
        {
            AllReports = new();
        }
    }


    // =============================================================
    // جلب التقارير ضمن فترة
    // =============================================================

    private async Task<List<FollowUpReport>>
        FetchReportsForDateRange(
            DateTime from,
            DateTime to)
    {
        var combined =
            new List<FollowUpReport>();


        for (
            var d = from.Date;
            d <= to.Date;
            d = d.AddDays(1))
        {
            var r =
                await _service.GetReportsByDate(d);


            if (r != null)
            {
                combined.AddRange(r);
            }
        }


        return combined;
    }


    // =============================================================
    // بناء أنواع المتاجر
    // =============================================================

    private void BuildStoreTypes()
    {
        StoreTypes =
            AllReports
                .Where(r =>
                    !string.IsNullOrWhiteSpace(r.StoreType))
                .Select(r =>
                    r.StoreType!.Trim())
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s)
                .ToList();
    }


    // =============================================================
    // اختيار المستخدم
    // =============================================================

    private async Task SelectUser(User u)
    {
        SelectedUser = u;

        await RefreshFilteredReportsAsync();
    }


    // =============================================================
    // عدد تقارير المستخدم
    // =============================================================

    private int GetUserReportsCount(User u)
    {
        return
            AllReports.Count(r =>
                string.Equals(
                    r.FullName?.Trim(),
                    u.FullName?.Trim(),
                    StringComparison.OrdinalIgnoreCase));
    }


    // =============================================================
    // تطبيق الفلاتر
    // =============================================================

    private async Task ApplyFilters()
    {
        if (FromDate.HasValue &&
            ToDate.HasValue)
        {
            IsLoadingReports = true;


            var reports =
                await FetchReportsForDateRange(
                    FromDate.Value,
                    ToDate.Value);


            if (IsAdmin)
            {
                AllReports = reports;
            }
            else
            {
                AllReports =
                    reports
                        .Where(r =>
                            string.Equals(
                                r.FullName?.Trim(),
                                User.FullName?.Trim(),
                                StringComparison.OrdinalIgnoreCase))
                        .ToList();
            }


            BuildStoreTypes();

            IsLoadingReports = false;
        }


        await RefreshFilteredReportsAsync();
    }


    // =============================================================
    // تحديث التقارير المعروضة
    // =============================================================

    private async Task RefreshFilteredReportsAsync()
    {
        if (SelectedUser == null)
        {
            FilteredReports =
                Enumerable.Empty<FollowUpReport>();

            return;
        }


        IsLoadingReports = true;


        var userReports =
            AllReports
                .Where(r =>
                    string.Equals(
                        r.FullName?.Trim(),
                        SelectedUser.FullName?.Trim(),
                        StringComparison.OrdinalIgnoreCase));


        if (!string.IsNullOrEmpty(
            SelectedStoreType))
        {
            userReports =
                userReports
                    .Where(r =>
                        r.StoreType ==
                        SelectedStoreType);
        }


        if (SelectedStatus == "Done")
        {
            userReports =
                userReports
                    .Where(r => r.IsDone);
        }
        else if (SelectedStatus == "NotDone")
        {
            userReports =
                userReports
                    .Where(r => !r.IsDone);
        }


        FilteredReports =
            userReports
                .OrderByDescending(
                    r => r.DateTime)
                .ToList();


        IsLoadingReports = false;
    }


    // =============================================================
    // إعادة تعيين الفلاتر
    // =============================================================

    private void ResetFilters()
    {
        SelectedStoreType =
            string.Empty;

        FromDate = null;

        ToDate = null;

        SelectedStatus =
            "All";


        _ = RefreshFilteredReportsAsync();
    }


    // =============================================================
    // صلاحية تعديل التقرير
    // =============================================================

    private bool CanEditReport(
        FollowUpReport r)
    {
        return
            IsAdmin ||
            string.Equals(
                r.FullName?.Trim(),
                CurrentUserName?.Trim(),
                StringComparison.OrdinalIgnoreCase);
    }


    // =============================================================
    // تعديل التقرير
    //
    // ينقل المستخدم إلى نفس صفحة تعديل التقرير الأصلية
    // =============================================================

    private void EditReport(int reportId)
    {
        var report =
            AllReports.FirstOrDefault(
                r => r.Id == reportId);


        if (report == null)
        {
            return;
        }


        // =============================================
        // حماية إضافية:
        // الموظف لا يستطيع تعديل تقرير ليس له
        // =============================================

        if (!CanEditReport(report))
        {
            return;
        }


        NavigationManager.NavigateTo(
            $"/followup-report/{reportId}");
    }


    // =============================================================
    // تغيير حالة الإنجاز
    // =============================================================

    private async Task ToggleDone(
        FollowUpReport report,
        object? value)
    {
        if (!CanEditReport(report))
        {
            return;
        }


        report.IsDone =
            Convert.ToBoolean(value);


        await _service.Update(report);
    }


    // =============================================================
    // تصدير Excel
    // =============================================================

    private async Task ExportReportsToExcel()
    {
        if (SelectedUser == null)
        {
            return;
        }


        var reports =
            FilteredReports.ToList();


        if (!reports.Any())
        {
            return;
        }


        isExporting = true;


        try
        {
            excelUrl =
                await _excel.GenerateFollowUpReportExcelAsync(
                    reports,
                    DateTime.Now);


            exportMessage =
                $"تم إنشاء ملف Excel للمستخدم {SelectedUser.FullName}";
        }
        finally
        {
            isExporting = false;
        }
    }


    // =============================================================
    // مسار الملف
    // =============================================================

    string DisplayPath(string? v)
    {
        if (string.IsNullOrEmpty(v))
        {
            return string.Empty;
        }


        var n =
            v.Replace("\\", "/");


        return
            n.StartsWith("/")
                ? n
                : "/" + n;
    }

}

<style>

    /* ========================================================= */
    /* الألوان */
    /* ========================================================= */

    .text-orange {
        color: #ff6600;
    }


    .bg-orange {
        background-color: #ff6600;
    }


    .border-orange {
        border: 1px solid #ff6600;
    }


    .btn-orange {
        background-color: #ff6600;
        color: white;
        border: none;
    }


        .btn-orange:hover {
            background-color: #e65c00;
            color: white;
        }


    .btn-outline-orange {
        border: 1px solid #ff6600;
        color: #ff6600;
        background-color: white;
    }


        .btn-outline-orange:hover {
            background-color: #ff6600;
            color: white;
        }


    .badge.bg-orange {
        background-color: #ff6600;
    }


    /* ========================================================= */
    /* المستخدم */
    /* ========================================================= */

    .list-group-item {
        transition: all 0.2s ease;
    }


        .list-group-item:hover {
            background-color: #fff5ef;
            border-color: #ff6600;
        }


    /* ========================================================= */
    /* الجدول */
    /* ========================================================= */

    .table th {
        white-space: nowrap;
        vertical-align: middle;
    }


    .table td {
        vertical-align: middle;
    }


    /* ========================================================= */
    /* الحقول */
    /* ========================================================= */

    .form-control:focus,
    .form-select:focus {
        border-color: #ff6600;
        box-shadow: 0 0 0 0.2rem rgba(255, 102, 0, 0.15);
    }


    /* ========================================================= */
    /* زر التعديل */
    /* ========================================================= */

    .btn-orange .fa {
        font-size: 12px;
    }

</style>