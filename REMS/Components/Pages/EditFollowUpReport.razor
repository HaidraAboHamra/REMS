@page "/followup-report/{id:int}"

@using REMS.Enititys
@using REMS.Interfaces

@inject IFollowUpReportService Service
@inject NavigationManager Navigation
@inject UserService UserRepo
@inject IHttpContextAccessor HttpContextAccessor

@attribute [Authorize(Roles = "Manager,Admin,Admin1,FUser")]

<div class="update-page" dir="rtl">

    <!-- Ambient background -->
    <div class="update-orb orb-one"></div>
    <div class="update-orb orb-two"></div>
    <div class="update-orb orb-three"></div>

    <div class="update-grid"></div>
    <div class="update-scan"></div>


    @if (report == null)
    {
        <div class="loading-state">

            <div class="loader-ring">
                <div class="loader-core"></div>
            </div>

            <strong>جاري تحميل المهمة...</strong>

            <span>HEMS TASK ENGINE</span>

        </div>
    }
    else
    {
        <main class="update-content">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <section class="update-header">

                <div class="header-glow"></div>
                <div class="header-scan"></div>

                <div class="header-left">

                    <div class="header-icon">
                        ✏️
                    </div>

                    <div>

                        <span class="header-kicker">
                            HEX STUDIO • HEMS
                        </span>

                        <h1>
                            تحديث المهمة
                        </h1>

                        <p>
                            متابعة تقدم المهمة وإضافة آخر التحديثات
                        </p>

                    </div>

                </div>

                <div class="header-status">

                    <span class="status-live-dot"></span>

                    LIVE

                </div>

            </section>


            <!-- =====================================================
                 MAIN GRID
                 ===================================================== -->

            <section class="update-layout">

                <!-- =================================================
                     LEFT / MAIN
                     ================================================= -->

                <div class="main-column">

                    <!-- Task card -->
                    <section class="task-card">

                        <div class="card-top-line"></div>

                        <div class="task-heading">

                            <div class="task-heading-icon">
                                📋
                            </div>

                            <div>

                                <span class="task-label">
                                    المهمة الحالية
                                </span>

                                <h2>
                                    @report.Content
                                </h2>

                                <p>
                                    @report.TaskDetails
                                </p>

                            </div>

                        </div>


                        <!-- =========================
                             Statistics
                             ========================= -->

                        <div class="stats-grid">

                            <div class="stat-card total-stat">

                                <div class="stat-icon">
                                    📦
                                </div>

                                <div class="stat-content">

                                    <span>
                                        إجمالي البنود
                                    </span>

                                    <strong>
                                        @report.TotalItems
                                    </strong>

                                </div>

                            </div>


                            <div class="stat-card completed-stat">

                                <div class="stat-icon">
                                    ✅
                                </div>

                                <div class="stat-content">

                                    <span>
                                        المنجز
                                    </span>

                                    <strong>
                                        @report.CompletedItems
                                    </strong>

                                </div>

                            </div>


                            <div class="stat-card remaining-stat">

                                <div class="stat-icon">
                                    ⏳
                                </div>

                                <div class="stat-content">

                                    <span>
                                        المتبقي
                                    </span>

                                    <strong>
                                        @report.RemainingItems
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- =========================
                             Progress
                             ========================= -->

                        <div class="progress-section">

                            <div class="progress-heading">

                                <div>
                                    <span>
                                        نسبة الإنجاز
                                    </span>

                                    <small>
                                        التقدم الحالي للمهمة
                                    </small>
                                </div>

                                <strong>
                                    @report.ProgressPercentage%
                                </strong>

                            </div>


                            <div class="premium-progress">

                                <div class="premium-progress-bar"
                                     style="width:@($"{report.ProgressPercentage}%")">

                                    <div class="progress-shine"></div>

                                </div>

                            </div>

                        </div>


                        <!-- =========================
                             Update Form
                             ========================= -->

                        <div class="form-section">

                            <div class="section-heading">

                                <div class="section-heading-icon">
                                    ⚡
                                </div>

                                <div>

                                    <strong>
                                        إضافة تحديث
                                    </strong>

                                    <span>
                                        سجل ما تم إنجازه في هذه المرحلة
                                    </span>

                                </div>

                            </div>


                            @if (report?.IsDone == true)
                            {
                                <div class="form-section completed-lock" role="status">
                                    هذه المهمة مكتملة ولا يمكن تعديلها.
                                </div>
                            }
                            else
                            {
                            <EditForm Model="updateVm"
                                      OnValidSubmit="SaveUpdate">

                                <DataAnnotationsValidator />


                                <!-- Completed -->
                                <div class="field-group">

                                    <label class="form-label">

                                        <span class="label-icon">
                                            ✅
                                        </span>

                                        عدد الأمور المنجزة الآن

                                    </label>

                                    <div class="input-wrapper">

                                        <InputNumber class="premium-input"
                                                     @bind-Value="updateVm.CompletedItems" />

                                    </div>

                                </div>


                                <!-- Details -->
                                <div class="field-group">

                                    <label class="form-label">

                                        <span class="label-icon">
                                            📝
                                        </span>

                                        ما تم إنجازه

                                    </label>

                                    <div class="textarea-wrapper">

                                        <InputTextArea class="premium-input premium-textarea"
                                                       rows="5"
                                                       @bind-Value="updateVm.CompletedDetails"
                                                       placeholder="اكتب فقط ما تم إنجازه..." />

                                    </div>

                                </div>


                                <!-- Notes -->
                                <div class="field-group">

                                    <label class="form-label">

                                        <span class="label-icon">
                                            💡
                                        </span>

                                        ملاحظات

                                    </label>

                                    <div class="textarea-wrapper">

                                        <InputTextArea class="premium-input premium-textarea notes-input"
                                                       rows="3"
                                                       @bind-Value="updateVm.Notes"
                                                       placeholder="أضف ملاحظات إضافية..." />

                                    </div>

                                </div>


                                <!-- Actions -->
                                <div class="form-actions">

                                    <button class="save-btn"
                                            type="submit">

                                        <span class="save-icon">
                                            💾
                                        </span>

                                        <span>
                                            حفظ التحديث
                                        </span>

                                        <span class="save-arrow">
                                            ←
                                        </span>

                                        <span class="button-shine"></span>

                                    </button>


                                    <button type="button"
                                            class="back-btn"
                                            @onclick="@(() => Navigation.NavigateTo("/followupreport"))">

                                        <span>
                                            ←
                                        </span>

                                        رجوع

                                    </button>

                                </div>

                            </EditForm>
                            }

                        </div>

                    </section>

                </div>


                <!-- =================================================
                     RIGHT / HISTORY
                     ================================================= -->

                <aside class="history-column">

                    <section class="history-card">

                        <div class="card-top-line"></div>

                        <div class="history-header">

                            <div class="history-title-icon">
                                🕘
                            </div>

                            <div>

                                <strong>
                                    سجل التحديثات
                                </strong>

                                <span>
                                    آخر التغييرات على المهمة
                                </span>

                            </div>

                        </div>


                        @if (updates.Count == 0)
                        {
                            <div class="empty-history">

                                <div class="empty-history-icon">
                                    📭
                                </div>

                                <strong>
                                    لا توجد تحديثات
                                </strong>

                                <span>
                                    لم يتم تسجيل أي تحديث لهذه المهمة بعد.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="timeline">

                                @foreach (var item in updates)
                                {
                                    <div class="timeline-item">

                                        <div class="timeline-dot"></div>

                                        <div class="timeline-line"></div>

                                        <div class="update-card">

                                            <div class="update-card-header">

                                                <strong>
                                                    @item.Status
                                                </strong>

                                                <span class="timeline-date">
                                                    @item.DateTime.ToString("yyyy-MM-dd HH:mm")
                                                </span>

                                            </div>


                                            <div class="history-metrics">

                                                <span class="history-metric completed-metric">
                                                    <b>@item.CompletedItems</b>
                                                    /
                                                    @report.TotalItems
                                                </span>

                                                <span class="history-metric progress-metric">
                                                    @item.ProgressPercentage%
                                                </span>

                                            </div>


                                            @if (!string.IsNullOrWhiteSpace(item.CompletedDetails))
                                            {
                                                <p class="update-description">
                                                    @item.CompletedDetails
                                                </p>
                                            }


                                            <div class="updated-by">

                                                <span class="mini-avatar">
                                                    👤
                                                </span>

                                                <span>
                                                    @item.UpdatedBy
                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </section>

                </aside>

            </section>

        </main>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private FollowUpReport? report;

    private List<FollowUpReportUpdate>
        updates = new();


    private User User { get; set; } = new();


    private UpdateVm updateVm = new();


    protected override async Task OnInitializedAsync()
    {
        report = await Service.Get(Id);

        if (report != null)
        {
            updateVm.CompletedItems =
                report.CompletedItems;

            updateVm.CompletedDetails =
                report.CompletedDetails ?? "";
        }

        updates =
            await Service.GetUpdates(Id);


        try
        {
            var idClaim =
                HttpContextAccessor.HttpContext?
                .User?.Claims?
                .FirstOrDefault(
                    c => c.Type == "Id"
                )?.Value;

            if (!string.IsNullOrEmpty(idClaim) &&
                int.TryParse(idClaim, out var uid))
            {
                var result =
                    await UserRepo.GetById(uid);

                if (result.IsSuccess)
                    User = result.Value;
            }
        }
        catch
        {
        }
    }


    private async Task SaveUpdate()
    {
        if (report == null)
            return;

        if (report.IsDone)
            return;


        if (updateVm.CompletedItems < 0 ||
            updateVm.CompletedItems > report.TotalItems)
        {
            return;
        }


        report.CompletedItems =
            updateVm.CompletedItems;

        report.CompletedDetails =
            updateVm.CompletedDetails;

        report.LastUpdatedBy =
            User?.FullName ?? "";


        await Service.Update(report);


        updates =
            await Service.GetUpdates(Id);


        updateVm =
            new UpdateVm
            {
                CompletedItems =
                    report.CompletedItems,

                CompletedDetails = ""
            };
    }


    private class UpdateVm
    {
        public int CompletedItems { get; set; }

        public string CompletedDetails { get; set; }
            = string.Empty;

        public string Notes { get; set; }
            = string.Empty;
    }
}


