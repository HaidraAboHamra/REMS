@page "/register"
@using REMS.Enititys
@inject UserService UserService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Manager,Admin,Admin1")]

<div class="register-page">

    <!-- Ambient background -->
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>

    <!-- Animated grid -->
    <div class="register-grid"></div>

    <!-- Main card -->
    <section class="register-card">

        <!-- Header -->
        <header class="register-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-content">

                <div class="header-icon">
                    <span>👤</span>
                </div>

                <div>
                    <span class="header-kicker">
                        HEX STUDIO • USER MANAGEMENT
                    </span>

                    <h3>إنشاء حساب جديد</h3>

                    <p>
                        إنشاء حساب مستخدم جديد وإدارة صلاحياته بكل سهولة
                    </p>
                </div>

            </div>

        </header>


        <!-- Body -->
        <div class="register-body">

            <div class="body-glow"></div>

            @if (registrationFailed)
            {
                <div class="register-alert alert-danger">
                    <div class="alert-icon">⚠</div>

                    <div>
                        <strong>فشل إنشاء الحساب</strong>
                        <span>حدث خطأ أثناء إنشاء الحساب. حاول مرة أخرى.</span>
                    </div>
                </div>
            }


            <EditForm Model="Users" OnValidSubmit="HandleRegister">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <!-- =========================
                     البيانات الأساسية
                     ========================= -->

                <div class="section-title">
                    <span class="section-line"></span>
                    <span>البيانات الأساسية</span>
                </div>


                <div class="form-grid">

                    <!-- الاسم الكامل -->
                    <div class="field-group">

                        <label for="fullName" class="form-label">
                            الاسم الكامل
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                👤
                            </span>

                            <InputText id="fullName"
                                       class="form-control premium-input"
                                       @bind-Value="Users.FullName"
                                       placeholder="أدخل الاسم الكامل" />

                        </div>

                    </div>


                    <!-- البريد -->
                    <div class="field-group">

                        <label for="email" class="form-label">
                            البريد الإلكتروني
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ✉️
                            </span>

                            <InputText id="email"
                                       class="form-control premium-input"
                                       @bind-Value="Users.Email"
                                       placeholder="example@domain.com" />

                        </div>

                    </div>


                    <!-- كلمة المرور -->
                    <div class="field-group">

                        <label for="password" class="form-label">
                            كلمة المرور
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                🔐
                            </span>

                            <InputText id="password"
                                       type="password"
                                       class="form-control premium-input"
                                       @bind-Value="Users.PasswordHash"
                                       placeholder="أدخل كلمة المرور" />

                        </div>

                    </div>


                    <!-- الهاتف -->
                    <div class="field-group">

                        <label for="phoneNumber" class="form-label">
                            رقم الهاتف
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                📱
                            </span>

                            <InputText id="phoneNumber"
                                       class="form-control premium-input"
                                       @bind-Value="Users.PhoneNumber"
                                       placeholder="أدخل رقم الهاتف" />

                        </div>

                    </div>


                    <!-- Telegram username: the actual chat is linked safely from the profile page. -->
                    <div class="field-group">

                        <label for="telegramUsername" class="form-label">
                            اسم مستخدم تيليغرام
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                💬
                            </span>

                            <InputText id="telegramUsername"
                                       class="form-control premium-input"
                                       @bind-Value="Users.TelegramUsername"
                                       placeholder="username (اختياري)" />

                        </div>

                    </div>

                </div>


                <!-- =========================
                     الصلاحيات
                     ========================= -->

                <div class="section-title permissions-title">
                    <span class="section-line"></span>
                    <span>الصلاحيات</span>
                </div>


                <div class="permissions-grid">

                    <!-- Manager -->
                    <AuthorizeView Context="IsAdminContext" Roles="Manager">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isProgramAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsAdmin" />

                                <div class="permission-icon manager-icon">
                                    👑
                                </div>

                                <div class="permission-content">
                                    <strong>مدير البرنامج</strong>
                                    <span>صلاحيات الإدارة العامة للنظام</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>


                            <label class="permission-card">

                                <InputCheckbox id="isItAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsItAdmin" />

                                <div class="permission-icon it-icon">
                                    💻
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم البرمجة</strong>
                                    <span>إدارة وصلاحيات قسم البرمجة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>


                            <label class="permission-card">

                                <InputCheckbox id="isFollowUpAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsFollowUpAdmin" />

                                <div class="permission-icon followup-icon">
                                    📊
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم المتابعة</strong>
                                    <span>إدارة وصلاحيات قسم المتابعة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>


                    <!-- Admin -->
                    <AuthorizeView Context="IsAdminContext" Roles="Admin">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isFollowUpAdminAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsFollowUpAdmin" />

                                <div class="permission-icon followup-icon">
                                    📊
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم المتابعة</strong>
                                    <span>إدارة وصلاحيات قسم المتابعة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>


                    <!-- Admin1 -->
                    <AuthorizeView Context="IsAdminContext" Roles="Admin1">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isItAdminAdmin1"
                                               class="permission-check"
                                               @bind-Value="Users.IsItAdmin" />

                                <div class="permission-icon it-icon">
                                    💻
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم البرمجة</strong>
                                    <span>إدارة وصلاحيات قسم البرمجة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>

                </div>


                <!-- =========================
                     Submit
                     ========================= -->

                <div class="form-actions">

                    <button type="submit" class="submit-btn">

                        <span class="submit-icon">
                            ✨
                        </span>

                        <span>
                            إنشاء الحساب
                        </span>

                        <span class="submit-arrow">
                            ←
                        </span>

                        <span class="submit-shine"></span>

                    </button>

                </div>

            </EditForm>

        </div>

    </section>

</div>


@code {
    private User Users = new User();
    private bool registrationFailed = false;

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationState { get; set; }

    protected async override Task OnParametersSetAsync()
    {
        var state = await AuthenticationState;

        Users.IsFUser = state.User.IsInRole("Admin");

        await base.OnParametersSetAsync();
    }

    private async Task HandleRegister()
    {
        try
        {
            await UserService.CreateUserAsync(Users);

            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception)
        {
            registrationFailed = true;
        }
    }
}



