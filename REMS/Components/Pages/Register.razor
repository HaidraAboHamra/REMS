@page "/register"
@using REMS.Enititys
@inject UserService UserService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Manager,Admin,Admin1")]

<div class="register-page">

    <!-- Ambient background -->
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <div class="ambient ambient-three"></div>

    <!-- Animated grid -->
    <div class="register-grid"></div>

    <!-- Main card -->
    <section class="register-card">

        <!-- Header -->
        <header class="register-header">

            <div class="header-glow"></div>
            <div class="header-scan"></div>

            <div class="header-content">

                <div class="header-icon">
                    <span>👤</span>
                </div>

                <div>
                    <span class="header-kicker">
                        HEX STUDIO • USER MANAGEMENT
                    </span>

                    <h3>إنشاء حساب جديد</h3>

                    <p>
                        إنشاء حساب مستخدم جديد وإدارة صلاحياته بكل سهولة
                    </p>
                </div>

            </div>

        </header>


        <!-- Body -->
        <div class="register-body">

            <div class="body-glow"></div>

            @if (registrationFailed)
            {
                <div class="register-alert alert-danger">
                    <div class="alert-icon">⚠</div>

                    <div>
                        <strong>فشل إنشاء الحساب</strong>
                        <span>حدث خطأ أثناء إنشاء الحساب. حاول مرة أخرى.</span>
                    </div>
                </div>
            }


            <EditForm Model="Users" OnValidSubmit="HandleRegister">

                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />


                <!-- =========================
                     البيانات الأساسية
                     ========================= -->

                <div class="section-title">
                    <span class="section-line"></span>
                    <span>البيانات الأساسية</span>
                </div>


                <div class="form-grid">

                    <!-- الاسم الكامل -->
                    <div class="field-group">

                        <label for="fullName" class="form-label">
                            الاسم الكامل
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                👤
                            </span>

                            <InputText id="fullName"
                                       class="form-control premium-input"
                                       @bind-Value="Users.FullName"
                                       placeholder="أدخل الاسم الكامل" />

                        </div>

                    </div>


                    <!-- البريد -->
                    <div class="field-group">

                        <label for="email" class="form-label">
                            البريد الإلكتروني
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ✉️
                            </span>

                            <InputText id="email"
                                       class="form-control premium-input"
                                       @bind-Value="Users.Email"
                                       placeholder="example@domain.com" />

                        </div>

                    </div>


                    <!-- كلمة المرور -->
                    <div class="field-group">

                        <label for="password" class="form-label">
                            كلمة المرور
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                🔐
                            </span>

                            <InputText id="password"
                                       type="password"
                                       class="form-control premium-input"
                                       @bind-Value="Users.PasswordHash"
                                       placeholder="أدخل كلمة المرور" />

                        </div>

                    </div>


                    <!-- الهاتف -->
                    <div class="field-group">

                        <label for="phoneNumber" class="form-label">
                            رقم الهاتف
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                📱
                            </span>

                            <InputText id="phoneNumber"
                                       class="form-control premium-input"
                                       @bind-Value="Users.PhoneNumber"
                                       placeholder="أدخل رقم الهاتف" />

                        </div>

                    </div>


                    <!-- Telegram -->
                    <div class="field-group">

                        <label for="chatId" class="form-label">
                            Telegram ChatId
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                💬
                            </span>

                            <InputNumber id="chatId"
                                         class="form-control premium-input"
                                         @bind-Value="Users.ChatId"
                                         placeholder="Telegram ChatId" />

                        </div>

                    </div>

                </div>


                <!-- =========================
                     الصلاحيات
                     ========================= -->

                <div class="section-title permissions-title">
                    <span class="section-line"></span>
                    <span>الصلاحيات</span>
                </div>


                <div class="permissions-grid">

                    <!-- Manager -->
                    <AuthorizeView Context="IsAdminContext" Roles="Manager">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isProgramAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsAdmin" />

                                <div class="permission-icon manager-icon">
                                    👑
                                </div>

                                <div class="permission-content">
                                    <strong>مدير البرنامج</strong>
                                    <span>صلاحيات الإدارة العامة للنظام</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>


                            <label class="permission-card">

                                <InputCheckbox id="isItAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsItAdmin" />

                                <div class="permission-icon it-icon">
                                    💻
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم البرمجة</strong>
                                    <span>إدارة وصلاحيات قسم البرمجة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>


                            <label class="permission-card">

                                <InputCheckbox id="isFollowUpAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsFollowUpAdmin" />

                                <div class="permission-icon followup-icon">
                                    📊
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم المتابعة</strong>
                                    <span>إدارة وصلاحيات قسم المتابعة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>


                    <!-- Admin -->
                    <AuthorizeView Context="IsAdminContext" Roles="Admin">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isFollowUpAdminAdmin"
                                               class="permission-check"
                                               @bind-Value="Users.IsFollowUpAdmin" />

                                <div class="permission-icon followup-icon">
                                    📊
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم المتابعة</strong>
                                    <span>إدارة وصلاحيات قسم المتابعة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>


                    <!-- Admin1 -->
                    <AuthorizeView Context="IsAdminContext" Roles="Admin1">
                        <Authorized>

                            <label class="permission-card">

                                <InputCheckbox id="isItAdminAdmin1"
                                               class="permission-check"
                                               @bind-Value="Users.IsItAdmin" />

                                <div class="permission-icon it-icon">
                                    💻
                                </div>

                                <div class="permission-content">
                                    <strong>ادمن قسم البرمجة</strong>
                                    <span>إدارة وصلاحيات قسم البرمجة</span>
                                </div>

                                <div class="permission-glow"></div>

                            </label>

                        </Authorized>
                    </AuthorizeView>

                </div>


                <!-- =========================
                     Submit
                     ========================= -->

                <div class="form-actions">

                    <button type="submit" class="submit-btn">

                        <span class="submit-icon">
                            ✨
                        </span>

                        <span>
                            إنشاء الحساب
                        </span>

                        <span class="submit-arrow">
                            ←
                        </span>

                        <span class="submit-shine"></span>

                    </button>

                </div>

            </EditForm>

        </div>

    </section>

</div>


@code {
    private User Users = new User();
    private bool registrationFailed = false;

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationState { get; set; }

    protected async override Task OnParametersSetAsync()
    {
        var state = await AuthenticationState;

        Users.IsFUser = state.User.IsInRole("Admin");

        await base.OnParametersSetAsync();
    }

    private async Task HandleRegister()
    {
        try
        {
            await UserService.CreateUserAsync(Users);

            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception)
        {
            registrationFailed = true;
        }
    }
}


<style>

    /* =========================================================
           HEMS REGISTER PAGE
           ========================================================= */

    .register-page {
        position: relative;
        min-height: 100vh;
        padding: clamp(18px, 3vw, 40px);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient( circle at 82% 8%, rgba(67, 56, 202, 0.23), transparent 26% ), radial-gradient( circle at 15% 90%, rgba(29, 78, 216, 0.16), transparent 25% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        color: #f8fafc;
    }


    /* =========================================================
           GRID
           ========================================================= */

    .register-grid {
        position: absolute;
        inset: 0;
        z-index: -3;
        pointer-events: none;
        background: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
        background-size: 42px 42px;
        mask-image: linear-gradient( to bottom, black, transparent 92% );
        animation: gridMove 22s linear infinite;
    }


    .register-page::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background: radial-gradient( circle at center, transparent 0%, rgba(2,2,8,.18) 48%, rgba(2,2,8,.58) 100% );
    }


    /* =========================================================
           AMBIENT
           ========================================================= */

    .ambient {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        filter: blur(8px);
        mix-blend-mode: screen;
        z-index: -1;
    }


    .ambient-one {
        width: 300px;
        height: 300px;
        top: -90px;
        right: -70px;
        background: radial-gradient( circle, rgba(99,102,241,.34), transparent 68% );
        animation: ambientOne 10s ease-in-out infinite;
    }


    .ambient-two {
        width: 340px;
        height: 340px;
        bottom: -120px;
        left: -120px;
        background: radial-gradient( circle, rgba(37,99,235,.24), transparent 68% );
        animation: ambientTwo 13s ease-in-out infinite;
    }


    .ambient-three {
        width: 200px;
        height: 200px;
        top: 48%;
        left: 48%;
        background: radial-gradient( circle, rgba(129,140,248,.14), transparent 66% );
        animation: ambientThree 6s ease-in-out infinite;
    }


    /* =========================================================
           CARD
           ========================================================= */

    .register-card {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
        border: 1px solid rgba(129,140,248,.20);
        border-radius: 28px;
        overflow: hidden;
        background: rgba(8,9,18,.82);
        box-shadow: 0 24px 80px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.025) inset, 0 0 55px rgba(67,56,202,.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        animation: cardReveal .75s cubic-bezier(.2,.75,.2,1) both;
    }


        .register-card::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient( 120deg, rgba(255,255,255,.05), transparent 30%, transparent 70%, rgba(99,102,241,.10) );
        }


    /* =========================================================
           HEADER
           ========================================================= */

    .register-header {
        position: relative;
        overflow: hidden;
        padding: 30px clamp(22px,4vw,44px);
        color: #f8fafc;
        background: radial-gradient( circle at 85% 10%, rgba(129,140,248,.28), transparent 28% ), linear-gradient( 135deg, #020204 0%, #0a0a14 48%, #171449 100% );
        border-bottom: 1px solid rgba(129,140,248,.16);
    }


    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 18px;
    }


    .header-icon {
        width: 62px;
        height: 62px;
        flex: 0 0 62px;
        display: grid;
        place-items: center;
        border-radius: 19px;
        font-size: 1.7rem;
        background: linear-gradient( 145deg, rgba(99,102,241,.95), rgba(30,64,175,.75) );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 28px rgba(99,102,241,.22) inset;
        animation: iconPulse 3.5s ease-in-out infinite;
    }


    .header-kicker {
        display: block;
        margin-bottom: 5px;
        color: #a5b4fc;
        font-family: "Space Grotesk", sans-serif;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .24em;
        text-transform: uppercase;
    }


    .register-header h3 {
        margin: 0;
        font-family: "Unbounded", "Space Grotesk", sans-serif;
        font-size: clamp( 1.25rem, 2.5vw, 1.9rem );
        font-weight: 500;
        line-height: 1.3;
    }


    .register-header p {
        margin: 7px 0 0;
        color: rgba(226,232,240,.68);
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .86rem;
    }


    .header-glow {
        position: absolute;
        top: -120px;
        right: 12%;
        width: 340px;
        height: 220px;
        background: radial-gradient( circle, rgba(99,102,241,.30), transparent 65% );
        filter: blur(10px);
        animation: headerGlow 6s ease-in-out infinite;
    }


    .header-scan {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        transform: skewX(-22deg);
        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.09), transparent );
        animation: headerScan 6.5s ease-in-out infinite;
    }


    /* =========================================================
           BODY
           ========================================================= */

    .register-body {
        position: relative;
        padding: clamp(20px,3vw,38px);
        color: #e5e7eb;
        background: radial-gradient( circle at 12% 20%, rgba(67,56,202,.10), transparent 28% ), linear-gradient( 180deg, rgba(9,10,18,.98), rgba(7,8,15,.96) );
    }


    .body-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient( circle at 50% -20%, rgba(99,102,241,.12), transparent 45% );
    }


    .register-body > * {
        position: relative;
        z-index: 2;
    }


    /* =========================================================
           ALERT
           ========================================================= */

    .register-alert {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        margin-bottom: 24px;
        border-radius: 15px;
        border: 1px solid rgba(248,113,113,.24);
        background: rgba(127,29,29,.16);
        color: #fecaca;
        box-shadow: 0 10px 30px rgba(0,0,0,.14);
        animation: alertReveal .45s ease both;
    }


        .register-alert strong {
            display: block;
            font-family: "Space Grotesk", sans-serif;
            margin-bottom: 3px;
        }


        .register-alert span {
            display: block;
            font-size: .82rem;
            opacity: .82;
        }


    .alert-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: rgba(248,113,113,.12);
        color: #fca5a5;
        font-weight: 900;
    }


    /* =========================================================
           SECTION TITLE
           ========================================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 3px 0 20px;
        color: #c7d2fe;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .88rem;
        font-weight: 800;
    }


    .section-line {
        width: 34px;
        height: 2px;
        border-radius: 999px;
        background: linear-gradient( 90deg, #6366f1, transparent );
        box-shadow: 0 0 10px rgba(99,102,241,.38);
    }


    .permissions-title {
        margin-top: 32px;
    }


    /* =========================================================
           FORM GRID
           ========================================================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0,1fr) );
        gap: 22px;
        margin-bottom: 8px;
    }


    .field-group {
        animation: fieldReveal .55s cubic-bezier(.2,.7,.2,1) both;
    }


        .field-group:nth-child(1) {
            animation-delay: .04s;
        }

        .field-group:nth-child(2) {
            animation-delay: .08s;
        }

        .field-group:nth-child(3) {
            animation-delay: .12s;
        }

        .field-group:nth-child(4) {
            animation-delay: .16s;
        }

        .field-group:nth-child(5) {
            animation-delay: .20s;
        }


    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #e2e8f0;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .88rem;
        font-weight: 700;
    }


    .required {
        color: #f472b6;
        margin-right: 4px;
        text-shadow: 0 0 8px rgba(244,114,182,.45);
    }


    /* =========================================================
           INPUTS
           ========================================================= */

    .input-wrapper {
        position: relative;
    }


    .input-icon {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        z-index: 3;
        font-family: "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif;
        font-size: 1rem;
        pointer-events: none;
        opacity: .72;
    }


    .premium-input {
        min-height: 48px;
        padding-right: 46px !important;
        color: #f8fafc !important;
        background-color: rgba(15,17,29,.90) !important;
        border: 1px solid rgba(129,140,248,.20) !important;
        border-radius: 14px !important;
        box-shadow: 0 4px 14px rgba(0,0,0,.18) inset, 0 4px 18px rgba(0,0,0,.12);
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease, background-color .25s ease;
    }


        .premium-input::placeholder {
            color: rgba(148,163,184,.42) !important;
        }


        .premium-input:hover {
            border-color: rgba(129,140,248,.40) !important;
            transform: translateY(-1px);
        }


        .premium-input:focus {
            border-color: rgba(99,102,241,.95) !important;
            background-color: rgba(17,19,34,.98) !important;
            box-shadow: 0 0 0 3px rgba(99,102,241,.13), 0 0 30px rgba(79,70,229,.12), 0 8px 24px rgba(0,0,0,.20) !important;
            transform: translateY(-2px);
            outline: none;
        }


    /* =========================================================
           VALIDATION
           ========================================================= */

    .validation-summary {
        margin: 0 0 20px;
        padding: 13px 15px;
        border: 1px solid rgba(248,113,113,.24);
        border-radius: 14px;
        background: rgba(127,29,29,.16);
        color: #fecaca;
    }


    .field-group:deep(.validation-message) {
        color: #fca5a5;
        font-size: .78rem;
        margin-top: 6px;
    }


    /* =========================================================
           PERMISSIONS
           ========================================================= */

    .permissions-grid {
        display: grid;
        grid-template-columns: repeat( 3, minmax(0,1fr) );
        gap: 16px;
    }


    .permission-card {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 88px;
        padding: 14px;
        border-radius: 17px;
        border: 1px solid rgba(129,140,248,.16);
        background: linear-gradient( 135deg, rgba(30,41,59,.42), rgba(49,46,129,.14) );
        box-shadow: 0 10px 28px rgba(0,0,0,.16);
        cursor: pointer;
        transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease, background .28s ease;
    }


        .permission-card:hover {
            transform: translateY(-3px);
            border-color: rgba(129,140,248,.34);
            background: linear-gradient( 135deg, rgba(30,41,59,.62), rgba(49,46,129,.25) );
            box-shadow: 0 16px 34px rgba(0,0,0,.24), 0 0 24px rgba(67,56,202,.10);
        }


    .permission-check {
        position: absolute;
        top: 12px;
        left: 12px;
        width: 18px;
        height: 18px;
        accent-color: #6366f1;
    }


    .permission-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        font-size: 1.2rem;
        background: rgba(99,102,241,.12);
        border: 1px solid rgba(129,140,248,.16);
        box-shadow: inset 0 0 18px rgba(99,102,241,.07);
    }


    .manager-icon {
        color: #fde68a;
    }


    .it-icon {
        color: #93c5fd;
    }


    .followup-icon {
        color: #a5b4fc;
    }


    .permission-content {
        min-width: 0;
        padding-left: 18px;
    }


        .permission-content strong {
            display: block;
            color: #f8fafc;
            font-family: "Space Grotesk", "Segoe UI", sans-serif;
            font-size: .82rem;
            font-weight: 800;
        }


        .permission-content span {
            display: block;
            margin-top: 4px;
            color: rgba(165,180,252,.52);
            font-size: .67rem;
            line-height: 1.45;
        }


    .permission-glow {
        position: absolute;
        width: 120px;
        height: 120px;
        right: -55px;
        bottom: -55px;
        border-radius: 50%;
        background: radial-gradient( circle, rgba(99,102,241,.12), transparent 68% );
        pointer-events: none;
    }


    /* =========================================================
           BUTTON
           ========================================================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid rgba(129,140,248,.10);
    }


    .submit-btn {
        position: relative;
        overflow: hidden;
        min-width: 230px;
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        padding: 12px 22px;
        border: 1px solid rgba(165,180,252,.24);
        border-radius: 15px;
        color: #fff;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: .94rem;
        font-weight: 800;
        background: linear-gradient( 120deg, #111827 0%, #312e81 45%, #4338ca 100% );
        box-shadow: 0 12px 30px rgba(49,46,129,.34), 0 0 0 1px rgba(255,255,255,.04) inset;
        cursor: pointer;
        transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }


        .submit-btn:hover {
            transform: translateY(-3px) scale(1.01);
            filter: brightness(1.08);
            box-shadow: 0 18px 38px rgba(49,46,129,.46), 0 0 30px rgba(99,102,241,.18);
        }


    .submit-icon {
        position: relative;
