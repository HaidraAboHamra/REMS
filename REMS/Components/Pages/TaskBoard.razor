@page "/Tasks-m"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using REMS.Enititys
@using REMS.Interfaces
@using System.Security.Claims
@attribute [Authorize]
@inject IFollowUpReportService ReportService

<PageTitle>لوحة المهام | REMS</PageTitle>

<section class="task-board" dir="rtl">
    <header class="board-header">
        <div>
            <span class="eyebrow">REMS • TASK CENTER</span>
            <h1>لوحة المهام</h1>
            <p>نظرة واضحة للمهام المعلقة، قيد الإنجاز، والمتأخرة.</p>
        </div>
        <button class="refresh" @onclick="LoadAsync" disabled="@IsLoading">↻ تحديث</button>
    </header>

    @if (IsLoading)
    {
        <div class="state">جارٍ تحميل المهام…</div>
    }
    else
    {
        <div class="summary" aria-label="ملخص حالات المهام">
            <button class="summary-card pending @(SelectedStatus == "معلقة" ? "selected" : "")" @onclick="ShowPending">
                <span>معلقة</span><strong>@PendingCount</strong>
            </button>
            <button class="summary-card in-progress @(SelectedStatus == "قيد التنفيذ" ? "selected" : "")" @onclick="ShowInProgress">
                <span>قيد الإنجاز</span><strong style="color:#facc15">@InProgressCount</strong>
            </button>
            <button class="summary-card overdue @(SelectedStatus == "متأخرة" ? "selected" : "")" @onclick="ShowOverdue">
                <span>متأخرة</span><strong>@OverdueCount</strong>
            </button>
            <button class="summary-card complete @(SelectedStatus == "مكتملة" ? "selected" : "")" @onclick="ShowCompleted">
                <span>مكتملة</span><strong>@CompletedCount</strong>
            </button>
        </div>

        <div class="toolbar">
            <input @bind="Search" @bind:event="oninput" placeholder="ابحث باسم المهمة أو المشروع أو الموظف…" aria-label="بحث المهام" />
            <button class="clear" @onclick="ClearFilters">عرض الكل</button>
        </div>

        @if (!VisibleReports.Any())
        {
            <div class="state">لا توجد مهام تطابق الفلتر الحالي.</div>
        }
        else
        {
            <div class="task-list">
                @foreach (var report in VisibleReports)
                {
                    var status = GetStatus(report);
                    <article class="task-card @StatusClass(status)">
                        <div class="task-card-top">
                            <div>
                                <span class="status">@status</span>
                                <h2>@report.Content</h2>
                                <p>@report.TaskDetails</p>
                            </div>
                            <span class="priority">@(report.Priority ?? "غير محددة")</span>
                        </div>
                        <div class="task-meta">
                            <span>👤 @(report.AssignedEmployee ?? "غير مسندة")</span>
                            <span>📁 @(report.ClientOrProject ?? "بدون مشروع")</span>
                            <span>📅 @(report.DueDate?.ToString("yyyy-MM-dd") ?? "لا يوجد موعد")</span>
                        </div>
                        <div class="progress-row">
                            <div class="bar"><span style="width:@($"{report.ProgressPercentage}%")"></span></div>
                            <strong>@report.ProgressPercentage% — @report.CompletedItems/@report.TotalItems</strong>
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>

@code {
    private List<FollowUpReport> Reports = [];
    private bool IsLoading = true;
    private bool IsAdministrator;
    private int CurrentUserId;
    private string? SelectedStatus;
    private string Search = string.Empty;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;
        IsAdministrator = state.User.IsInRole("Manager") || state.User.IsInRole("Admin") || state.User.IsInRole("Admin1");
        _ = int.TryParse(state.User.FindFirstValue("Id"), out CurrentUserId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Reports = await ReportService.GetReports(new ReportFilter
        {
            AssignedEmployeeId = IsAdministrator ? null : CurrentUserId
        });
        IsLoading = false;
    }

    private IEnumerable<FollowUpReport> VisibleReports => Reports.Where(report =>
        (string.IsNullOrWhiteSpace(SelectedStatus) || GetStatus(report) == SelectedStatus) &&
        (string.IsNullOrWhiteSpace(Search) || Matches(report, Search)));

    private int PendingCount => Reports.Count(x => GetStatus(x) == "معلقة");
    private int InProgressCount => Reports.Count(x => GetStatus(x) == "قيد التنفيذ");
    private int OverdueCount => Reports.Count(x => GetStatus(x) == "متأخرة");
    private int CompletedCount => Reports.Count(x => GetStatus(x) == "مكتملة");

    private static bool Matches(FollowUpReport report, string search) =>
        ($"{report.Content} {report.TaskDetails} {report.ClientOrProject} {report.AssignedEmployee}")
        .Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string GetStatus(FollowUpReport report) =>
        !report.IsDone && report.DueDate?.Date < DateTime.Today ? "متأخرة" :
        report.IsDone ? "مكتملة" :
        report.IsDoneOrNot == "قيد التنفيذ" ? "قيد التنفيذ" : "معلقة";

    private static string StatusClass(string status) => status switch
    {
        "متأخرة" => "is-overdue",
        "قيد التنفيذ" => "is-progress",
        "مكتملة" => "is-complete",
        _ => "is-pending"
    };

    private void SelectStatus(string status) => SelectedStatus = SelectedStatus == status ? null : status;
    private void ShowPending() => SelectStatus("معلقة");
    private void ShowInProgress() => SelectStatus("قيد التنفيذ");
    private void ShowOverdue() => SelectStatus("متأخرة");
    private void ShowCompleted() => SelectStatus("مكتملة");
    private void ClearFilters() { SelectedStatus = null; Search = string.Empty; }
}

<style>
    .task-board{max-width:1280px;margin:auto;padding:clamp(1rem,3vw,2.5rem);color:#e8edf9}.board-header{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin-bottom:1.5rem}.eyebrow{font-size:.68rem;letter-spacing:.18em;color:#93c5fd}.board-header h1{margin:.35rem 0;font-size:clamp(1.65rem,4vw,2.7rem)}.board-header p{margin:0;color:#aab6cf}.refresh,.clear,.summary-card{font:inherit;cursor:pointer}.refresh,.clear{border:1px solid #475569;border-radius:.75rem;padding:.7rem 1rem;color:#e8edf9;background:#172033}.refresh:hover,.clear:hover{background:#24324d}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.summary-card{display:flex;flex-direction:column;gap:.35rem;text-align:right;border:1px solid #334155;border-radius:1rem;padding:1rem;color:#cbd5e1;background:linear-gradient(135deg,#151d31,#0e1424);transition:transform .2s,border-color .2s}.summary-card:hover,.summary-card.selected{transform:translateY(-2px);border-color:#818cf8}.summary-card strong{font-size:1.9rem;color:white}.pending strong{color:#cbd5e1}.progress strong{color:#facc15}.overdue strong{color:#fb7185}.complete strong{color:#4ade80}.toolbar{display:flex;gap:.75rem;margin:1.5rem 0}.toolbar input{flex:1;min-width:0;border:1px solid #334155;border-radius:.75rem;padding:.75rem 1rem;color:white;background:#0d1424}.state{padding:3rem;text-align:center;border:1px dashed #475569;border-radius:1rem;color:#aab6cf}.task-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:1rem}.task-card{border:1px solid #334155;border-radius:1rem;padding:1rem;background:rgba(15,23,42,.8);box-shadow:0 12px 30px rgba(0,0,0,.15)}.task-card.is-overdue{border-color:rgba(251,113,133,.65)}.task-card.is-progress{border-color:rgba(250,204,21,.55)}.task-card.is-complete{border-color:rgba(74,222,128,.45)}.task-card-top{display:flex;justify-content:space-between;gap:1rem}.task-card h2{font-size:1.05rem;margin:.55rem 0}.task-card p{margin:0;color:#aab6cf;min-height:2.5rem}.status,.priority{height:max-content;border-radius:99px;padding:.25rem .55rem;font-size:.72rem;background:#26334a}.is-overdue .status{background:#4c1725;color:#fecdd3}.is-progress .status{background:#453812;color:#fef08a}.is-complete .status{background:#133c28;color:#bbf7d0}.task-meta{display:flex;flex-wrap:wrap;gap:.55rem;margin:1rem 0;color:#aab6cf;font-size:.78rem}.progress-row{display:flex;align-items:center;gap:.75rem;font-size:.76rem}.bar{overflow:hidden;flex:1;height:.5rem;border-radius:99px;background:#26334a}.bar span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#6366f1,#38bdf8);transition:width .4s}@@media(max-width:760px){.board-header{align-items:stretch;flex-direction:column}.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.toolbar{flex-direction:column}.clear,.refresh{width:100%}}@@media(prefers-reduced-motion:reduce){.summary-card,.bar span{transition:none}}
</style>
