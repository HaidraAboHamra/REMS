@page "/home"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using REMS.Enititys
@using REMS.Interfaces
@using System.Security.Claims
@inject IFollowUpReportService ReportService

<PageTitle>Dashboard</PageTitle>

<div class="hems-dashboard">

    <!-- Ambient Background -->
    <div class="dashboard-orb orb-one"></div>
    <div class="dashboard-orb orb-two"></div>
    <div class="dashboard-orb orb-three"></div>

    <!-- Animated Grid -->
    <div class="dashboard-grid"></div>

    <!-- Scan Line -->
    <div class="dashboard-scan"></div>

    <!-- Content -->
    <main class="dashboard-content">

        <section class="dashboard-hero">

            <div class="hero-glow"></div>

            <div class="hero-content">

                <span class="hero-kicker">
                    HEMS • HEX STUDIO
                </span>

                <h1>
                    لوحة التحكم
                    <span class="hero-accent">Dashboard</span>
                </h1>

                <p>
                    مرحباً بك في نظام REMS لإدارة ومتابعة الأعمال والمهام.
                </p>

            </div>

            <div class="hero-badge">
                <div class="hero-badge-core"></div>
            </div>

        </section>

        @if (_isLoading)
        {
            <section class="home-state" aria-live="polite">جارٍ تحميل ملخص المهام...</section>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <section class="home-state home-state-error" role="alert">@_loadError</section>
        }
        else
        {
            <section class="home-overview" aria-label="ملخص النظام">
                <div class="overview-card"><span>إجمالي المهام</span><strong>@Reports.Count</strong><small>المهام الظاهرة لك</small></div>
                <div class="overview-card"><span>قيد التنفيذ</span><strong>@InProgressCount</strong><small>تحتاج إلى متابعة</small></div>
                <div class="overview-card is-danger"><span>متأخرة</span><strong>@OverdueCount</strong><small>تحتاج إلى إجراء</small></div>
                <div class="overview-card is-success"><span>مكتملة</span><strong>@CompletedCount</strong><small>تم إنجازها</small></div>
            </section>
        }

        <section class="home-actions">
            <a href="/Tasks-m" class="home-action"><span>📊</span><div><strong>لوحة المهام</strong><small>استعرض الحالات والتقدم</small></div><b>←</b></a>
            <a href="/AddFollowUpReport" class="home-action"><span>➕</span><div><strong>إضافة مهمة</strong><small>أنشئ مهمة متابعة جديدة</small></div><b>←</b></a>
            <a href="/files" class="home-action"><span>📁</span><div><strong>الملفات</strong><small>الوصول إلى المستندات</small></div><b>←</b></a>
        </section>


        <!--
            ضع هنا محتوى الـ Dashboard الحالي
            إذا كان لديك Cards / Tables / Charts
        -->


    </main>

</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private List<FollowUpReport> Reports = [];
    private bool _isLoading = true;
    private string? _loadError;
    private int InProgressCount => Reports.Count(x => !x.IsDone && x.IsDoneOrNot == "قيد التنفيذ");
    private int OverdueCount => Reports.Count(x => !x.IsDone && x.DueDate?.Date < DateTime.Today);
    private int CompletedCount => Reports.Count(x => x.IsDone);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthenticationStateTask;
            _ = int.TryParse(state.User.FindFirstValue("Id"), out var userId);
            var isAdministrator = state.User.IsInRole("Manager") || state.User.IsInRole("Admin") || state.User.IsInRole("Admin1");
            Reports = await ReportService.GetReports(new ReportFilter { AssignedEmployeeId = isAdministrator ? null : userId });
        }
        catch (Exception)
        {
            _loadError = "تعذر تحميل بيانات لوحة التحكم. حاول تحديث الصفحة.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}


