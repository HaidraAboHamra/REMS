@page "/files"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using REMS.Data
@using REMS.Enititys
@using REMS.Services
@using System.Security.Claims
@using System.Security.Cryptography

@attribute [Authorize]

@inject AppDbContext Db
@inject FileStorageService Storage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Files - REMS</PageTitle>
<style>    /* Add this to wwwroot/css/rems-files.css and reference it from your app */
    .rems-drive {
        padding: 28px;
        max-width: 1450px;
        margin: 0 auto;
        color: #111827
    }

    .drive-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 22px
    }

    .drive-kicker {
        font-size: 11px;
        letter-spacing: .2em;
        font-weight: 800;
        opacity: .45
    }

    .drive-head h1 {
        font-size: 36px;
        line-height: 1;
        margin: 7px 0
    }

    .drive-head p {
        margin: 0;
        opacity: .55
    }

    .drive-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap
    }

    .drive-btn {
        border: 0;
        border-radius: 14px;
        padding: 11px 16px;
        font-weight: 800;
        cursor: pointer
    }

        .drive-btn.primary {
            background: #111827;
            color: #fff
        }

        .drive-btn.ghost {
            background: #f3f4f6
        }

    .drive-upload {
        position: relative;
        overflow: hidden
    }

        .drive-upload input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer
        }

    .drive-shell {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 16px
    }

    .drive-sidebar, .drive-main {
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(17,24,39,.07);
        border-radius: 24px
    }

    .drive-sidebar {
        padding: 14px;
        height: fit-content
    }

    .drive-sideitem {
        width: 100%;
        display: flex;
        gap: 10px;
        align-items: center;
        border: 0;
        background: transparent;
        padding: 11px 12px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        text-align: left
    }

        .drive-sideitem.active, .drive-sideitem:hover {
            background: #f3f4f6
        }

    .drive-main {
        padding: 18px;
        min-width: 0
    }

    .drive-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        justify-content: space-between;
        margin-bottom: 16px
    }

    .drive-search {
        flex: 1;
        max-width: 500px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        border-radius: 14px;
        padding: 11px 14px;
        outline: 0
    }

    .drive-breadcrumbs {
        display: flex;
        gap: 7px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px
    }

        .drive-breadcrumbs button {
            border: 0;
            background: transparent;
            font-weight: 800;
            cursor: pointer;
            padding: 0
        }

    .dropzone {
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        margin-bottom: 16px;
        background: #fafcff
    }

        .dropzone.drag {
            border-color: #111827;
            background: #f4f6f8
        }

        .dropzone small {
            opacity: .55
        }

    .drive-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(220px,1fr));
        gap: 12px
    }

    .drive-card {
        position: relative;
        border: 1px solid #eef0f3;
        border-radius: 18px;
        background: #fff;
        padding: 14px;
        min-height: 146px;
        cursor: pointer
    }

        .drive-card:hover {
            box-shadow: 0 10px 26px rgba(0,0,0,.06)
        }

        .drive-card .thumb {
            height: 78px;
            border-radius: 14px;
            background: #f8fafc;
            display: grid;
            place-items: center;
            font-size: 34px;
            overflow: hidden;
            margin-bottom: 10px
        }

        .drive-card img {
            width: 100%;
            height: 100%;
            object-fit: cover
        }

        .drive-card .name {
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .drive-card .sub {
            font-size: 12px;
            opacity: .5;
            margin-top: 4px
        }

    .drive-menu {
        position: absolute;
        right: 9px;
        top: 9px
    }

        .drive-menu button {
            border: 0;
            background: #fff;
            border-radius: 10px;
            padding: 5px 8px;
            cursor: pointer
        }

    .drive-empty {
        padding: 70px 20px;
        text-align: center;
        opacity: .55
    }

    .drive-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.38);
        display: grid;
        place-items: center;
        z-index: 5000;
        padding: 20px
    }

    .drive-modal {
        width: min(920px,95vw);
        max-height: 90vh;
        overflow: auto;
        background: #fff;
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 24px 90px rgba(0,0,0,.25)
    }

    .preview-stage {
        min-height: 420px;
        background: #0f172a;
        border-radius: 18px;
        display: grid;
        place-items: center;
        overflow: hidden
    }

        .preview-stage img, .preview-stage iframe, .preview-stage video {
            max-width: 100%;
            max-height: 68vh;
            border: 0
        }

    .share-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 10px;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #eef0f3
    }

    .share-input {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px
    }

    .share-link {
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px;
        word-break: break-all;
        font-size: 13px
    }
    @@media(max - width:900px)

    {
        .drive-shell {
            grid-template-columns: 1fr
        }

        .drive-sidebar {
            display: flex;
            overflow: auto
        }

        .drive-sideitem {
            white-space: nowrap
        }

        .drive-head {
            align-items: start;
            flex-direction: column
        }

        .drive-toolbar {
            align-items: stretch;
            flex-direction: column
        }

        .drive-search {
            max-width: none
        }

        .drive-grid {
            grid-template-columns: repeat(auto-fill,minmax(180px,1fr))
        }
    }
</style>
<div class="rems-drive">
    <div class="drive-head">
        <div>
            <div class="drive-kicker">REMS CLOUD STORAGE</div>
            <h1>Files</h1>
            <p>Your private workspace for files, folders and shared documents.</p>
        </div>
        <div class="drive-actions">
            <label class="drive-btn primary drive-upload">
                ＋ Upload
                <InputFile OnChange="UploadFiles" multiple accept="*/*" />
            </label>
            <button class="drive-btn ghost" @onclick="CreateFolder">＋ New folder</button>
        </div>
    </div>

    <div class="drive-shell">
        <aside class="drive-sidebar">
            <button class="drive-sideitem @(CurrentFolderId is null ? "active" : "")" @onclick="() => NavigateFolder(null)">📁 My Files</button>
            <button class="drive-sideitem" @onclick="LoadSharedFiles">🤝 Shared with me</button>
        </aside>

        <main class="drive-main">
            <div class="drive-toolbar">
                <input class="drive-search" @bind="SearchText" @bind:event="oninput" placeholder="Search files and folders..." />
                <span style="opacity:.5;font-size:13px">@TotalVisibleCount items</span>
            </div>

            @if (SearchText.Length == 0 && !ShowingShared)
            {
                <div class="drive-breadcrumbs">
                    <button @onclick="() => NavigateFolder(null)">My Files</button>
                    @foreach (var crumb in Breadcrumbs)
                    {
                        <span>/</span>
                        <button @onclick="() => NavigateFolder(crumb.Id)">@crumb.Name</button>
                    }
                </div>
            }

            <label class="dropzone @(IsDragging ? "drag" : "")">
                <InputFile OnChange="UploadFiles" multiple />
                <strong>Drop files here</strong>
                <div><small>or click to browse • up to 500 MB per file</small></div>
            </label>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div style="padding:10px 12px;border-radius:12px;background:#f1f5f9;margin-bottom:14px">@Message</div>
            }

            @if (IsBusy)
            {
                <div class="drive-empty">Working...</div>
            }
            else if (TotalVisibleCount == 0)
            {
                <div class="drive-empty">
                    <div style="font-size:44px">🗂️</div>
                    <h3>Nothing here yet</h3>
                    <div>Upload a file or create a folder to get started.</div>
                </div>
            }
            else
            {
                <div class="drive-grid">
                    @foreach (var folder in VisibleFolders)
                    {
                        <div class="drive-card" @onclick="() => NavigateFolder(folder.Id)">
                            <div class="thumb">📁</div>
                            <div class="name">@folder.Name</div>
                            <div class="sub">Folder</div>
                            <div class="drive-menu">
                                <button @onclick:stopPropagation="true" @onclick="() => RenameFolder(folder)">⋯</button>
                            </div>
                        </div>
                    }

                    @foreach (var file in VisibleFiles)
                    {
                        <div class="drive-card" @onclick="() => PreviewFile(file)">
                            <div class="thumb">
                                @if (IsImage(file))
                                {
                                    <img src="@($"/files-api/preview/{file.Id}")" alt="@file.OriginalName" loading="lazy" />
                                }
                                else
                                {
                                    @GetIcon(file)
                                }
                            </div>
                            <div class="name" title="@file.OriginalName">@file.OriginalName</div>
                            <div class="sub">@FormatSize(file.Size) • @file.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                            <div class="drive-menu">
                                <button @onclick:stopPropagation="true" @onclick="() => OpenFileMenu(file)">⋯</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@if (SelectedFile is not null && ShowPreview)
{
    <div class="drive-modal-backdrop" @onclick="ClosePreview">
        <div class="drive-modal" @onclick:stopPropagation="true">
            <div style="display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:14px">
                <div style="min-width:0">
                    <strong style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@SelectedFile.OriginalName</strong>
                    <small style="opacity:.55">@FormatSize(SelectedFile.Size)</small>
                </div>
                <button class="drive-btn ghost" @onclick="ClosePreview">Close</button>
            </div>

            <div class="preview-stage">
                @if (IsImage(SelectedFile))
                {
                    <img src="@($"/files-api/preview/{SelectedFile.Id}")" alt="@SelectedFile.OriginalName" />
                }
                else if (IsVideo(SelectedFile))
                {
                    <video controls src="@($"/files-api/preview/{SelectedFile.Id}")"></video>
                }
                else if (IsAudio(SelectedFile))
                {
                    <audio controls src="@($"/files-api/preview/{SelectedFile.Id}")"></audio>
                }
                else if (IsPdf(SelectedFile))
                {
                    <iframe src="@($"/files-api/preview/{SelectedFile.Id}")" style="width:100%;height:68vh"></iframe>
                }
                else
                {
                    <div style="color:#fff;text-align:center">
                        <div style="font-size:58px">@GetIcon(SelectedFile)</div>
                        <div style="margin-top:12px">Preview is not available for this file type.</div>
                    </div>
                }
            </div>

            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
                <a class="drive-btn ghost" href="@($"/files-api/download/{SelectedFile.Id}")">Download</a>
                <button class="drive-btn ghost" @onclick="() => RenameFile(SelectedFile)">Rename</button>
                <button class="drive-btn ghost" @onclick="() => ShareFile(SelectedFile)">Share</button>
                <button class="drive-btn primary" @onclick="() => DeleteFile(SelectedFile)">Delete</button>
            </div>
        </div>
    </div>
}

@if (FileMenuTarget is not null && !ShowPreview)
{
    <div class="drive-modal-backdrop" @onclick="CloseFileMenu">
        <div class="drive-modal" style="max-width:460px" @onclick="@(() => { })">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <strong>@FileMenuTarget.OriginalName</strong>
                <button class="drive-btn ghost" @onclick="CloseFileMenu">Close</button>
            </div>
            <div style="display:grid;gap:8px">
                <button class="drive-btn ghost" @onclick="() => { CloseFileMenu(); PreviewFile(FileMenuTarget); }">Preview</button>
                <a class="drive-btn ghost" href="@($"/files-api/download/{FileMenuTarget.Id}")">Download</a>
                <button class="drive-btn ghost" @onclick="() => { CloseFileMenu(); RenameFile(FileMenuTarget); }">Rename</button>
                <button class="drive-btn ghost" @onclick="() => { CloseFileMenu(); ShareFile(FileMenuTarget); }">Share & permissions</button>
                <button class="drive-btn primary" @onclick="() => { CloseFileMenu(); DeleteFile(FileMenuTarget); }">Delete</button>
            </div>
        </div>
    </div>
}

@if (ShowShare && ShareTarget is not null)
{
    <div class="drive-modal-backdrop" @onclick="CloseShare">
        <div class="drive-modal" style="max-width:680px" @onclick="@(() => { })">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <div>
                    <strong>Share @ShareTarget.OriginalName</strong>
                    <div style="opacity:.55;font-size:13px;margin-top:4px">Control who can view or edit this file.</div>
                </div>
                <button class="drive-btn ghost" @onclick="CloseShare">Close</button>
            </div>

            <div style="display:grid;grid-template-columns:1fr 130px auto;gap:8px;margin:20px 0">
                <input class="share-input" @bind="ShareEmail" placeholder="user@email.com" />
                <select class="share-input" @bind="SharePermission">
                    <option value="view">View</option>
                    <option value="edit">Edit</option>
                </select>
                <button class="drive-btn primary" @onclick="GrantShare">Share</button>
            </div>

            @if (SharedPeople.Count > 0)
            {
                <h4>People with access</h4>
                @foreach (var access in SharedPeople)
                {
                    <div class="share-row">
                        <div>@access.Email</div>

                        <select class="share-input"
                                @bind="access.Permission"
                                @bind:after="() => UpdatePermission(access.Id, access.Permission)">
                            <option value="view">View</option>
                            <option value="edit">Edit</option>
                        </select>

                        <button class="drive-btn ghost"
                                @onclick="() => RevokeShare(access.Id)">
                            Remove
                        </button>
                    </div>
                }
            }
            else
            {
                <div style="opacity:.5;margin-bottom:18px">No users have been shared with yet.</div>
            }

            <hr />
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:14px">
                <div>
                    <strong>Public link</strong>
                    <div style="font-size:13px;opacity:.55">Anyone with the link can download this file until it expires.</div>
                </div>
                <button class="drive-btn ghost" @onclick="CreateShareLink">Create link</button>
            </div>

            @foreach (var link in ShareLinks)
            {
                <div class="share-link" style="margin-top:10px">
                    <div><strong>@GetShareUrl(link.Token)</strong></div>
                    <div style="margin-top:6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                        <span style="opacity:.55">@(link.ExpiresAt.HasValue ? $"Expires {link.ExpiresAt.Value.ToLocalTime():dd MMM yyyy HH:mm}" : "No expiration")</span>
                        <button class="drive-btn ghost" @onclick="() => Copy(GetShareUrl(link.Token))">Copy</button>
                        <button class="drive-btn ghost" @onclick="() => RevokeShareLink(link.Id)">Revoke</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private int CurrentUserId;
    private int? CurrentFolderId;
    private bool ShowingShared;
    private bool IsBusy;
    private bool IsDragging;
    private string SearchText = string.Empty;
    private string? Message;

    private List<FileFolder> Folders = [];
    private List<StoredFile> Files = [];
    private List<FileFolder> Breadcrumbs = [];
    private List<StoredFile> SharedFiles = [];

    private StoredFile? SelectedFile;
    private StoredFile? FileMenuTarget;
    private StoredFile? ShareTarget;
    private bool ShowPreview;
    private bool ShowShare;

    private string ShareEmail = string.Empty;
    private string SharePermission = "view";
    private List<SharePerson> SharedPeople = [];
    private List<FileShareLink> ShareLinks = [];

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;
        var claim = state.User.FindFirst("Id");
        if (claim is null || !int.TryParse(claim.Value, out CurrentUserId) || CurrentUserId <= 0)
        {
            Message = "Unable to resolve the logged-in user.";
            return;
        }

        await LoadCurrentFolder();
    }

    private IEnumerable<FileFolder> VisibleFolders =>
        Folders.Where(x => string.IsNullOrWhiteSpace(SearchText) || x.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<StoredFile> VisibleFiles =>
        ShowingShared
            ? SharedFiles.Where(x => string.IsNullOrWhiteSpace(SearchText) || x.OriginalName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            : Files.Where(x => string.IsNullOrWhiteSpace(SearchText) || x.OriginalName.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private int TotalVisibleCount => VisibleFolders.Count() + VisibleFiles.Count();

    private async Task LoadCurrentFolder()
    {
        ShowingShared = false;
        Message = null;

        Folders = await Db.FileFolders
            .Where(x => x.OwnerId == CurrentUserId && x.ParentFolderId == CurrentFolderId)
            .OrderBy(x => x.Name)
            .ToListAsync();

        Files = await Db.StoredFiles
            .Where(x => x.OwnerId == CurrentUserId && x.FolderId == CurrentFolderId)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        await BuildBreadcrumbs();
    }

    private async Task LoadSharedFiles()
    {
        ShowingShared = true;
        CurrentFolderId = null;
        Folders = [];
        Breadcrumbs = [];

        var ids = await Db.FilePermissions
            .Where(x => x.UserId == CurrentUserId)
            .Select(x => x.FileId)
            .ToListAsync();

        SharedFiles = await Db.StoredFiles
            .Where(x => ids.Contains(x.Id))
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();
    }

    private async Task NavigateFolder(int? folderId)
    {
        CurrentFolderId = folderId;
        SearchText = string.Empty;
        await LoadCurrentFolder();
    }

    private async Task BuildBreadcrumbs()
    {
        Breadcrumbs = [];
        var id = CurrentFolderId;
        while (id.HasValue)
        {
            var folder = await Db.FileFolders.FirstOrDefaultAsync(x => x.Id == id.Value && x.OwnerId == CurrentUserId);
            if (folder is null) break;
            Breadcrumbs.Insert(0, folder);
            id = folder.ParentFolderId;
        }
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        IsBusy = true;
        Message = null;
        try
        {
            var files = e.GetMultipleFiles(50);
            foreach (var browserFile in files)
            {
                var relativePath = await Storage.SaveAsync(browserFile, CurrentUserId);
                Db.StoredFiles.Add(new StoredFile
                {
                    OriginalName = Path.GetFileName(browserFile.Name),
                    StoredName = Path.GetFileName(relativePath),
                    RelativePath = relativePath,
                    ContentType = browserFile.ContentType,
                    Size = browserFile.Size,
                    OwnerId = CurrentUserId,
                    FolderId = CurrentFolderId,
                    CreatedAt = DateTime.UtcNow
                });
            }
            await Db.SaveChangesAsync();
            Message = "Upload complete.";
            await LoadCurrentFolder();
        }
        catch (Exception ex)
        {
            Message = $"Upload failed: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task CreateFolder()
    {
        var name = await JS.InvokeAsync<string?>("prompt", "Folder name");
        if (string.IsNullOrWhiteSpace(name)) return;
        name = name.Trim();

        if (await Db.FileFolders.AnyAsync(x => x.OwnerId == CurrentUserId && x.ParentFolderId == CurrentFolderId && x.Name == name))
        {
            Message = "A folder with this name already exists.";
            return;
        }

        Db.FileFolders.Add(new FileFolder { Name = name, OwnerId = CurrentUserId, ParentFolderId = CurrentFolderId });
        await Db.SaveChangesAsync();
        await LoadCurrentFolder();
    }

    private async Task RenameFolder(FileFolder folder)
    {
        var name = await JS.InvokeAsync<string?>("prompt", "New folder name", folder.Name);
        if (string.IsNullOrWhiteSpace(name) || name.Trim() == folder.Name) return;
        folder.Name = name.Trim();
        await Db.SaveChangesAsync();
        await LoadCurrentFolder();
    }

    private void PreviewFile(StoredFile file)
    {
        SelectedFile = file;
        FileMenuTarget = null;
        ShowPreview = true;
    }

    private void ClosePreview()
    {
        ShowPreview = false;
        SelectedFile = null;
    }

    private void OpenFileMenu(StoredFile file)
    {
        FileMenuTarget = file;
        ShowPreview = false;
    }

    private void CloseFileMenu() => FileMenuTarget = null;

    private async Task RenameFile(StoredFile file)
    {
        if (!await CanEdit(file)) { Message = "You do not have edit permission for this file."; return; }
        var name = await JS.InvokeAsync<string?>("prompt", "New file name", file.OriginalName);
        if (string.IsNullOrWhiteSpace(name) || name.Trim() == file.OriginalName) return;
        file.OriginalName = Path.GetFileName(name.Trim());
        await Db.SaveChangesAsync();
        await LoadCurrentFolder();
    }

    private async Task DeleteFile(StoredFile file)
    {
        if (!await CanEdit(file)) { Message = "You do not have edit permission for this file."; return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete '{file.OriginalName}'?")) return;
        await Storage.DeleteAsync(file.RelativePath);
        Db.StoredFiles.Remove(file);
        await Db.SaveChangesAsync();
        ClosePreview();
        await LoadCurrentFolder();
    }

    private async Task<bool> CanEdit(StoredFile file)
    {
        if (file.OwnerId == CurrentUserId)
            return true;

        return await Db.FilePermissions.AnyAsync(x =>
            x.FileId == file.Id &&
            x.UserId == CurrentUserId &&
            x.Permission == "edit");
    }

    private async Task ShareFile(StoredFile file)
    {
        ShareTarget = file;
        ShareEmail = string.Empty;
        SharePermission = "view";
        ShowShare = true;
        SharedPeople = await LoadPeople(file.Id);
        ShareLinks = await Db.FileShareLinks.Where(x => x.FileId == file.Id && !x.IsRevoked).OrderByDescending(x => x.CreatedAt).ToListAsync();
    }

    private async Task<List<SharePerson>> LoadPeople(long fileId)
    {
        return await (from p in Db.FilePermissions
                      join u in Db.Users on p.UserId equals u.Id
                      where p.FileId == fileId
                      select new SharePerson
                      {
                          Id = p.Id,
                          Email = u.Email ?? u.FullName ?? $"User {u.Id}",
                          Permission = p.Permission
                      }).ToListAsync();
    }

    private async Task GrantShare()
    {
        if (ShareTarget is null || ShareTarget.OwnerId != CurrentUserId || string.IsNullOrWhiteSpace(ShareEmail)) return;
        var email = ShareEmail.Trim();
        var user = await Db.Users.FirstOrDefaultAsync(x => x.Email == email);
        if (user is null) { Message = "User not found."; return; }
        if (user.Id == CurrentUserId) { Message = "The owner already has access."; return; }

        var permission = await Db.FilePermissions.FirstOrDefaultAsync(x => x.FileId == ShareTarget.Id && x.UserId == user.Id);
        if (permission is null)
        {
            Db.FilePermissions.Add(new FilePermission { FileId = ShareTarget.Id, UserId = user.Id, Permission = SharePermission, GrantedByUserId = CurrentUserId });
        }
        else
        {
            permission.Permission = SharePermission;
        }
        await Db.SaveChangesAsync();
        SharedPeople = await LoadPeople(ShareTarget.Id);
        Message = $"Shared with {email}.";
        ShareEmail = string.Empty;
    }

    private async Task UpdatePermission(long permissionId, string permission)
    {
        if (ShareTarget is null) return;
        if (ShareTarget.OwnerId != CurrentUserId)
            return;

        var entity = await Db.FilePermissions.FirstOrDefaultAsync(x =>
            x.Id == permissionId && x.FileId == ShareTarget.Id);
        if (entity is null) return;
        entity.Permission = permission == "edit" ? "edit" : "view";
        await Db.SaveChangesAsync();
        SharedPeople = await LoadPeople(ShareTarget.Id);
    }

    private async Task RevokeShare(long permissionId)
    {
        if (ShareTarget is null) return;
        var entity = await Db.FilePermissions.FirstOrDefaultAsync(x => x.Id == permissionId && x.FileId == ShareTarget.Id);
        if (entity is null) return;
        Db.FilePermissions.Remove(entity);
        await Db.SaveChangesAsync();
        SharedPeople = await LoadPeople(ShareTarget.Id);
    }

    private async Task CreateShareLink()
    {
        if (ShareTarget is null || ShareTarget.OwnerId != CurrentUserId) return;
        var token = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32))
            .Replace("+", "-").Replace("/", "_").TrimEnd('=');
        Db.FileShareLinks.Add(new FileShareLink
        {
            FileId = ShareTarget.Id,
            Token = token,
            CreatedByUserId = CurrentUserId,
            CreatedAt = DateTime.UtcNow,
            ExpiresAt = DateTime.UtcNow.AddDays(7)
        });
        await Db.SaveChangesAsync();
        ShareLinks = await Db.FileShareLinks.Where(x => x.FileId == ShareTarget.Id && !x.IsRevoked).OrderByDescending(x => x.CreatedAt).ToListAsync();
    }

    private async Task RevokeShareLink(long id)
    {
        var link = await Db.FileShareLinks.FirstOrDefaultAsync(x => x.Id == id && x.FileId == ShareTarget!.Id && x.CreatedByUserId == CurrentUserId);
        if (link is null) return;
        link.IsRevoked = true;
        await Db.SaveChangesAsync();
        ShareLinks = await Db.FileShareLinks.Where(x => x.FileId == ShareTarget!.Id && !x.IsRevoked).OrderByDescending(x => x.CreatedAt).ToListAsync();
    }

    private async Task Copy(string text) => await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private string GetShareUrl(string token) => $"{Navigation.BaseUri.TrimEnd('/')}/files-api/share/{token}";

    private void CloseShare()
    {
        ShowShare = false;
        ShareTarget = null;
    }

    private bool IsImage(StoredFile file) => file.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsVideo(StoredFile file) => file.ContentType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsAudio(StoredFile file) => file.ContentType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true;
    private bool IsPdf(StoredFile file) => string.Equals(file.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase);

    private static string GetIcon(StoredFile file)
    {
        var ext = Path.GetExtension(file.OriginalName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".xls" or ".xlsx" => "📗",
            ".ppt" or ".pptx" => "📙",
            ".zip" or ".rar" or ".7z" => "🗜️",
            ".mp4" or ".webm" or ".mov" => "🎬",
            ".mp3" or ".wav" or ".ogg" => "🎵",
            _ => "📄"
        };
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.0} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / 1024d / 1024d:0.0} MB";
        return $"{bytes / 1024d / 1024d / 1024d:0.0} GB";
    }

    private sealed class SharePerson
    {
        public long Id { get; set; }
        public string Email { get; set; } = string.Empty;
        public string Permission { get; set; } = "view";
    }
}
