@page "/files"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using REMS.Data
@using REMS.Enititys
@using REMS.Services
@using System.Security.Cryptography

@attribute [Authorize]

@inject AppDbContext Db
@inject FileStorageService Storage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Files - REMS</PageTitle>

<style>
    .rems-drive {
        padding: 28px;
        max-width: 1450px;
        margin: 0 auto;
        color: #111827;
    }

    .drive-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 22px;
    }

    .drive-kicker {
        font-size: 11px;
        letter-spacing: .2em;
        font-weight: 800;
        opacity: .45;
    }

    .drive-head h1 {
        font-size: 36px;
        line-height: 1;
        margin: 7px 0;
    }

    .drive-head p {
        margin: 0;
        opacity: .55;
    }

    .drive-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .drive-btn {
        border: 0;
        border-radius: 14px;
        padding: 11px 16px;
        font-weight: 800;
        cursor: pointer;
        transition: .18s ease;
    }

        .drive-btn:hover {
            transform: translateY(-1px);
        }

        .drive-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

        .drive-btn.primary {
            background: #111827;
            color: #fff;
        }

        .drive-btn.ghost {
            background: #f3f4f6;
            color: #111827;
        }

    .drive-upload {
        position: relative;
        overflow: hidden;
    }

        .drive-upload input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .drive-shell {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 16px;
    }

    .drive-sidebar,
    .drive-main {
        background: rgba(255, 255, 255, .82);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(17, 24, 39, .07);
        border-radius: 24px;
    }

    .drive-sidebar {
        padding: 14px;
        height: fit-content;
    }

    .drive-sideitem {
        width: 100%;
        display: flex;
        gap: 10px;
        align-items: center;
        border: 0;
        background: transparent;
        padding: 11px 12px;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        text-align: left;
    }

        .drive-sideitem.active,
        .drive-sideitem:hover {
            background: #f3f4f6;
        }

    .drive-main {
        padding: 18px;
        min-width: 0;
    }

    .drive-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .drive-search {
        flex: 1;
        max-width: 500px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        border-radius: 14px;
        padding: 11px 14px;
        outline: 0;
    }

    .drive-breadcrumbs {
        display: flex;
        gap: 7px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 15px;
    }

        .drive-breadcrumbs button {
            border: 0;
            background: transparent;
            font-weight: 800;
            cursor: pointer;
            padding: 0;
        }

    .dropzone {
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        margin-bottom: 16px;
        background: #fafcff;
    }

        .dropzone.drag {
            border-color: #111827;
            background: #f4f6f8;
        }

        .dropzone small {
            opacity: .55;
        }

    .drive-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }

    .drive-card {
        position: relative;
        border: 1px solid #eef0f3;
        border-radius: 18px;
        background: #fff;
        padding: 14px;
        min-height: 146px;
        cursor: pointer;
    }

        .drive-card:hover {
            box-shadow: 0 10px 26px rgba(0,0,0,.06);
        }

        .drive-card .thumb {
            height: 78px;
            border-radius: 14px;
            background: #f8fafc;
            display: grid;
            place-items: center;
            font-size: 34px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .drive-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .drive-card .name {
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .drive-card .sub {
            font-size: 12px;
            opacity: .5;
            margin-top: 4px;
        }

    .drive-menu {
        position: absolute;
        right: 9px;
        top: 9px;
    }

        .drive-menu button {
            border: 0;
            background: #fff;
            border-radius: 10px;
            padding: 5px 8px;
            cursor: pointer;
        }

    .drive-empty {
        padding: 70px 20px;
        text-align: center;
        opacity: .55;
    }

    .drive-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .38);
        display: grid;
        place-items: center;
        z-index: 5000;
        padding: 20px;
    }

    .drive-modal {
        width: min(920px, 95vw);
        max-height: 90vh;
        overflow: auto;
        background: #fff;
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 24px 90px rgba(0,0,0,.25);
    }

    .preview-stage {
        min-height: 420px;
        background: #0f172a;
        border-radius: 18px;
        display: grid;
        place-items: center;
        overflow: hidden;
    }

        .preview-stage img,
        .preview-stage iframe,
        .preview-stage video {
            max-width: 100%;
            max-height: 68vh;
            border: 0;
        }

        .preview-stage audio {
            width: min(520px, 90%);
        }

    .share-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 10px;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #eef0f3;
    }

    .share-input {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px;
        background: #fff;
        outline: none;
        min-width: 0;
    }

        .share-input:focus {
            border-color: #94a3b8;
        }

    .share-link {
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px;
        word-break: break-all;
        font-size: 13px;
    }

    .share-user-box {
        display: grid;
        grid-template-columns: 1fr 130px auto;
        gap: 8px;
        margin: 20px 0;
    }

    .share-user-hint {
        margin-top: -12px;
        margin-bottom: 16px;
        font-size: 12px;
        opacity: .5;
    }

    .share-status {
        padding: 10px 12px;
        border-radius: 12px;
        background: #f1f5f9;
        margin-bottom: 14px;
    }

    @@media (max-width: 900px) {
        .drive-shell {
            grid-template-columns: 1fr;
        }

        .drive-sidebar {
            display: flex;
            overflow: auto;
        }

        .drive-sideitem {
            white-space: nowrap;
        }

        .drive-head {
            align-items: start;
            flex-direction: column;
        }

        .drive-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .drive-search {
            max-width: none;
        }

        .drive-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        }

        .share-user-box {
            grid-template-columns: 1fr;
        }

        .share-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .rems-drive {
            padding: 14px;
        }

        .drive-modal-backdrop {
            padding: 10px;
        }

        .drive-modal {
            width: 100%;
            border-radius: 18px;
            padding: 14px;
        }

        .preview-stage {
            min-height: 280px;
        }

        .drive-head h1 {
            font-size: 30px;
        }
    }
</style>

<div class="rems-drive">
    <div class="drive-head">
        <div>
            <div class="drive-kicker">REMS CLOUD STORAGE</div>
            <h1>Files</h1>
            <p>Your private workspace for files, folders and shared documents.</p>
        </div>

        <div class="drive-actions">
            @if (!ShowingHub || CanManageHub)
            {
                <label class="drive-btn primary drive-upload">
                    ＋ @(ShowingHub ? "Publish to Hub" : "Upload")
                    <InputFile OnChange="UploadFiles" multiple accept="*/*" />
                </label>
            }

            @if (!ShowingHub)
            {
                <button class="drive-btn ghost" @onclick="CreateFolder">
                    ＋ New folder
                </button>
            }
        </div>
    </div>

    <div class="drive-shell">
        <aside class="drive-sidebar">
            <button class="drive-sideitem @(CurrentFolderId is null && !ShowingShared ? "active" : "")"
                    @onclick="() => NavigateFolder(null)">
                📁 My Files
            </button>

            <button class="drive-sideitem @(ShowingShared ? "active" : "")"
                    @onclick="LoadSharedFiles">
                🤝 Shared with me
            </button>

            <button class="drive-sideitem @(ShowingHub ? "active" : "")"
                    @onclick="LoadHubFiles">
                🌐 Company Hub
            </button>
        </aside>

        <main class="drive-main">
            <div class="drive-toolbar">
                <input class="drive-search"
                       @bind="SearchText"
                       @bind:event="oninput"
                       placeholder="Search files and folders..." />

                <span style="opacity:.5;font-size:13px">
                    @TotalVisibleCount items
                </span>
            </div>

            @if (SearchText.Length == 0 && !ShowingShared && !ShowingHub)
            {
                <div class="drive-breadcrumbs">
                    <button @onclick="() => NavigateFolder(null)">
                        My Files
                    </button>

                    @foreach (var crumb in Breadcrumbs)
                    {
                        <span>/</span>

                        <button @onclick="() => NavigateFolder(crumb.Id)">
                            @crumb.Name
                        </button>
                    }
                </div>
            }

            @if (!ShowingHub || CanManageHub)
            {
                <label class="dropzone @(IsDragging ? "drag" : "")">
                    <InputFile OnChange="UploadFiles" multiple />
                    <strong>@(ShowingHub ? "Publish files for all users" : "Drop files here")</strong>
                    <div>
                        <small>or click to browse • up to 100 MB per file</small>
                    </div>
                </label>
            }
            else
            {
                <div class="share-status">Company Hub files are published by administrators and available to every logged-in user.</div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="share-status">
                    @Message
                </div>
            }

            @if (IsBusy)
            {
                <div class="drive-empty">
                    Working...
                </div>
            }
            else if (TotalVisibleCount == 0)
            {
                <div class="drive-empty">
                    <div style="font-size:44px">🗂️</div>
                    <h3>Nothing here yet</h3>
                    <div>
                        Upload a file or create a folder to get started.
                    </div>
                </div>
            }
            else
            {
                <div class="drive-grid">

                    @foreach (var folder in VisibleFolders)
                    {
                        <div class="drive-card"
                             @onclick="() => NavigateFolder(folder.Id)">

                            <div class="thumb">
                                📁
                            </div>

                            <div class="name">
                                @folder.Name
                            </div>

                            <div class="sub">
                                Folder
                            </div>

                            <div class="drive-menu">
                                <button @onclick:stopPropagation="true"
                                        @onclick="() => RenameFolder(folder)">
                                    ⋯
                                </button>
                            </div>
                        </div>
                    }

                    @foreach (var file in VisibleFiles)
                    {
                        <div class="drive-card"
                             @onclick="() => PreviewFile(file)">

                            <div class="thumb">
                                @if (IsImage(file))
                                {
                                    <img src="@($"/files-api/preview/{file.Id}")"
                                         alt="@file.OriginalName"
                                         loading="lazy" />
                                }
                                else
                                {
                                    @GetIcon(file)
                                }
                            </div>

                            <div class="name"
                                 title="@file.OriginalName">
                                @file.OriginalName
                            </div>

                            <div class="sub">
                                @FormatSize(file.Size)
                                •
                                @file.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                @if (IsAdministrator)
                                {
                                    <span> • @(string.IsNullOrWhiteSpace(file.OwnerName) ? $"User {file.OwnerId}" : file.OwnerName)</span>
                                }
                                @if (file.IsSharedHub)
                                {
                                    <span> • Hub</span>
                                }
                            </div>

                            <div class="drive-menu">
                                <button @onclick:stopPropagation="true"
                                        @onclick="() => OpenFileMenu(file)">
                                    ⋯
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@if (SelectedFile is not null && ShowPreview)
{
    <div class="drive-modal-backdrop"
         @onclick="ClosePreview">

        <div class="drive-modal"
             @onclick:stopPropagation="true">

            <div style="display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:14px">
                <div style="min-width:0">
                    <strong style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        @SelectedFile.OriginalName
                    </strong>

                    <small style="opacity:.55">
                        @FormatSize(SelectedFile.Size)
                    </small>
                </div>

                <button class="drive-btn ghost"
                        @onclick="ClosePreview">
                    Close
                </button>
            </div>

            <div class="preview-stage">

                @if (IsImage(SelectedFile))
                {
                    <img src="@($"/files-api/preview/{SelectedFile.Id}")"
                         alt="@SelectedFile.OriginalName" />
                }
                else if (IsVideo(SelectedFile))
                {
                    <video controls
                           src="@($"/files-api/preview/{SelectedFile.Id}")">
                    </video>
                }
                else if (IsAudio(SelectedFile))
                {
                    <audio controls
                           src="@($"/files-api/preview/{SelectedFile.Id}")">
                    </audio>
                }
                else if (IsPdf(SelectedFile))
                {
                    <iframe src="@($"/files-api/preview/{SelectedFile.Id}")"
                            style="width:100%;height:68vh">
                    </iframe>
                }
                else
                {
                    <div style="color:#fff;text-align:center">
                        <div style="font-size:58px">
                            @GetIcon(SelectedFile)
                        </div>

                        <div style="margin-top:12px">
                            Preview is not available for this file type.
                        </div>
                    </div>
                }

            </div>

            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px;flex-wrap:wrap">

                <a class="drive-btn ghost"
                   href="@($"/files-api/download/{SelectedFile.Id}")"
                   @onclick:stopPropagation="true">
                    Download
                </a>

                @if (CanShare(SelectedFile))
                {
                    <button class="drive-btn ghost"
                            @onclick:stopPropagation="true"
                            @onclick="OpenShareFromPreview">
                        Share
                    </button>
                }

                <button class="drive-btn ghost"
                        @onclick:stopPropagation="true"
                        @onclick="RenameSelectedFile">
                    Rename
                </button>

                <button class="drive-btn primary"
                        @onclick:stopPropagation="true"
                        @onclick="DeleteSelectedFile">
                    Delete
                </button>

            </div>
        </div>
    </div>
}

@if (FileMenuTarget is not null && !ShowPreview)
{
    <div class="drive-modal-backdrop"
         @onclick="CloseFileMenu">

        <div class="drive-modal"
             style="max-width:460px"
             @onclick:stopPropagation="true">

            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <strong>
                    @FileMenuTarget.OriginalName
                </strong>

                <button class="drive-btn ghost"
                        @onclick="CloseFileMenu">
                    Close
                </button>
            </div>

            <div style="display:grid;gap:8px">

                <button class="drive-btn ghost"
                        @onclick="PreviewFromFileMenu">
                    Preview
                </button>

                <a class="drive-btn ghost"
                   href="@($"/files-api/download/{FileMenuTarget.Id}")">
                    Download
                </a>

                <button class="drive-btn ghost"
                        @onclick="RenameFromFileMenu">
                    Rename
                </button>

                @if (CanShare(FileMenuTarget))
                {
                    <button class="drive-btn ghost"
                            @onclick="ShareFromFileMenu">
                        Share & permissions
                    </button>
                }

                <button class="drive-btn primary"
                        @onclick="DeleteFromFileMenu">
                    Delete
                </button>

            </div>
        </div>
    </div>
}

@if (ShowShare && ShareTarget is not null)
{
    <div class="drive-modal-backdrop"
         @onclick="CloseShare">

        <div class="drive-modal"
             style="max-width:680px"
             @onclick:stopPropagation="true">

            <div style="display:flex;justify-content:space-between;align-items:center">
                <div>

                    <strong>
                        Share @ShareTarget.OriginalName
                    </strong>

                    <div style="opacity:.55;font-size:13px;margin-top:4px">
                        Control who can view or edit this file.
                    </div>

                </div>

                <button class="drive-btn ghost"
                        @onclick="CloseShare">
                    Close
                </button>
            </div>

            @if (!CanManageFile(ShareTarget))
            {
                <div class="share-status" style="margin-top:18px">
                    You are not the owner of this file.
                </div>
            }
            else
            {
                <div class="share-user-box">

                    <select class="share-input"
                            @bind="ShareEmail">

                        <option value="">
                            Select a user...
                        </option>

                        @foreach (var user in ShareableUsers)
                        {
                            <option value="@user.Email">
                                @user.Email
                            </option>
                        }

                    </select>

                    <select class="share-input"
                            @bind="SharePermission">

                        <option value="view">
                            View
                        </option>

                        <option value="edit">
                            Edit
                        </option>

                    </select>

                    <button class="drive-btn primary"
                            @onclick="GrantShare"
                            disabled="@string.IsNullOrWhiteSpace(ShareEmail)">
                        Share
                    </button>

                </div>

                <div class="share-user-hint">
                    Select an existing REMS user and choose whether they can view or edit the file.
                </div>
            }

            @if (SharedPeople.Count > 0)
            {
                <h4>
                    People with access
                </h4>

                @foreach (var access in SharedPeople)
                {
                    <div class="share-row">

                        <div style="min-width:0;overflow:hidden;text-overflow:ellipsis">
                            @access.Email
                        </div>

                        <select class="share-input"
                                @bind="access.Permission"
                                @bind:after="() => UpdatePermission(access.Id, access.Permission)"
                                disabled="@(!CanManageFile(ShareTarget))">

                            <option value="view">
                                View
                            </option>

                            <option value="edit">
                                Edit
                            </option>

                        </select>

                        <button class="drive-btn ghost"
                                @onclick="() => RevokeShare(access.Id)"
                                disabled="@(!CanManageFile(ShareTarget))">
                            Remove
                        </button>

                    </div>
                }
            }
            else
            {
                <div style="opacity:.5;margin-bottom:18px">
                    No users have been shared with yet.
                </div>
            }

            @if (CanManageFile(ShareTarget))
            {
                <hr />

                <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:14px">
                    <div>
                        <strong>
                            Public link
                        </strong>

                        <div style="font-size:13px;opacity:.55">
                            Anyone with the link can download this file until it expires.
                        </div>
                    </div>

                    <button class="drive-btn ghost"
                            @onclick="CreateShareLink">
                        Create link
                    </button>
                </div>

                @foreach (var link in ShareLinks)
                {
                    <div class="share-link" style="margin-top:10px">

                        <div>
                            <strong>
                                @GetShareUrl(link.Token)
                            </strong>
                        </div>

                        <div style="margin-top:6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">

                            <span style="opacity:.55">
                                @(link.ExpiresAt.HasValue
                                    ? $"Expires {link.ExpiresAt.Value.ToLocalTime():dd MMM yyyy HH:mm}"
                                    : "No expiration")
                            </span>

                            <button class="drive-btn ghost"
                                    @onclick="() => Copy(GetShareUrl(link.Token))">
                                Copy
                            </button>

                            <button class="drive-btn ghost"
                                    @onclick="() => RevokeShareLink(link.Id)">
                                Revoke
                            </button>

                        </div>
                    </div>
                }
            }

        </div>
    </div>
}

@code {

    private int CurrentUserId;
    private int? CurrentFolderId;

    private bool ShowingShared;
    private bool ShowingHub;
    private bool CanManageHub;
    private bool IsAdministrator;
    private bool IsBusy;
    private bool IsDragging;

    private string SearchText = string.Empty;
    private string? Message;

    private List<FileFolder> Folders = [];
    private List<StoredFile> Files = [];
    private List<FileFolder> Breadcrumbs = [];
    private List<StoredFile> SharedFiles = [];
    private List<StoredFile> HubFiles = [];

    private StoredFile? SelectedFile;
    private StoredFile? FileMenuTarget;
    private StoredFile? ShareTarget;

    private bool ShowPreview;
    private bool ShowShare;

    private string ShareEmail = string.Empty;
    private string SharePermission = "view";

    private List<SharePerson> SharedPeople = [];
    private List<FileShareLink> ShareLinks = [];

    private List<ShareableUser> ShareableUsers = [];

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;

        var claim =
            state.User.FindFirst("Id")
            ?? state.User.FindFirst(ClaimTypes.NameIdentifier);

        if (claim is null ||
            !int.TryParse(claim.Value, out CurrentUserId) ||
            CurrentUserId <= 0)
        {
            Message = "Unable to resolve the logged-in user.";
            return;
        }

        CanManageHub = state.User.IsInRole("Manager") ||
                       state.User.IsInRole("Admin") ||
                       state.User.IsInRole("Admin1");
        IsAdministrator = CanManageHub;

        await LoadCurrentFolder();
    }

    private IEnumerable<FileFolder> VisibleFolders =>
        Folders.Where(x =>
            string.IsNullOrWhiteSpace(SearchText) ||
            x.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<StoredFile> VisibleFiles =>
        ShowingHub
            ? HubFiles.Where(x =>
                string.IsNullOrWhiteSpace(SearchText) ||
                x.OriginalName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            : ShowingShared
                ? SharedFiles.Where(x =>
                string.IsNullOrWhiteSpace(SearchText) ||
                x.OriginalName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            : Files.Where(x =>
                string.IsNullOrWhiteSpace(SearchText) ||
                x.OriginalName.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private int TotalVisibleCount =>
        VisibleFolders.Count() + VisibleFiles.Count();

    private async Task LoadCurrentFolder()
    {
        ShowingShared = false;
        ShowingHub = false;
        Message = null;

        Folders = await Db.FileFolders
            .Where(x =>
                (IsAdministrator || x.OwnerId == CurrentUserId) &&
                x.ParentFolderId == CurrentFolderId)
            .OrderBy(x => x.Name)
            .ToListAsync();

        Files = await Db.StoredFiles
            .Where(x =>
                (IsAdministrator || x.OwnerId == CurrentUserId) &&
                x.FolderId == CurrentFolderId)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        await LoadOwnerNames(Files);

        await BuildBreadcrumbs();
    }

    private async Task LoadSharedFiles()
    {
        try
        {
            Message = null;

            ShowingShared = true;
            ShowingHub = false;
            CurrentFolderId = null;

            Folders = [];
            Breadcrumbs = [];

            var ids = await Db.FilePermissions
                .Where(x => x.UserId == CurrentUserId)
                .Select(x => x.FileId)
                .ToListAsync();

            SharedFiles = await Db.StoredFiles
                .Where(x => ids.Contains(x.Id))
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();

            await LoadOwnerNames(SharedFiles);
        }
        catch (Exception ex)
        {
            Message = $"Unable to load shared files: {ex.Message}";
        }
    }

    private async Task LoadHubFiles()
    {
        try
        {
            Message = null;
            ShowingShared = false;
            ShowingHub = true;
            CurrentFolderId = null;
            Folders = [];
            Breadcrumbs = [];

            HubFiles = await Db.StoredFiles
                .Where(x => x.IsSharedHub)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();

            await LoadOwnerNames(HubFiles);
        }
        catch (Exception ex)
        {
            Message = $"Unable to load the company hub: {ex.Message}";
        }
    }

    private async Task NavigateFolder(int? folderId)
    {
        CurrentFolderId = folderId;
        SearchText = string.Empty;
        await LoadCurrentFolder();
    }

    private async Task BuildBreadcrumbs()
    {
        Breadcrumbs = [];

        var id = CurrentFolderId;

        while (id.HasValue)
        {
            var folder = await Db.FileFolders
                .FirstOrDefaultAsync(x =>
                    x.Id == id.Value &&
                    (IsAdministrator || x.OwnerId == CurrentUserId));

            if (folder is null)
                break;

            Breadcrumbs.Insert(0, folder);
            id = folder.ParentFolderId;
        }
    }

    private async Task LoadOwnerNames(List<StoredFile> files)
    {
        if (!IsAdministrator || files.Count == 0)
            return;

        var ownerIds = files
            .Select(x => x.OwnerId)
            .Distinct()
            .ToList();

        var names = await Db.Users
            .Where(x => ownerIds.Contains(x.Id))
            .ToDictionaryAsync(
                x => x.Id,
                x => string.IsNullOrWhiteSpace(x.FullName) ? x.Email ?? $"User {x.Id}" : x.FullName);

        foreach (var file in files)
        {
            if (names.TryGetValue(file.OwnerId, out var ownerName))
                file.OwnerName = ownerName;
        }
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        if (ShowingHub && !CanManageHub)
        {
            Message = "Only administrators can publish files to the company hub.";
            return;
        }

        IsBusy = true;
        Message = null;

        try
        {
            var files = e.GetMultipleFiles(50);

            foreach (var browserFile in files)
            {
                var relativePath =
                    await Storage.SaveAsync(browserFile, CurrentUserId);

                Db.StoredFiles.Add(new StoredFile
                {
                    OriginalName = Path.GetFileName(browserFile.Name),
                    StoredName = Path.GetFileName(relativePath),
                    RelativePath = relativePath,
                    ContentType = browserFile.ContentType,
                    Size = browserFile.Size,
                    OwnerId = CurrentUserId,
                    FolderId = ShowingHub ? null : CurrentFolderId,
                    IsSharedHub = ShowingHub,
                    CreatedAt = DateTime.UtcNow
                });
            }

            await Db.SaveChangesAsync();

            Message = "Upload complete.";

            if (ShowingHub)
                await LoadHubFiles();
            else
                await LoadCurrentFolder();
        }
        catch (Exception ex)
        {
            Message = $"Upload failed: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task CreateFolder()
    {
        if (ShowingHub)
        {
            Message = "Folders are not used in the company hub.";
            return;
        }

        var name =
            await JS.InvokeAsync<string?>(
                "prompt",
                "Folder name");

        if (string.IsNullOrWhiteSpace(name))
            return;

        name = name.Trim();

        if (await Db.FileFolders.AnyAsync(x =>
                x.OwnerId == CurrentUserId &&
                x.ParentFolderId == CurrentFolderId &&
                x.Name == name))
        {
            Message = "A folder with this name already exists.";
            return;
        }

        Db.FileFolders.Add(
            new FileFolder
            {
                Name = name,
                OwnerId = CurrentUserId,
                ParentFolderId = CurrentFolderId
            });

        await Db.SaveChangesAsync();

        await LoadCurrentFolder();
    }

    private async Task RenameFolder(FileFolder folder)
    {
        var name =
            await JS.InvokeAsync<string?>(
                "prompt",
                "New folder name",
                folder.Name);

        if (string.IsNullOrWhiteSpace(name) ||
            name.Trim() == folder.Name)
            return;

        folder.Name = name.Trim();

        await Db.SaveChangesAsync();

        await LoadCurrentFolder();
    }

