    private async Task<bool> ShareFile(StoredFile? file)
    {
        try
        {
            if (file is null)
            {
                Message = "Share failed: file is null.";
                return false;
            }

            if (Db is null)
            {
                Message = "Share failed: database context is null.";
                return false;
            }

            if (CurrentUserId <= 0)
            {
                Message = "Share failed: current user could not be resolved.";
                return false;
            }

            // Hub administrators may also manage hub files.
            var dbFile = await Db.StoredFiles
                .AsNoTracking()
                .FirstOrDefaultAsync(x =>
                    x.Id == file.Id &&
                    (x.OwnerId == CurrentUserId || (x.IsSharedHub && CanManageHub)));

            if (dbFile is null)
            {
                Message = "You can only share files that you own.";
                return false;
            }

            ShareTarget = dbFile;
            ShareEmail = string.Empty;
            SharePermission = "view";

            // Load users before displaying the modal.
            ShareableUsers = await Db.Users
                .Where(x =>
                    x.Id != CurrentUserId &&
                    x.Email != null &&
                    x.Email != "")
                .OrderBy(x => x.Email)
                .Select(x => new ShareableUser
                {
                    Id = x.Id,
                    Email = x.Email!
                })
                .ToListAsync();

            SharedPeople = await LoadPeople(dbFile.Id);

            ShareLinks = await Db.FileShareLinks
                .Where(x =>
                    x.FileId == dbFile.Id &&
                    !x.IsRevoked)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();

            Message = null;

            ShowPreview = false;
            FileMenuTarget = null;
            ShowShare = true;

            return true;
        }
        catch (Exception ex)
        {
            ShowShare = false;

            Message =
                $"Share failed: {ex.GetType().Name} - {ex.Message}";

            Console.Error.WriteLine(ex);

            return false;
        }
    }

    private async Task<List<SharePerson>> LoadPeople(long fileId)
    {
        if (Db is null)
            return [];

        return await (
            from p in Db.FilePermissions
            join u in Db.Users on p.UserId equals u.Id
            where p.FileId == fileId
            select new SharePerson
            {
                Id = p.Id,
                Email =
                    !string.IsNullOrWhiteSpace(u.Email)
                        ? u.Email!
                        : (
                            !string.IsNullOrWhiteSpace(u.FullName)
                                ? u.FullName!
                                : $"User {u.Id}"
                        ),
                Permission =
                    p.Permission == "edit"
                        ? "edit"
                        : "view"
            }
        ).ToListAsync();
    }

    private async Task GrantShare()
    {
        try
        {
            if (ShareTarget is null)
            {
                Message = "Select a file first.";
                return;
            }

            if (!CanManageFile(ShareTarget))
            {
                Message = "Only the owner can share this file.";
                return;
            }

            if (string.IsNullOrWhiteSpace(ShareEmail))
            {
                Message = "Please select a user.";
                return;
            }

            var email = ShareEmail.Trim();

            var user = await Db.Users
                .FirstOrDefaultAsync(x =>
                    x.Email != null &&
                    x.Email.ToLower() == email.ToLower());

            if (user is null)
            {
                Message = "User not found.";
                return;
            }

            if (user.Id == CurrentUserId)
            {
                Message = "The owner already has access.";
                return;
            }

            var permission =
                await Db.FilePermissions.FirstOrDefaultAsync(x =>
                    x.FileId == ShareTarget.Id &&
                    x.UserId == user.Id);

            if (permission is null)
            {
                Db.FilePermissions.Add(
                    new FilePermission
                    {
                        FileId = ShareTarget.Id,
                        UserId = user.Id,
                        Permission =
                            SharePermission == "edit"
                                ? "edit"
                                : "view",
                        GrantedByUserId = CurrentUserId
                    });
            }
            else
            {
                permission.Permission =
                    SharePermission == "edit"
                        ? "edit"
                        : "view";
            }

            await Db.SaveChangesAsync();

            SharedPeople =
                await LoadPeople(ShareTarget.Id);

            Message =
                $"Shared with {email}.";

            ShareEmail = string.Empty;
            SharePermission = "view";
        }
        catch (Exception ex)
        {
            Message =
                $"Unable to share file: {ex.Message}";
        }
    }

    private async Task UpdatePermission(
        long permissionId,
        string permission)
    {
        try
        {
            if (ShareTarget is null)
                return;

            if (!CanManageFile(ShareTarget))
            {
                Message = "Only the owner can change permissions.";
                return;
            }

            var entity =
                await Db.FilePermissions.FirstOrDefaultAsync(x =>
                    x.Id == permissionId &&
                    x.FileId == ShareTarget.Id);

            if (entity is null)
                return;

            entity.Permission =
                permission == "edit"
                    ? "edit"
                    : "view";

            await Db.SaveChangesAsync();

            SharedPeople =
                await LoadPeople(ShareTarget.Id);
        }
        catch (Exception ex)
        {
            Message =
                $"Unable to update permission: {ex.Message}";
        }
    }

    private async Task RevokeShare(long permissionId)
    {
        try
        {
            if (ShareTarget is null)
                return;

            if (!CanManageFile(ShareTarget))
            {
                Message = "Only the owner can revoke access.";
                return;
            }

            var entity =
                await Db.FilePermissions.FirstOrDefaultAsync(x =>
                    x.Id == permissionId &&
                    x.FileId == ShareTarget.Id);

            if (entity is null)
                return;

            Db.FilePermissions.Remove(entity);

            await Db.SaveChangesAsync();

            SharedPeople =
                await LoadPeople(ShareTarget.Id);

            Message = "User access removed.";
        }
        catch (Exception ex)
        {
            Message =
                $"Unable to revoke access: {ex.Message}";
        }
    }

    private async Task CreateShareLink()
    {
        try
        {
            if (ShareTarget is null)
                return;

            if (!CanManageFile(ShareTarget))
            {
                Message = "Only the owner can create a public link.";
                return;
            }

            var token =
                Convert.ToBase64String(
                    RandomNumberGenerator.GetBytes(32))
                .Replace("+", "-")
                .Replace("/", "_")
                .TrimEnd('=');

            Db.FileShareLinks.Add(
                new FileShareLink
                {
                    FileId = ShareTarget.Id,
                    Token = token,
                    CreatedByUserId = CurrentUserId,
                    CreatedAt = DateTime.UtcNow,
                    ExpiresAt = DateTime.UtcNow.AddDays(7)
                });

            await Db.SaveChangesAsync();

            ShareLinks =
                await Db.FileShareLinks
                    .Where(x =>
                        x.FileId == ShareTarget.Id &&
                        !x.IsRevoked)
                    .OrderByDescending(x => x.CreatedAt)
                    .ToListAsync();

            Message = "Public link created.";
        }
        catch (Exception ex)
        {
            Message =
                $"Unable to create share link: {ex.Message}";
        }
    }

    private async Task RevokeShareLink(long id)
    {
        try
        {
            if (ShareTarget is null)
                return;

            if (!CanManageFile(ShareTarget))
            {
                Message = "Only the owner can revoke a public link.";
                return;
            }

            var link =
                await Db.FileShareLinks.FirstOrDefaultAsync(x =>
                    x.Id == id &&
                    x.FileId == ShareTarget.Id);

            if (link is null)
                return;

            link.IsRevoked = true;

            await Db.SaveChangesAsync();

            ShareLinks =
                await Db.FileShareLinks
                    .Where(x =>
                        x.FileId == ShareTarget.Id &&
                        !x.IsRevoked)
                    .OrderByDescending(x => x.CreatedAt)
                    .ToListAsync();

            Message = "Public link revoked.";
        }
        catch (Exception ex)
        {
            Message =
                $"Unable to revoke link: {ex.Message}";
        }
    }

