    private bool CanShare(StoredFile file)
    {
        return CanManageFile(file);
    }

    private bool CanManageFile(StoredFile file) =>
        file.OwnerId == CurrentUserId || (file.IsSharedHub && CanManageHub);

    private async Task RenameFile(StoredFile file)
    {
        try
        {
            var dbFile = await Db.StoredFiles
                .FirstOrDefaultAsync(x => x.Id == file.Id);

            if (dbFile is null || !await CanEdit(dbFile))
            {
                Message =
                    "You do not have edit permission for this file.";

                return;
            }

            var name =
                await JS.InvokeAsync<string?>(
                    "prompt",
                    "New file name",
                    dbFile.OriginalName);

            name = NormalizeFileName(name);

            if (name is null)
            {
                Message = "File names must be 1–255 characters and cannot contain path characters.";
                return;
            }

            if (name == dbFile.OriginalName)
                return;

            dbFile.OriginalName = name;

            await Db.SaveChangesAsync();

            if (ShowingHub)
            {
                await LoadHubFiles();
            }
            else if (ShowingShared)
            {
                await LoadSharedFiles();
            }
            else
            {
                await LoadCurrentFolder();
            }

            Message = "File renamed.";
        }
        catch (Exception ex)
        {
            Message =
                $"Rename failed: {ex.Message}";
        }
    }

    private async Task DeleteFile(StoredFile file)
    {
        try
        {
            var dbFile = await Db.StoredFiles
                .FirstOrDefaultAsync(x => x.Id == file.Id);

            if (dbFile is null || !await CanEdit(dbFile))
            {
                Message =
                    "You do not have edit permission for this file.";

                return;
            }

            var confirmed =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    $"Delete '{dbFile.OriginalName}'?");

            if (!confirmed)
                return;

            Db.StoredFiles.Remove(dbFile);

            await Db.SaveChangesAsync();

            // The database record is removed first so a transient storage
            // failure cannot leave a downloadable file behind.
            await Storage.DeleteAsync(dbFile.RelativePath);

            ClosePreview();
            CloseShare();
            CloseFileMenu();

            if (ShowingHub)
            {
                await LoadHubFiles();
            }
            else if (ShowingShared)
            {
                await LoadSharedFiles();
            }
            else
            {
                await LoadCurrentFolder();
            }

            Message = "File deleted.";
        }
        catch (Exception ex)
        {
            Message =
                $"Delete failed: {ex.Message}";
        }
    }

    private async Task<bool> CanEdit(StoredFile file)
    {
        if (CanManageFile(file))
            return true;

        return await Db.FilePermissions.AnyAsync(x =>
            x.FileId == file.Id &&
            x.UserId == CurrentUserId &&
            x.Permission == "edit");
    }

    private static string? NormalizeFileName(string? value)
    {
        var name = value?.Trim().Replace('\\', '/');

        if (!string.IsNullOrWhiteSpace(name))
            name = Path.GetFileName(name);

        if (string.IsNullOrWhiteSpace(name) ||
            name.Length > 255 ||
            name is "." or ".." ||
            name.IndexOfAny(['<', '>', ':', '"', '/', '\\', '|', '?', '*']) >= 0)
        {
            return null;
        }

        return name;
    }

    private bool IsImage(StoredFile file)
    {
        return file.ContentType?.StartsWith(
            "image/",
            StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool IsVideo(StoredFile file)
    {
        return file.ContentType?.StartsWith(
            "video/",
            StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool IsAudio(StoredFile file)
    {
        return file.ContentType?.StartsWith(
            "audio/",
            StringComparison.OrdinalIgnoreCase) == true;
    }

    private bool IsPdf(StoredFile file)
    {
        return string.Equals(
            file.ContentType,
            "application/pdf",
            StringComparison.OrdinalIgnoreCase);
    }

    private static string GetIcon(StoredFile file)
    {
        var ext =
            Path.GetExtension(file.OriginalName)
                .ToLowerInvariant();

        return ext switch
        {
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".xls" or ".xlsx" => "📗",
            ".ppt" or ".pptx" => "📙",
            ".zip" or ".rar" or ".7z" => "🗜️",
            ".mp4" or ".webm" or ".mov" => "🎬",
            ".mp3" or ".wav" or ".ogg" => "🎵",
            _ => "📄"
        };
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024d:0.0} KB";

        if (bytes < 1024L * 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.0} MB";

        return $"{bytes / 1024d / 1024d / 1024d:0.0} GB";
    }

