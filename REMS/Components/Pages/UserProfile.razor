@page "/user"
@page "/user/{Id:int}"

@using MudBlazor
@using REMS.Enititys

@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IConfiguration Configuration

@attribute [Authorize]

<div class="profile-page" dir="rtl">

    <!-- Ambient Background -->
    <div class="profile-orb orb-one"></div>
    <div class="profile-orb orb-two"></div>
    <div class="profile-orb orb-three"></div>

    <div class="profile-grid"></div>
    <div class="profile-scan"></div>


    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <section class="error-card">

            <div class="error-icon">
                ⚠️
            </div>

            <div class="error-content">

                <span class="error-kicker">
                    ACCESS ERROR
                </span>

                <h3>
                    تعذر الوصول إلى الحساب
                </h3>

                <p>
                    @ErrorMessage
                </p>

            </div>

        </section>
    }
    else
    {
        <main class="profile-content">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <section class="profile-header">

                <div class="header-glow"></div>
                <div class="header-scan"></div>

                <div class="header-left">

                    <div class="header-icon">
                        👤
                    </div>

                    <div>

                        <span class="header-kicker">
                            HEX STUDIO • HEMS
                        </span>

                        <h1>
                            الملف الشخصي
                        </h1>

                        <p>
                            عرض معلومات الحساب وإدارة كلمة المرور
                        </p>

                    </div>

                </div>

                <div class="header-status">
                    <span class="status-dot"></span>
                    ACTIVE
                </div>

                <div class="security-section">
                    <div class="security-header">
                        <div class="security-icon">✈️</div>
                        <div>
                            <strong>ربط تيليغرام</strong>
                            <span>اربط حسابك مرة واحدة لتصلك الإشعارات دون إدخال Chat ID.</span>
                        </div>
                    </div>
                    <div class="security-card">
                        <div class="security-card-icon">@(User.ChatId.HasValue ? "✅" : "🔗")</div>
                        <div class="security-card-content">
                            <strong>@(User.ChatId.HasValue ? "تيليغرام مرتبط" : "تيليغرام غير مرتبط")</strong>
                            <span>@(User.ChatId.HasValue ? $"تم الربط في {User.TelegramLinkedAt?.ToLocalTime():yyyy-MM-dd}" : "اضغط الرابط ثم أرسل Start للبوت لإكمال الربط.")</span>
                        </div>
                        @if (User.ChatId.HasValue)
                        {
                            <button class="password-btn" @onclick="CreateTelegramLinkAsync">إعادة الربط</button>
                        }
                        else if (!string.IsNullOrWhiteSpace(TelegramLink))
                        {
                            <a class="password-btn" href="@TelegramLink" target="_blank" rel="noopener">فتح بوت تيليغرام</a>
                        }
                        else
                        {
                            <button class="password-btn" @onclick="CreateTelegramLinkAsync">إنشاء رابط الربط</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(TelegramMessage))
                    {
                        <p class="telegram-message">@TelegramMessage</p>
                    }
                </div>

            </section>


            <!-- =====================================================
                 PROFILE CARD
                 ===================================================== -->

            <section class="profile-card">

                <div class="card-top-line"></div>

                <!-- Profile identity -->
                <div class="profile-identity">

                    <div class="avatar-wrapper">

                        <div class="avatar-ring"></div>

                        <div class="profile-avatar">
                            👤
                        </div>

                        <span class="avatar-status"></span>

                    </div>


                    <div class="identity-info">

                        <span class="identity-label">
                            USER PROFILE
                        </span>

                        <h2>
                            @User.FullName
                        </h2>

                        <p>
                            حساب مستخدم في نظام HEMS
                        </p>

                    </div>

                </div>


                <!-- Divider -->
                <div class="profile-divider"></div>


                <!-- Account information -->
                <div class="account-grid">

                    <div class="info-card">

                        <div class="info-icon">
                            👤
                        </div>

                        <div class="info-content">

                            <span>
                                الاسم الكامل
                            </span>

                            <strong>
                                @User.FullName
                            </strong>

                        </div>

                    </div>


                    <div class="info-card">

                        <div class="info-icon email-icon">
                            ✉️
                        </div>

                        <div class="info-content">

                            <span>
                                البريد الإلكتروني
                            </span>

                            <strong>
                                @User.Email
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Security section -->
                <div class="security-section">

                    <div class="security-header">

                        <div class="security-icon">
                            🔐
                        </div>

                        <div>

                            <strong>
                                أمان الحساب
                            </strong>

                            <span>
                                إدارة بيانات الدخول وكلمة المرور
                            </span>

                        </div>

                    </div>


                    <div class="security-card">

                        <div class="security-card-icon">
                            🔑
                        </div>

                        <div class="security-card-content">

                            <strong>
                                كلمة المرور
                            </strong>

                            <span>
                                يمكنك تغيير كلمة المرور الخاصة بحسابك.
                            </span>

                        </div>

                        <MudButton OnClick="NavigateToChangePassword"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Class="password-btn">

                            <span class="password-btn-icon">
                                🔐
                            </span>

                            <span>
                                تغيير كلمة السر
                            </span>

                            <span class="password-arrow">
                                ←
                            </span>

                        </MudButton>

                    </div>

                </div>

            </section>

        </main>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public UserService UserRepo { get; set; } = default!;

    private string ErrorMessage { get; set; } = string.Empty;

    private User User { get; set; } = new();
    private string? TelegramLink;
    private string? TelegramMessage;

    private void NavigateToChangePassword()
    {
        Navigation.NavigateTo("/changepassword");
    }

    protected async override Task OnParametersSetAsync()
    {
        if (Id == 0)
        {
            Id = LoggedUserId;
        }

        var result = await UserRepo.GetById(Id);

        if (result.IsFailure)
        {
            ErrorMessage = $"There is no user with Id {Id}.";
        }
        else
        {
            var cur = result.Value;

            if (LoggedUserId != cur.Id)
            {
                ErrorMessage = "You do not have permission to view other users' profiles.";
            }
            else
            {
                User = cur;
                TelegramLink = BuildTelegramLink(User.TelegramLinkToken);
            }
        }
    }

    private async Task CreateTelegramLinkAsync()
    {
        var token = await UserRepo.CreateTelegramLinkTokenAsync(User.Id);
        User.TelegramLinkToken = token;
        User.ChatId = null;
        TelegramLink = BuildTelegramLink(token);
        TelegramMessage = string.IsNullOrWhiteSpace(TelegramLink)
            ? "يجب ضبط Telegram:BotUsername في إعدادات الخادم أولاً."
            : "تم إنشاء الرابط. افتحه في تيليغرام ثم أرسل Start.";
    }

    private string? BuildTelegramLink(string? token)
    {
        var username = Configuration["Telegram:BotUsername"]?.Trim().TrimStart('@');
        return string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(token)
            ? null
            : $"https://t.me/{username}?start=link_{token}";
    }

    private int LoggedUserId =>
        Convert.ToInt32(
            HttpContextAccessor.HttpContext.User.Claims
                .FirstOrDefault(x => x.Type == "Id")
                .Value
        );
}



