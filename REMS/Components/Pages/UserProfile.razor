@page "/user"
@page "/user/{Id:int}"

@using MudBlazor
@using REMS.Enititys

@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

@attribute [Authorize]

<div class="profile-page" dir="rtl">

    <!-- Ambient Background -->
    <div class="profile-orb orb-one"></div>
    <div class="profile-orb orb-two"></div>
    <div class="profile-orb orb-three"></div>

    <div class="profile-grid"></div>
    <div class="profile-scan"></div>


    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <section class="error-card">

            <div class="error-icon">
                ⚠️
            </div>

            <div class="error-content">

                <span class="error-kicker">
                    ACCESS ERROR
                </span>

                <h3>
                    تعذر الوصول إلى الحساب
                </h3>

                <p>
                    @ErrorMessage
                </p>

            </div>

        </section>
    }
    else
    {
        <main class="profile-content">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <section class="profile-header">

                <div class="header-glow"></div>
                <div class="header-scan"></div>

                <div class="header-left">

                    <div class="header-icon">
                        👤
                    </div>

                    <div>

                        <span class="header-kicker">
                            HEX STUDIO • HEMS
                        </span>

                        <h1>
                            الملف الشخصي
                        </h1>

                        <p>
                            عرض معلومات الحساب وإدارة كلمة المرور
                        </p>

                    </div>

                </div>

                <div class="header-status">
                    <span class="status-dot"></span>
                    ACTIVE
                </div>

            </section>


            <!-- =====================================================
                 PROFILE CARD
                 ===================================================== -->

            <section class="profile-card">

                <div class="card-top-line"></div>

                <!-- Profile identity -->
                <div class="profile-identity">

                    <div class="avatar-wrapper">

                        <div class="avatar-ring"></div>

                        <div class="profile-avatar">
                            👤
                        </div>

                        <span class="avatar-status"></span>

                    </div>


                    <div class="identity-info">

                        <span class="identity-label">
                            USER PROFILE
                        </span>

                        <h2>
                            @User.FullName
                        </h2>

                        <p>
                            حساب مستخدم في نظام HEMS
                        </p>

                    </div>

                </div>


                <!-- Divider -->
                <div class="profile-divider"></div>


                <!-- Account information -->
                <div class="account-grid">

                    <div class="info-card">

                        <div class="info-icon">
                            👤
                        </div>

                        <div class="info-content">

                            <span>
                                الاسم الكامل
                            </span>

                            <strong>
                                @User.FullName
                            </strong>

                        </div>

                    </div>


                    <div class="info-card">

                        <div class="info-icon email-icon">
                            ✉️
                        </div>

                        <div class="info-content">

                            <span>
                                البريد الإلكتروني
                            </span>

                            <strong>
                                @User.Email
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Security section -->
                <div class="security-section">

                    <div class="security-header">

                        <div class="security-icon">
                            🔐
                        </div>

                        <div>

                            <strong>
                                أمان الحساب
                            </strong>

                            <span>
                                إدارة بيانات الدخول وكلمة المرور
                            </span>

                        </div>

                    </div>


                    <div class="security-card">

                        <div class="security-card-icon">
                            🔑
                        </div>

                        <div class="security-card-content">

                            <strong>
                                كلمة المرور
                            </strong>

                            <span>
                                يمكنك تغيير كلمة المرور الخاصة بحسابك.
                            </span>

                        </div>

                        <MudButton OnClick="NavigateToChangePassword"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Class="password-btn">

                            <span class="password-btn-icon">
                                🔐
                            </span>

                            <span>
                                تغيير كلمة السر
                            </span>

                            <span class="password-arrow">
                                ←
                            </span>

                        </MudButton>

                    </div>

                </div>

            </section>

        </main>
    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }

    [Inject]
    public UserService UserRepo { get; set; }

    private string ErrorMessage { get; set; } = string.Empty;

    private User User { get; set; }

    private void NavigateToChangePassword()
    {
        Navigation.NavigateTo("/changepassword");
    }

    protected async override Task OnParametersSetAsync()
    {
        if (Id == 0)
        {
            Id = LoggedUserId;
        }

        var result = await UserRepo.GetById(Id);

        if (result.IsFailure)
        {
            ErrorMessage = $"There is no user with Id {Id}.";
        }
        else
        {
            var cur = result.Value;

            if (LoggedUserId != cur.Id)
            {
                ErrorMessage = "You do not have permission to view other users' profiles.";
            }
            else
            {
                User = cur;
            }
        }
    }

    private int LoggedUserId =>
        Convert.ToInt32(
            HttpContextAccessor.HttpContext.User.Claims
                .FirstOrDefault(x => x.Type == "Id")
                .Value
        );
}


<style>

    /* =========================================================
           HEMS PROFILE PAGE
           ========================================================= */

    .profile-page {
        position: relative;
        min-height: 100vh;
        padding: clamp(14px,2.5vw,30px);
        overflow: hidden;
        isolation: isolate;
        background: radial-gradient( circle at 82% 8%, rgba(67,56,202,.23), transparent 26% ), radial-gradient( circle at 15% 90%, rgba(29,78,216,.16), transparent 25% ), linear-gradient( 135deg, #030305 0%, #070811 42%, #11102b 72%, #1e1b4b 100% );
        color: #f8fafc;
    }


        .profile-page::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background: radial-gradient( circle at center, transparent 0%, rgba(2,2,8,.18) 48%, rgba(2,2,8,.60) 100% );
        }


    /* =========================================================
           GRID
           ========================================================= */

    .profile-grid {
        position: absolute;
        inset: 0;
        z-index: -3;
        pointer-events: none;
        background: linear-gradient( rgba(255,255,255,.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,.025) 1px, transparent 1px );
        background-size: 42px 42px;
        mask-image: linear-gradient( to bottom, black, transparent 92% );
        animation: gridMove 22s linear infinite;
    }


    /* =========================================================
           AMBIENT
           ========================================================= */

    .profile-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(8px);
        mix-blend-mode: screen;
        pointer-events: none;
        z-index: -1;
    }


    .orb-one {
        width: 340px;
        height: 340px;
        top: -110px;
        right: -80px;
        background: radial-gradient( circle, rgba(99,102,241,.34), transparent 68% );
        animation: orbOne 11s ease-in-out infinite;
    }


    .orb-two {
        width: 400px;
        height: 400px;
        bottom: -160px;
        left: -140px;
        background: radial-gradient( circle, rgba(37,99,235,.23), transparent 68% );
        animation: orbTwo 14s ease-in-out infinite;
    }


    .orb-three {
        width: 220px;
        height: 220px;
        top: 45%;
        left: 48%;
        background: radial-gradient( circle, rgba(129,140,248,.12), transparent 66% );
        animation: orbThree 6s ease-in-out infinite;
    }


    .profile-scan {
        position: absolute;
        top: 0;
        left: -35%;
        width: 35%;
        height: 100%;
        z-index: -1;
        transform: skewX(-22deg);
        pointer-events: none;
        background: linear-gradient( 90deg, transparent, rgba(255,255,255,.055), transparent );
        animation: scan 8s ease-in-out infinite;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .profile-content {
        position: relative;
        width: min( 1000px, 100% );
        margin: 0 auto;
        z-index: 2;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .profile-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 140px;
        margin-bottom: 20px;
        padding: 28px clamp(20px,4vw,40px);
        border: 1px solid rgba(129,140,248,.20);
        border-radius: 26px;
        background: radial-gradient( circle at 85% 10%, rgba(129,140,248,.28), transparent 28% ), linear-gradient( 135deg, #020204 0%, #0a0a14 48%, #171449 100% );
        box-shadow: 0 24px 70px rgba(0,0,0,.48), 0 0 0 1px rgba(255,255,255,.025) inset, 0 0 50px rgba(67,56,202,.10);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        animation: cardReveal .75s cubic-bezier(.2,.75,.2,1) both;
    }


    .header-left {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 17px;
    }


    .header-icon {
        width: 62px;
        height: 62px;
        flex: 0 0 62px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        font-size: 1.6rem;
        background: linear-gradient( 145deg, rgba(99,102,241,.95), rgba(30,64,175,.76) );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 28px rgba(99,102,241,.22) inset;
        animation: iconPulse 3.5s ease-in-out infinite;
    }


    .header-kicker {
        display: block;
        margin-bottom: 5px;
        color: #a5b4fc;
        font-family: "Space Grotesk", sans-serif;
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .23em;
        text-transform: uppercase;
    }


    .profile-header h1 {
        margin: 0;
        color: #f8fafc;
        font-family: "Unbounded", "Space Grotesk", sans-serif;
        font-size: clamp( 1.3rem, 2.5vw, 2rem );
        font-weight: 500;
    }


    .profile-header p {
        margin: 6px 0 0;
        color: rgba(226,232,240,.68);
        font-size: .84rem;
    }


    .header-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        color: #c7d2fe;
        background: rgba(49,46,129,.18);
        border: 1px solid rgba(129,140,248,.20);
        font-family: "JetBrains Mono", monospace;
        font-size: .66rem;
        letter-spacing: .08em;
    }


    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        box-shadow: 0 0 12px rgba(56,189,248,.85);
        animation: livePulse 1.8s ease-in-out infinite;
    }


    /* =========================================================
           PROFILE CARD
           ========================================================= */

    .profile-card {
        position: relative;
        overflow: hidden;
        padding: clamp(22px,4vw,40px);
        border: 1px solid rgba(129,140,248,.18);
        border-radius: 24px;
        background: rgba(8,9,18,.84);
        box-shadow: 0 24px 70px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.02) inset;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        animation: cardReveal .85s .1s cubic-bezier(.2,.75,.2,1) both;
    }


    .card-top-line {
        position: absolute;
        top: 0;
        left: 4%;
        width: 92%;
        height: 1px;
        background: linear-gradient( 90deg, transparent, rgba(129,140,248,.48), rgba(56,189,248,.40), transparent );
    }


    /* =========================================================
           IDENTITY
           ========================================================= */

    .profile-identity {
        display: flex;
        align-items: center;
        gap: 20px;
    }


    .avatar-wrapper {
        position: relative;
        width: 105px;
        height: 105px;
        flex: 0 0 105px;
        display: grid;
        place-items: center;
    }


    .avatar-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 1px solid rgba(129,140,248,.20);
        box-shadow: 0 0 35px rgba(99,102,241,.18), inset 0 0 25px rgba(99,102,241,.10);
        animation: avatarRing 4s ease-in-out infinite;
    }


    .profile-avatar {
        width: 76px;
        height: 76px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 2rem;
        background: linear-gradient( 145deg, #6366f1, #1d4ed8 );
        border: 1px solid rgba(255,255,255,.16);
        box-shadow: 0 15px 35px rgba(79,70,229,.34), 0 0 35px rgba(99,102,241,.18) inset;
        animation: avatarFloat 4s ease-in-out infinite;
    }


    .avatar-status {
        position: absolute;
        bottom: 10px;
        right: 11px;
        width: 13px;
        height: 13px;
        border: 3px solid #090a12;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 12px rgba(74,222,128,.75);
    }


    .identity-label {
        display: block;
        margin-bottom: 6px;
        color: #818cf8;
        font-family: "JetBrains Mono", monospace;
        font-size: .60rem;
        letter-spacing: .18em;
    }


    .identity-info h2 {
        margin: 0;
        color: #f8fafc;
        font-family: "Space Grotesk", "Segoe UI", sans-serif;
        font-size: clamp( 1.3rem, 3vw, 1.9rem );
        font-weight: 800;
    }


    .identity-info p {
        margin: 5px 0 0;
        color: rgba(203,213,225,.48);
        font-size: .72rem;
    }


    /* =========================================================
           DIVIDER
           ========================================================= */

    .profile-divider {
        height: 1px;
        margin: 28px 0;
        background: linear-gradient( 90deg, transparent, rgba(129,140,248,.18), transparent );
    }


    /* =========================================================
           INFO
           ========================================================= */

    .account-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 15px;
    }


    .info-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 90px;
        padding: 15px;
        border: 1px solid rgba(129,140,248,.14);
        border-radius: 16px;
        background: linear-gradient( 135deg, rgba(30,41,59,.42), rgba(49,46,129,.11) );
        transition: .28s ease;
    }


        .info-card:hover {
            transform: translateY(-3px);
            border-color: rgba(129,140,248,.28);
            box-shadow: 0 15px 30px rgba(0,0,0,.18), 0 0 20px rgba(67,56,202,.08);
        }


    .info-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(99,102,241,.11);
        border: 1px solid rgba(129,140,248,.13);
    }


    .email-icon {
        background: rgba(56,189,248,.08);
        border-color: rgba(56,189,248,.14);
    }


    .info-content span {
        display: block;
        color: rgba(165,180,252,.46);
        font-size: .64rem;
    }


    .info-content strong {
        display: block;
        margin-top: 5px;
        color: #e2e8f0;
        font-size: .82rem;
        word-break: break-word;
    }


    /* =========================================================
           SECURITY
           ========================================================= */

    .security-section {
        margin-top: 28px;
    }


    .security-header {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 16px;
    }


    .security-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: linear-gradient( 145deg, rgba(99,102,241,.72), rgba(30,64,175,.55) );
        box-shadow: 0 8px 20px rgba(79,70,229,.20);
    }


    .security-header strong {
        display: block;
        color: #f8fafc;
        font-size: .85rem;
    }


    .security-header span {
        display: block;
        margin-top: 3px;
        color: rgba(165,180,252,.46);
        font-size: .63rem;
    }


    .security-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        border: 1px solid rgba(129,140,248,.14);
        border-radius: 17px;
        background: linear-gradient( 135deg, rgba(30,41,59,.42), rgba(49,46,129,.12) );
    }


    .security-card-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(99,102,241,.11);
        border: 1px solid rgba(129,140,248,.13);
    }


    .security-card-content {
        flex: 1;
    }


        .security-card-content strong {
            display: block;
            color: #e2e8f0;
            font-size: .76rem;
        }


        .security-card-content span {
            display: block;
            margin-top: 4px;
            color: rgba(165,180,252,.42);
            font-size: .61rem;
            line-height: 1.5;
        }


    /* =========================================================
           PASSWORD BUTTON
           ========================================================= */

    .password-btn {
        position: relative;
        min-height: 44px;
        border-radius: 12px !important;
        padding: 9px 14px !important;
        color: #fff !important;
        background: linear-gradient( 120deg, #111827, #312e81, #4338ca ) !important;
        border: 1px solid rgba(165,180,252,.20) !important;
        box-shadow: 0 9px 22px rgba(49,46,129,.26) !important;
        font-size: .68rem !important;
        font-weight: 800 !important;
        transition: .25s ease !important;
    }


        .password-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.08);
            box-shadow: 0 14px 30px rgba(49,46,129,.38) !important;
        }


    .password-btn-icon {
        margin-left: 5px;
    }


    .password-arrow {
        margin-right: 6px;
        transition: transform .25s ease;
    }


    .password-btn:hover .password-arrow {
        transform: translateX(-3px);
    }


    /* =========================================================
           ERROR
           ========================================================= */

    .error-card {
        width: min( 850px, 100% );
        margin: 60px auto;
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 28px;
        border: 1px solid rgba(248,113,113,.24);
        border-radius: 22px;
        background: linear-gradient( 135deg, rgba(127,29,29,.16), rgba(49,46,129,.08) );
        box-shadow: 0 24px 70px rgba(0,0,0,.42), 0 0 30px rgba(248,113,113,.06);
        backdrop-filter: blur(20px);
        animation: cardReveal .7s ease both;
    }


    .error-icon {
        width: 55px;
        height: 55px;
        flex: 0 0 55px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: rgba(248,113,113,.10);
        border: 1px solid rgba(248,113,113,.16);
        font-size: 1.35rem;
    }


    .error-kicker {
        display: block;
        color: #fca5a5;
        font-family: "JetBrains Mono", monospace;
        font-size: .60rem;
        letter-spacing: .16em;
    }


    .error-content h3 {
        margin: 5px 0 0;
        color: #fecaca;
        font-size: 1rem;
    }


    .error-content p {
        margin: 5px 0 0;
        color: rgba(254,202,202,.58);
        font-size: .72rem;
        line-height: 1.7;
    }


    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes gridMove {

        from {
            transform: translate3d(0,0,0);
        }

        to {
            transform: translate3d(42px,42px,0);
        }
    }


    @@keyframes orbOne {

        0%, 100% {
            transform: translate3d(0,0,0) scale(1);
            opacity: .55;
        }

        50% {
            transform: translate3d(-40px,28px,0) scale(1.10);
            opacity: .90;
        }
    }


    @@keyframes orbTwo {

        0%, 100% {
            transform: translate3d(0,0,0) scale(1);
        }

        50% {
            transform: translate3d(45px,-32px,0) scale(1.08);
        }
    }


    @@keyframes orbThree {

        0%, 100% {
            transform: scale(.92);
            opacity: .30;
        }

        50% {
            transform: scale(1.18);
            opacity: .70;
        }
    }


    @@keyframes scan {

        0%, 18% {
            left: -35%;
            opacity: 0;
        }

        35% {
            opacity: 1;
        }

        58%, 100% {
            left: 115%;
            opacity: 0;
        }
    }


    @@keyframes cardReveal {

        from {
            opacity: 0;
            transform: translateY(24px) scale(.985);
            filter: blur(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: blur(0);
        }
    }


    @@keyframes iconPulse {

        0%, 100% {
            box-shadow: 0 10px 30px rgba(79,70,229,.34), 0 0 28px rgba(99,102,241,.22) inset;
        }

        50% {
            box-shadow: 0 14px 38px rgba(79,70,229,.48), 0 0 42px rgba(129,140,248,.30) inset;
        }
    }


    @@keyframes livePulse {

        0%, 100% {
            opacity: .55;
            transform: scale(.85);
        }

        50% {
            opacity: 1;
            transform: scale(1.15);
        }
    }


    @@keyframes avatarRing {

        0%, 100% {
            transform: scale(1);
            opacity: .55;
        }

        50% {
            transform: scale(1.08);
            opacity: 1;
        }
    }


    @@keyframes avatarFloat {

        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 700px) {

        .profile-page {
            padding: 10px;
        }

        .profile-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 24px 18px;
        }

        .header-status {
            position: absolute;
            top: 18px;
            left: 18px;
        }

        .header-icon {
            width: 52px;
            height: 52px;
            flex-basis: 52px;
        }

        .profile-card {
            padding: 20px 16px;
        }

        .profile-identity {
            flex-direction: column;
            text-align: center;
        }

        .account-grid {
            grid-template-columns: 1fr;
        }

        .security-card {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .password-btn {
            width: 100%;
        }

        .error-card {
            margin: 30px auto;
            flex-direction: column;
            text-align: center;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            scroll-behavior: auto !important;
        }
    }

</style>